{
  "id": "1.0.11",
  "target_version": "1.0.11",
  "description": "Экспорт выпадающим списком: календарь + кто не заполнил отчёт. Заменяет 1.0.10. v1.0.11b: фикс краша сервера из-за дубля эндпоинта api_calendar_export_excel (остатки неприменённого/некорректно откаченного 1.0.10 — автозачистка при старте); уведомления о СОЗДАНИИ задач по вертикали (рук. команды + начальник отдела), колокол различает 🆕/✅.",
  "requires": [],
  "operations": [
    {
      "type": "insert",
      "path": "templates/tracker.html",
      "marker": "<span id=\"calExpandLabel\">Разворот дня: вкл</span>\n            </button>",
      "position": "after",
      "content": "\n            <div class=\"export-menu-wrap\" style=\"position:relative;display:inline-block;margin-left:8px;\">\n                <button class=\"dict-add-btn\" id=\"exportMenuBtn\" style=\"background:linear-gradient(135deg,#27ae60,#229954);\">📥 Экспорт ▾</button>\n                <div id=\"exportMenuDrop\" style=\"display:none;position:absolute;top:calc(100% + 4px);left:0;z-index:9999;background:#141414;border:1px solid rgba(245,215,110,0.22);border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,0.55);min-width:260px;padding:6px;\">\n                    <div class=\"export-menu-item\" data-form=\"calendar\" style=\"padding:9px 12px;border-radius:8px;cursor:pointer;color:#e8e8e8;font-size:0.9rem;\">📅 Календарь (полный)</div>\n                    <div class=\"export-menu-item\" data-form=\"debtors\" style=\"padding:9px 12px;border-radius:8px;cursor:pointer;color:#e8e8e8;font-size:0.9rem;\">⚠️ Кто не заполнил отчёт (сегодня)</div>\n                </div>\n            </div>"
    },
    {
      "type": "insert",
      "path": "static/tracker.js",
      "marker": "function renderCalendar() {",
      "position": "before",
      "content": "function toggleExportMenu(force) {\n    var drop = document.getElementById('exportMenuDrop');\n    if (!drop) return;\n    var show = (force === true) || drop.style.display === 'none';\n    drop.style.display = show ? 'block' : 'none';\n}\nfunction runExportForm(form) {\n    toggleExportMenu(false);\n    if (form === 'calendar') exportCalendarToExcel();\n    else if (form === 'debtors') exportDebtorsToExcel();\n}\nfunction exportCalendarToExcel() {\n    var month = state.calendar ? state.calendar.month : new Date().getMonth() + 1;\n    var year = state.calendar ? state.calendar.year : new Date().getFullYear();\n    var params = new URLSearchParams();\n    params.set('month', month);\n    params.set('year', year);\n    var deptFilter = document.getElementById('calDeptFilter');\n    if (deptFilter && deptFilter.value) params.set('department', deptFilter.value);\n    var teamFilter = document.getElementById('calTeamFilter');\n    if (teamFilter && teamFilter.value) params.set('team', teamFilter.value);\n    var empFilter = document.getElementById('calEmployeeFilter');\n    if (empFilter && empFilter.value) params.set('employee', empFilter.value);\n    notify('📊 Генерируем Excel...', 'info');\n    window.open('/api/tracker/calendar/export?' + params.toString(), '_blank');\n}\nfunction exportDebtorsToExcel() {\n    var d = new Date();\n    var iso = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');\n    var params = new URLSearchParams();\n    params.set('date', iso);\n    var deptFilter = document.getElementById('calDeptFilter');\n    if (deptFilter && deptFilter.value) params.set('department', deptFilter.value);\n    var teamFilter = document.getElementById('calTeamFilter');\n    if (teamFilter && teamFilter.value) params.set('team', teamFilter.value);\n    notify('⚠️ Считаем, кто не заполнил отчёт...', 'info');\n    window.open('/api/tracker/export/debtors?' + params.toString(), '_blank');\n}\n(function(){\n    function bindExportMenu() {\n        document.addEventListener('click', function(e) {\n            var t = e.target;\n            if (!t || !t.closest) return;\n            if (t.closest('#exportMenuBtn')) { toggleExportMenu(); return; }\n            var item = t.closest('.export-menu-item');\n            if (item) { runExportForm(item.getAttribute('data-form')); return; }\n            var drop = document.getElementById('exportMenuDrop');\n            if (drop && drop.style.display !== 'none' && !t.closest('.export-menu-wrap')) {\n                drop.style.display = 'none';\n            }\n        });\n    }\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindExportMenu);\n    else bindExportMenu();\n})();\n\n"
    },
    {
      "type": "insert",
      "path": "app.py",
      "marker": "    @app.route('/api/tracker/calendar', methods=['GET'])",
      "position": "before",
      "content": "    # PATCH v1.0.11b: защита от дубликата эндпоинта. Если 1.0.10 был применён\n    # ранее и его вставка осталась в app.py (неполный откат), Flask падает на\n    # старте: \"View function mapping is overwriting an existing endpoint\n    # function: api_calendar_export_excel\". Перед регистрацией новых роутов\n    # вычищаем старые дублирующие определения прямо из исходника app.py.\n    try:\n        import os as _os_xe, re as _re_xe\n        _app_py_xe = _os_xe.path.join(_os_xe.path.dirname(_os_xe.path.abspath(__file__)), 'app.py')\n        if _os_xe.path.exists(_app_py_xe):\n            with open(_app_py_xe, 'r', encoding='utf-8') as _f_xe:\n                _src_xe = _f_xe.read()\n            _defs_xe = list(_re_xe.finditer(\n                r\"def\\s+(?:api_calendar_export_excel|api_export_debtors)\\s*\\(\", _src_xe))\n            # дубль = больше одного def или def раньше эталонной позиции (~строка 2048)\n            _need_clean_xe = len(_defs_xe) > 1 or (\n                _defs_xe and _src_xe.count('\\n', 0, _defs_xe[0].start()) < 2047)\n            if _need_clean_xe:\n                print('[INIT] v1.0.11b: найдены остатки экспорта 1.0.10 — удаляю дубликаты из app.py')\n                _lines_xe = _src_xe.split('\\n')\n\n                def _find_def_lines(lines, name):\n                    out = []\n                    for i, ln in enumerate(lines):\n                        if _re_xe.match(r\"\\s*def\\s+\" + name + r\"\\s*\\(\", ln):\n                            out.append(i)\n                    return out\n\n                def _block_bounds(lines, di):\n                    # конец блока: следующая строка нулевой индентации\n                    end = len(lines) - 1\n                    for j in range(di + 1, len(lines)):\n                        s = lines[j]\n                        if s.strip() and not s.startswith((' ', '\\t')):\n                            end = j - 1\n                            break\n                    # начало: поднимаемся над def через декораторы @...\n                    start = di - 1\n                    while start >= 0:\n                        prev = lines[start]\n                        if prev.strip().startswith('@'):\n                            start -= 1\n                            continue\n                        if not prev.strip():\n                            start -= 1\n                            continue\n                        break\n                    return start + 1, end\n\n                removed_xe = 0\n                for _nm in ('api_calendar_export_excel', 'api_export_debtors'):\n                    while True:\n                        _dl = _find_def_lines(_lines_xe, _nm)\n                        if len(_dl) <= 1:\n                            break\n                        # оставляем самый нижний def (наш, из этой вставки),\n                        # остальные блоки удаляем снизу вверх\n                        _kill = _dl[:-1]\n                        for _di in sorted(_kill, reverse=True):\n                            _s, _e = _block_bounds(_lines_xe, _di)\n                            del _lines_xe[_s:_e + 1]\n                            removed_xe += 1\n                if removed_xe:\n                    with open(_app_py_xe, 'w', encoding='utf-8') as _f_xe:\n                        _f_xe.write('\\n'.join(_lines_xe))\n                    print(f'[INIT] v1.0.11b: удалено дублирующих блоков: {removed_xe}')\n    except Exception as _e_xe:\n        print(f'[INIT] v1.0.11b export-dedup failed: {_e_xe}')\n\n    @app.route('/api/tracker/export/debtors')\n    @login_required\n    def api_export_debtors():\n        from datetime import date\n        from flask import send_file\n        try:\n            import openpyxl\n            from openpyxl.styles import Font, PatternFill, Alignment, Border, Side\n        except ImportError:\n            return jsonify({'success': False, 'error': 'openpyxl не установлен: pip install openpyxl'}), 500\n        d = (request.args.get('date') or '').strip() or date.today().strftime('%Y-%m-%d')\n        dept_id = request.args.get('department', '')\n        team_id = request.args.get('team', '')\n        data = db.load_all()\n        employees = list(data.get('employees', []))\n        teams = data.get('teams', [])\n        all_logs = data.get('log', [])\n        emp_team = {}\n        for t in teams:\n            for mid in (t.get('member_ids') or []):\n                emp_team.setdefault(mid, t.get('name'))\n            if t.get('manager_id'):\n                emp_team.setdefault(t['manager_id'], t.get('name'))\n        if dept_id:\n            employees = [e for e in employees if e.get('department_id') == dept_id]\n        if team_id:\n            member_ids = set()\n            for t in teams:\n                if t['id'] == team_id:\n                    member_ids.update(t.get('member_ids') or [])\n                    if t.get('manager_id'):\n                        member_ids.add(t['manager_id'])\n            employees = [e for e in employees if e['id'] in member_ids]\n        reported = set()\n        for l in all_logs:\n            if l.get('date') == d:\n                reported.add(l.get('employee_id'))\n        debtors = [e for e in employees if not e.get('fired') and e['id'] not in reported]\n        wb = openpyxl.Workbook()\n        ws = wb.active\n        ws.title = 'Не заполнили отчёт'\n        header_fill = PatternFill('solid', fgColor='C0392B')\n        header_font = Font(bold=True, color='FFFFFF')\n        thin = Side(style='thin', color='CCCCCC')\n        border = Border(left=thin, right=thin, top=thin, bottom=thin)\n        ws.merge_cells('A1:D1')\n        ws['A1'] = f'Не заполнили отчёт за {d}'\n        ws['A1'].font = Font(bold=True, size=14)\n        ws['A1'].alignment = Alignment(horizontal='center')\n        for ci, h in enumerate(['№', 'ФИО', 'Отдел', 'Команда'], start=1):\n            c = ws.cell(row=3, column=ci, value=h)\n            c.font = header_font\n            c.fill = header_fill\n            c.border = border\n            c.alignment = Alignment(horizontal='center')\n        row = 4\n        for i, e in enumerate(debtors, start=1):\n            ws.cell(row=row, column=1, value=i).border = border\n            ws.cell(row=row, column=2, value=e.get('name', '')).border = border\n            ws.cell(row=row, column=3, value=e.get('department', '')).border = border\n            ws.cell(row=row, column=4, value=emp_team.get(e['id'], '')).border = border\n            row += 1\n        total_active = len([e for e in employees if not e.get('fired')])\n        ws.cell(row=row + 1, column=2, value=f'Итого: {len(debtors)} из {total_active} не заполнили').font = Font(bold=True)\n        ws.column_dimensions['A'].width = 6\n        ws.column_dimensions['B'].width = 30\n        ws.column_dimensions['C'].width = 20\n        ws.column_dimensions['D'].width = 20\n        from io import BytesIO\n        output = BytesIO()\n        wb.save(output)\n        output.seek(0)\n        return send_file(output, mimetype='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', as_attachment=True, download_name=f'debtors_{d}.xlsx')\n\n    @app.route('/api/tracker/calendar/export')\n    @login_required\n    def api_calendar_export_excel():\n        from datetime import date\n        from calendar import monthrange\n        from flask import send_file\n        try:\n            import openpyxl\n            from openpyxl.styles import Font, PatternFill, Alignment, Border, Side\n            from openpyxl.utils import get_column_letter\n        except ImportError:\n            return jsonify({'success': False, 'error': 'openpyxl не установлен: pip install openpyxl'}), 500\n        try:\n            year = int(request.args.get('year', date.today().year))\n            month = int(request.args.get('month', date.today().month))\n        except (ValueError, TypeError):\n            year, month = date.today().year, date.today().month\n        _, days_in_month = monthrange(year, month)\n        start_date = f'{year}-{month:02d}-01'\n        end_date = f'{year}-{month:02d}-{days_in_month:02d}'\n        dept_id = request.args.get('department', '')\n        team_id = request.args.get('team', '')\n        emp_id = request.args.get('employee', '')\n        data = db.load_all(since=start_date)\n        employees = list(data.get('employees', []))\n        tasks_by_id = {t['id']: t for t in data.get('tasks', [])}\n        teams = data.get('teams', [])\n        holidays = data.get('holidays', {})\n        all_logs = data.get('log', [])\n        if dept_id:\n            employees = [e for e in employees if e.get('department_id') == dept_id]\n        if team_id:\n            member_ids = set()\n            for t in teams:\n                if t['id'] == team_id:\n                    member_ids.update(t.get('member_ids') or [])\n                    if t.get('manager_id'):\n                        member_ids.add(t['manager_id'])\n            employees = [e for e in employees if e['id'] in member_ids]\n        if emp_id:\n            employees = [e for e in employees if e['id'] == emp_id]\n        logs_by_emp = {}\n        for l in all_logs:\n            if l['date'] > end_date:\n                continue\n            logs_by_emp.setdefault(l['employee_id'], {}).setdefault(l['date'], []).append(l)\n        ABSENCE_ICON = {'vacation': '🏖', 'sick_leave': '🤒', 'business_trip': '✈️', 'remote': '🏠'}\n        STATUS_FILL_HEX = {'done': 'C8E6C9', 'in_progress': 'DCEDC8', 'planned': 'E0E0E0', 'blocked': 'FFCDD2'}\n        wb = openpyxl.Workbook()\n        ws = wb.active\n        ws.title = f'Календарь {month:02d}.{year}'\n        total_cols = days_in_month + 2\n        ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=total_cols)\n        ws['A1'] = f'Календарь задач: {month:02d}.{year}'\n        ws['A1'].font = Font(bold=True, size=14)\n        ws['A1'].alignment = Alignment(horizontal='center')\n        header_fill = PatternFill('solid', fgColor='2C3E50')\n        header_font = Font(bold=True, color='FFFFFF')\n        header_align = Alignment(horizontal='center', vertical='center', wrap_text=True)\n        thin = Side(style='thin', color='CCCCCC')\n        thin_border = Border(left=thin, right=thin, top=thin, bottom=thin)\n        for c, val in ((1, 'Сотрудник'), (2, 'Отдел')):\n            cell = ws.cell(row=3, column=c, value=val)\n            cell.font = header_font\n            cell.fill = header_fill\n            cell.alignment = header_align\n            cell.border = thin_border\n        WD = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс']\n        today = date.today()\n        for day in range(1, days_in_month + 1):\n            col = day + 2\n            dd = date(year, month, day)\n            cell = ws.cell(row=3, column=col, value=f'{day:02d}\\n{WD[dd.weekday()]}')\n            cell.font = header_font\n            cell.fill = header_fill\n            cell.alignment = header_align\n            cell.border = thin_border\n            ds = dd.strftime('%Y-%m-%d')\n            if ds in holidays:\n                cell.fill = PatternFill('solid', fgColor='FFE0E0')\n            elif dd.weekday() >= 5:\n                cell.fill = PatternFill('solid', fgColor='EEEEEE')\n            if dd == today:\n                cell.fill = PatternFill('solid', fgColor='C8E6C9')\n        row = 4\n        total_tasks = {day: 0 for day in range(1, days_in_month + 1)}\n        total_hours = {day: 0.0 for day in range(1, days_in_month + 1)}\n        for emp in employees:\n            ws.cell(row=row, column=1, value=emp.get('name', '')).font = Font(bold=True)\n            ws.cell(row=row, column=1).border = thin_border\n            ws.cell(row=row, column=2, value=emp.get('department', '')).border = thin_border\n            emp_logs = logs_by_emp.get(emp['id'], {})\n            emp_vacs = emp.get('vacations', [])\n            for day in range(1, days_in_month + 1):\n                col = day + 2\n                ds = date(year, month, day).strftime('%Y-%m-%d')\n                cell = ws.cell(row=row, column=col)\n                cell.border = thin_border\n                cell.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)\n                vac = None\n                for v in emp_vacs:\n                    if v.get('from', '') <= ds <= v.get('to', ''):\n                        vac = v\n                        break\n                if vac:\n                    cell.value = ABSENCE_ICON.get(vac.get('type', 'vacation'), '📅')\n                    cell.font = Font(size=14)\n                    cell.fill = PatternFill('solid', fgColor='BBDEFB')\n                elif ds in emp_logs:\n                    logs = emp_logs[ds]\n                    first_status = (logs[0].get('status') or 'planned')\n                    cnt = len(logs)\n                    hrs = sum(float(l.get('hours') or 0) for l in logs)\n                    txt = f'{cnt} задач' if cnt > 1 else '1 задача'\n                    if hrs > 0:\n                        txt += f'\\n{hrs:g}ч'\n                    cell.value = txt\n                    cell.fill = PatternFill('solid', fgColor=STATUS_FILL_HEX.get(first_status, 'F5F5F5'))\n                    total_tasks[day] += cnt\n                    total_hours[day] += hrs\n                else:\n                    cell.value = ''\n            row += 1\n        ws.cell(row=row, column=1, value='ИТОГО').font = Font(bold=True, size=11)\n        for c in (1, 2):\n            ws.cell(row=row, column=c).fill = PatternFill('solid', fgColor='FDEBD0')\n            ws.cell(row=row, column=c).border = thin_border\n        for day in range(1, days_in_month + 1):\n            col = day + 2\n            cell = ws.cell(row=row, column=col)\n            cell.border = thin_border\n            cell.fill = PatternFill('solid', fgColor='FDEBD0')\n            cell.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)\n            if total_tasks[day] > 0:\n                cell.value = f'{total_tasks[day]}\\n{total_hours[day]:g}ч'\n        ws.column_dimensions['A'].width = 25\n        ws.column_dimensions['B'].width = 16\n        for day in range(1, days_in_month + 1):\n            ws.column_dimensions[get_column_letter(day + 2)].width = 9\n        ws.row_dimensions[3].height = 40\n        for r in range(4, row + 1):\n            ws.row_dimensions[r].height = 38\n        from io import BytesIO\n        output = BytesIO()\n        wb.save(output)\n        output.seek(0)\n        filename = f'calendar_{year}_{month:02d}.xlsx'\n        return send_file(output, mimetype='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', as_attachment=True, download_name=filename)\n\n\n\n    def _users_by_employee_ids(db, eids):\n        \"\"\"employee_id -> id активного пользователя.\"\"\"\n        out = {}\n        try:\n            for eid in set(e for e in (eids or []) if e):\n                row = db.query_one(\n                    'SELECT id FROM users WHERE employee_id=? AND is_active=1 LIMIT 1', (eid,))\n                if row:\n                    out[eid] = row['id']\n        except Exception as e:\n            print(f'[notify] _users_by_employee_ids failed: {e}')\n        return out\n\n    def _vertical_user_ids(db, employee_ids):\n        \"\"\"«Вертикаль» для набора сотрудников: руководители их команд\n        (teams.manager_id) и начальники их отделов (departments.head_employee_id).\n        Админы сюда НЕ включаются: если действие выполнял руководитель/админ,\n        рассылка всем админам только множит однотипные уведомления.\"\"\"\n        uids = set()\n        try:\n            emps = [e for e in (employee_ids or []) if e]\n            if not emps:\n                return []\n            ph = ','.join('?' * len(emps))\n            dept_ids = set()\n            for r in db.query(\n                    f'SELECT DISTINCT department_id AS did FROM employees WHERE id IN ({ph})', tuple(emps)):\n                if r.get('did'):\n                    dept_ids.add(r['did'])\n            mgr_eids = set()\n            # руководители команд, где состоят эти сотрудники\n            for r in db.query(\n                    f'SELECT DISTINCT t.manager_id AS mid FROM teams t '\n                    f'JOIN team_members tm ON tm.team_id = t.id '\n                    f'WHERE tm.employee_id IN ({ph})', tuple(emps)):\n                if r.get('mid'):\n                    mgr_eids.add(r['mid'])\n            # если сотрудник сам руководитель — его подчинённые не «вертикаль»,\n            # но его собственный начальник отдела добавится ниже через dept_ids\n            head_eids = set()\n            if dept_ids:\n                dp = ','.join('?' * len(dept_ids))\n                for r in db.query(\n                        f'SELECT head_employee_id AS hid FROM departments WHERE id IN ({dp})',\n                        tuple(dept_ids)):\n                    if r.get('hid'):\n                        head_eids.add(r['hid'])\n            umap = _users_by_employee_ids(db, list(mgr_eids | head_eids))\n            uids.update(umap.values())\n        except Exception as e:\n            print(f'[notify] _vertical_user_ids failed: {e}')\n        return list(uids)\n\n    def _is_manager_user(db, user):\n        \"\"\"True, если пользователь — админ, руководитель команды или начальник отдела.\"\"\"\n        try:\n            if (user or {}).get('role') == 'admin':\n                return True\n            _ue = ((user or {}).get('employee_id') or '').strip()\n            if not _ue:\n                return False\n            if db.query_one('SELECT 1 FROM teams WHERE manager_id=? LIMIT 1', (_ue,)):\n                return True\n            if db.query_one(\"SELECT 1 FROM departments WHERE head_employee_id=? AND head_employee_id!=\\'\\' LIMIT 1\", (_ue,)):\n                return True\n        except Exception:\n            pass\n        return False\n\n    def _notify_task_created(db, task_id, from_user):\n        \"\"\"Уведомление «создана новая задача» по вертикали исполнителей задачи.\n        Правило распределения: создатель (рядовой сотрудник или руководитель)\n        сам НЕ получает уведомление; получают руководители команд исполнителей\n        и начальники отделов. Если у задачи нет исполнителей — уведомляется\n        вертикаль создателя, а для рядового сотрудника — ещё и админы.\"\"\"\n        try:\n            from_uid = (from_user or {}).get('id')\n            t = db.query_one('SELECT name, icon FROM tasks WHERE id=?', (task_id,))\n            if not t:\n                return\n            assignees = [r.get('employee_id') or '' for r in\n                         db.query('SELECT employee_id FROM task_assignees WHERE task_id=?', (task_id,))]\n            assignees = [a for a in assignees if a]\n            recipients = set()\n            actor_is_manager = _is_manager_user(db, from_user)\n            if assignees:\n                recipients.update(_vertical_user_ids(db, assignees))\n            else:\n                recipients.update(_vertical_user_ids(db, [(from_user or {}).get('employee_id') or '']))\n                if not actor_is_manager:\n                    for u in db.query(\"SELECT id FROM users WHERE role='admin' AND is_active=1\"):\n                        recipients.add(u['id'])\n            if from_uid is not None:\n                recipients.discard(from_uid)\n            if not recipients:\n                return\n            who = ''\n            try:\n                _e = db.query_one('SELECT name FROM employees WHERE id=?',\n                                  (((from_user or {}).get('employee_id') or ''),))\n                who = (_e or {}).get('name', '')\n            except Exception:\n                pass\n            if not who:\n                who = (from_user or {}).get('username', '')\n            icon = t.get('icon') or '📋'\n            msg = f'{icon} Новая задача: {t.get(\"name\", task_id)} · создал(а) {who}'\n            now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n            with db.transaction() as tx:\n                for uid in recipients:\n                    tx.exec(\n                        'INSERT INTO notifications (ts, to_user_id, from_user_id, from_username, kind, task_id, employee_id, message) '\n                        'VALUES (?,?,?,?,?,?,?,?)',\n                        (now, uid, from_uid, (from_user or {}).get('username', ''),\n                         'task_created', task_id, (from_user or {}).get('employee_id') or '', msg),\n                    )\n        except Exception as e:\n            print(f'[notify] task_created failed: {e}')\n\n"
    },
    {
      "type": "regex",
      "path": "app.py",
      "pattern": "(        try:\\n            app\\.config\\['PLUGIN_REGISTRY'\\]\\.emit\\('on_task_save', user=u,\\n                                                task_id=task_id, created=created\\)\\n        except Exception:\\n            pass\\n)(        return jsonify\\(\\{'success': True, 'id': task_id, 'created': created\\}\\))",
      "content": "\\1        # PATCH v1.0.11b: уведомление по вертикали о новой задаче\\n        if created:\\n            try:\\n                _notify_task_created(db, task_id, u)\\n            except Exception as _e:\\n                print(f'[notify] task_created hook failed: {_e}')\\n\\2",
      "optional": false
    },
    {
      "type": "replace",
      "path": "static/tracker.js",
      "find": "'<span class=\"trk-bell-ico\">✅</span>'",
      "content": "'<span class=\"trk-bell-ico\">' + (it.kind === 'task_created' ? '🆕' : '✅') + '</span>'"
    },
    {
      "type": "regex",
      "path": "templates/tracker.html",
      "pattern": "[ \\t]*<button[^>]*id=\"calExportExcelBtn\"[^>]*>[^<]*</button>\\n?",
      "content": "",
      "optional": true
    }
  ]
}
