  "description": "Редизайн карточки отметки. Исправлено пропадание ссылок/приказов (без клонирования), кнопка задачи перенесена в инпут, логи внизу.",
  "requires": [],
  "operations": [

    {
      "type": "append",
      "path": "static/app.css",
      "idempotent": true,
      "content": "\n\n/* ============================================================\n   PATCH 1.0.4 — редизайн карточки отметки (v2 - стабильный)\n   ============================================================ */\n\n#logModal .modal-content {\n    display: flex !important;\n    flex-direction: column !important;\n    max-height: 92vh !important;\n    padding: 0 !important;\n    overflow: hidden !important;\n}\n\n#logModal .log-modal-body {\n    flex: 1 1 auto;\n    overflow-y: auto;\n    padding: 20px 24px 20px !important;\n    min-height: 0;\n}\n\n/* Карточки */\n#logModal .log-section-card {\n    background: var(--trk-hover-row);\n    border: 1px solid var(--trk-card-border);\n    border-radius: 12px;\n    padding: 16px;\n    margin-bottom: 16px;\n}\n#logModal .log-section-card > label {\n    display: block;\n    font-size: 0.75rem;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.6px;\n    color: var(--trk-meta);\n    margin-bottom: 12px;\n}\n\n/* Основное */\n#logModal .log-row-4 {\n    display: grid !important;\n    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;\n    gap: 12px !important;\n    margin-bottom: 0 !important;\n}\n\n/* Задача + кнопка */\n#logModal .log-task-wrap {\n    display: flex !important;\n    align-items: stretch !important;\n    gap: 12px !important;\n    width: 100% !important;\n}\n#logModal .log-task-wrap > input {\n    flex: 1 1 auto !important;\n    min-width: 0 !important;\n}\n#logModal .log-task-wrap > #logCreateTaskBtn {\n    flex: 0 0 auto !important;\n    margin: 0 !important;\n    height: auto !important;\n}\n\n#logModal .log-desc-group textarea {\n    min-height: 80px !important;\n}\n\n/* Спойлеры */\n#logModal details.log-section {\n    background: var(--trk-hover-row);\n    border: 1px solid var(--trk-card-border);\n    border-radius: 12px;\n    margin-bottom: 16px;\n    overflow: hidden;\n}\n#logModal details.log-section > summary {\n    cursor: pointer;\n    padding: 12px 16px;\n    font-size: 0.85rem;\n    font-weight: 700;\n    color: var(--trk-text);\n    list-style: none;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n#logModal details.log-section > summary::-webkit-details-marker { display: none; }\n#logModal details.log-section > summary::before {\n    content: '▶';\n    font-size: 0.65em;\n    color: var(--trk-meta);\n    transition: transform 0.2s ease;\n}\n#logModal details.log-section[open] > summary::before {\n    transform: rotate(90deg);\n}\n#logModal details.log-section > summary .cnt {\n    margin-left: auto;\n    font-size: 0.7rem;\n    padding: 2px 8px;\n    border-radius: 8px;\n    background: var(--trk-filter-active-bg);\n    color: var(--trk-filter-active);\n    font-weight: 800;\n}\n#logModal details.log-section > .log-section-body {\n    padding: 0 16px 16px;\n}\n\n/* Доп. данные */\n#logModal .log-extra-card {\n    background: var(--trk-hover-row);\n    border: 1px solid var(--trk-card-border);\n    border-radius: 12px;\n    padding: 16px;\n    margin-bottom: 16px;\n}\n#logModal .log-extra-card > label {\n    display: block;\n    font-size: 0.75rem;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.6px;\n    color: var(--trk-meta);\n    margin-bottom: 8px;\n}\n#logModal #logExtraDataList input {\n    width: 100%;\n    background: rgba(128,128,128,0.04) !important;\n    color: var(--trk-meta) !important;\n    cursor: default !important;\n    border: 1px solid var(--trk-border-soft) !important;\n}\n\n#logModal #logExtraAddBtn { display: none !important; }\n"
    },

    {
      "type": "append",
      "path": "static/tracker.js",
      "idempotent": true,
      "content": "\n\n/* ============================================================\n   PATCH 1.0.4 — редизайн карточки отметки (v2 - стабильный)\n   ============================================================ */\n(function(){\n'use strict';\nif (window.__trkLogModalCoolV104b) return;\nwindow.__trkLogModalCoolV104b = true;\n\nfunction $(id){ return document.getElementById(id); }\nfunction _findGroup(el){ return el ? el.closest('.form-group') : null; }\nfunction _removeLabel(group) {\n    if (!group) return;\n    var l = group.querySelector(':scope > label');\n    if (l) l.remove();\n}\n\nfunction _applyLayout(){\n    var m = $('logModal');\n    if (!m || !m.classList.contains('active')) return;\n    var body = m.querySelector('.log-modal-body');\n    if (!body) return;\n\n    // 1. Основное\n    var row4 = body.querySelector('.log-row-4');\n    if (row4 && !row4.closest('.log-section-card')) {\n        var w = document.createElement('div');\n        w.className = 'log-section-card';\n        w.innerHTML = '<label>Основное</label>';\n        row4.parentNode.insertBefore(w, row4);\n        w.appendChild(row4);\n    }\n\n    // 2. Задача (переносим кнопку внутрь .log-task-wrap)\n    var gTask = _findGroup($('log_task_input'));\n    var btnTask = $('logCreateTaskBtn');\n    if (gTask && btnTask) {\n        var taskWrap = gTask.querySelector('.log-task-wrap');\n        if (taskWrap && btnTask.parentNode !== taskWrap) {\n            // Удаляем старый заголовок и вставляем кнопку в конец обертки\n            taskWrap.appendChild(btnTask);\n        }\n        if (!gTask.closest('.log-section-card')) {\n            var wT = document.createElement('div');\n            wT.className = 'log-section-card';\n            wT.innerHTML = '<label>Задача</label>';\n            gTask.parentNode.insertBefore(wT, gTask);\n            wT.appendChild(gTask);\n            _removeLabel(gTask);\n        }\n    }\n\n    // 3. Описание\n    var gDesc = _findGroup($('log_comment'));\n    if (gDesc && !gDesc.closest('.log-section-card')) {\n        var wD = document.createElement('div');\n        wD.className = 'log-section-card';\n        wD.innerHTML = '<label>Описание</label>';\n        gDesc.parentNode.insertBefore(wD, gDesc);\n        wD.appendChild(gDesc);\n        _removeLabel(gDesc);\n    }\n\n    // 4. Приказы (физически оборачиваем существующий блок)\n    var gOrd = _findGroup($('logOrdersList'));\n    if (gOrd && !gOrd.querySelector('details')) {\n        var d = document.createElement('details');\n        d.className = 'log-section';\n        d.innerHTML = '<summary>📄 Приказы / распоряжения <span class=\"cnt\"></span></summary><div class=\"log-section-body\"></div>';\n        var b = d.querySelector('.log-section-body');\n        gOrd.parentNode.replaceChild(d, gOrd);\n        b.appendChild(gOrd);\n        _removeLabel(gOrd);\n        var cnt = b.querySelectorAll('.task-link-row').length;\n        d.querySelector('.cnt').textContent = cnt ? cnt : '';\n        if (cnt) d.open = true;\n    }\n\n    // 5. Ссылки\n    var gLnk = _findGroup($('logLinksList'));\n    if (gLnk && !gLnk.querySelector('details')) {\n        var d2 = document.createElement('details');\n        d2.className = 'log-section';\n        d2.innerHTML = '<summary>🔗 Ссылки <span class=\"cnt\"></span></summary><div class=\"log-section-body\"></div>';\n        var b2 = d2.querySelector('.log-section-body');\n        gLnk.parentNode.replaceChild(d2, gLnk);\n        b2.appendChild(gLnk);\n        _removeLabel(gLnk);\n        var cnt2 = b2.querySelectorAll('.task-link-row').length;\n        d2.querySelector('.cnt').textContent = cnt2 ? cnt2 : '';\n        if (cnt2) d2.open = true;\n    }\n\n    // 6. Доп. данные -> в самый конец\n    var gExt = _findGroup($('logExtraDataList'));\n    if (gExt && !gExt.closest('.log-extra-card')) {\n        var wE = document.createElement('div');\n        wE.className = 'log-extra-card';\n        wE.innerHTML = '<label>📁 Дополнительные данные (только чтение)</label>';\n        gExt.parentNode.insertBefore(wE, gExt);\n        wE.appendChild(gExt);\n        _removeLabel(gExt);\n        \n        var addBtn = $('logExtraAddBtn');\n        if (addBtn) addBtn.style.display = 'none';\n\n        // Переносим в самый конец body\n        body.appendChild(wE);\n    }\n    if (gExt) gExt.querySelectorAll('input').forEach(function(i){ i.readOnly = true; });\n}\n\nfunction _hook(){\n    var m = $('logModal');\n    if (!m) return false;\n    if (!m._v104ObsB) {\n        m._v104ObsB = true;\n        new MutationObserver(function(){\n            if (m.classList.contains('active')) {\n                setTimeout(_applyLayout, 60);\n            }\n        }).observe(m, { attributes: true, attributeFilter: ['class'] });\n    }\n    return true;\n}\n\nfunction boot(){\n    if (!_hook()) { setTimeout(boot, 300); return; }\n    if ($('logModal').classList.contains('active')) _applyLayout();\n}\n\nif (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\nelse boot();\n})();\n"
    }

  ]
}
