<div class="modal" id="logModal"><div class="modal-content log-modal-wide">
    <h2 id="logModalTitle">Новая отметка</h2>
    <div class="log-modal-body">
        <input type="hidden" id="log_id">
        <div id="logDayExisting" style="display:none; margin-bottom:12px;">
            <div style="font-size:0.75rem;color:var(--trk-meta);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:6px;">Уже заведено за этот день</div>
            <div class="log-existing-tabs" id="logExistingTabs" style="display:none;">
                <button type="button" class="log-existing-tab active" data-mode="me">Только выбранный сотрудник</button>
                <button type="button" class="log-existing-tab" data-mode="all">Показать всех</button>
            </div>
            <div class="day-list" id="logDayExistingList" style="margin-bottom:0;"></div>
        </div>
        <div class="form-row log-row-4">
            <div class="form-group"><label>📅 Дата *</label><input type="date" id="log_date"></div>
            <div class="form-group"><label>⏱ Часы</label><input type="number" id="log_hours" min="0" max="24" step="0.25" value="8"></div>
            <div class="form-group"><label>👤 Сотрудник *</label><select id="log_employee"></select></div>
            <div class="form-group"><label>📌 Статус</label>
                <select id="log_status">
                    <option value="in_progress">🔵 В работе</option>
                    <option value="done">✅ Готово</option>
                    <option value="planned">📝 Запланировано</option>
                    <option value="blocked">🔴 Заблокировано</option>
                </select>
            </div>
        </div>
        <div id="logDaySummary" class="log-day-summary" style="display:none;"></div>
        <div class="form-group trk-ltb-group">
            <label>📋 Задача *</label>
            <div class="log-task-wrap">
                <input type="text" id="log_task_input"
                       placeholder="Начните вводить или выберите из списка…"
                       autocomplete="new-kody"
                       spellcheck="false">
                <input type="hidden" id="log_task">
            </div>
            <button type="button" class="log-create-task-btn" id="logCreateTaskBtn" title="Создать новую задачу">➕ Новая задача</button>
           
        </div>
        <div class="form-group log-desc-group">
            <label>📝 Описание</label>
            <textarea id="log_comment" placeholder="Что сделано по задаче за день…"></textarea>
            <input type="hidden" id="log_link" value="">
        </div>
        <div class="log-multifields" id="logMultiFields">
            <div class="form-group">
                <label>📁 Дополнительные данные</label>
                <div id="logExtraDataList" class="task-links-list"></div>
                <button type="button" class="btn btn-secondary log-add-btn" id="logExtraAddBtn">➕ Добавить</button>
                <div class="assignees-hint">Строки добавятся в карточку задачи как «Дополнительные данные»</div>
            </div>
            <div class="form-group">
                <label>📄 Приказы / распоряжения</label>
                <div id="logOrdersList" class="task-links-list"></div>
                <button type="button" class="btn btn-secondary log-add-btn" id="logOrderAddBtn">➕ Добавить</button>
                <div class="assignees-hint">Описание — короткое название, значение — номер приказа / путь</div>
            </div>
            <div class="form-group">
                <label>🔗 Ссылки</label>
                <div id="logLinksList" class="task-links-list"></div>
                <button type="button" class="btn btn-secondary log-add-btn" id="logLinkAddBtn">➕ Добавить</button>
                <div class="assignees-hint">http/https — откроются, локальный путь — скопируется</div>
            </div>
        </div>
        <div class="log-multifields-ro" id="logMultiFieldsRO" style="display:none;" aria-hidden="true"></div>
    </div>
    <div class="modal-actions">
        <button class="btn btn-secondary" data-close="logModal">Отмена</button>
        <button class="btn btn-primary" id="saveLogBtn">💾 Сохранить</button>
    </div>
</div></div>
