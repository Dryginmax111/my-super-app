def _all_assignees_closed(db, task_id):
    """Возвращает (all_closed: bool, assignees: list).
    all_closed=True только если есть исполнители и все они последней
    отметкой закрыли задачу (status='done')."""
    try:
        assignees = [r.get('employee_id') or '' for r in db.query(
            'SELECT employee_id FROM task_assignees WHERE task_id=?', (task_id,))]
        assignees = [a for a in assignees if a]
        if not assignees:
            return False, []
        last_map = {}
        for l in db.query(
            'SELECT id, employee_id, status, date FROM work_logs WHERE task_id=? ORDER BY date, id',
            (task_id,),
        ):
            eid = l.get('employee_id') or ''
            if not eid:
                continue
            cur = last_map.get(eid)
            if not cur or (l.get('date') or '', l.get('id') or 0) > (cur.get('date') or '', cur.get('id') or 0):
                last_map[eid] = l
        for eid in assignees:
            rec = last_map.get(eid)
            if not rec or (rec.get('status') or '') != 'done':
                return False, assignees
        return True, assignees
    except Exception as e:
        print(f'[all_assignees_closed] failed for {task_id}: {e}')
        return False, []


def _try_reopen_if_stale_autoclose(db, task_id, u=None):
    """Если задача была закрыта автозакрытием (auto_closed_at непустой),
    а сейчас кто-то из исполнителей уже не в 'done' — вернуть задачу в 'active'
    и снять метку авто. Ручные закрытия (auto_closed_at пустой) не трогаем.
    Возвращает True если задача была раз-закрыта."""
    try:
        t = db.query_one('SELECT id, status, auto_closed_at FROM tasks WHERE id=?', (task_id,))
        if not t:
            return False
        if (t.get('status') or '') != 'done':
            return False
        if not (t.get('auto_closed_at') or '').strip():
            return False  # закрыто вручную — не наш случай
        ok, assignees = _all_assignees_closed(db, task_id)
        if ok:
            return False  # всё ещё все закрыты
        db.exec(
            "UPDATE tasks SET status='active', completed_at='', auto_closed_at='' WHERE id=?",
            (task_id,),
        )
        try:
            with db.transaction() as tx:
                tx.exec(
                    'INSERT INTO audit_log (ts, user_id, username, kind, entity, entity_id, details) VALUES (?,?,?,?,?,?,?)',
                    (datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
                     (u or {}).get('id'), 'system:autoclose',
                     'update', 'task', str(task_id),
                     json.dumps({'action': 'auto_reopen',
                                 'reason': 'assignee_rolled_back',
                                 'assignees': assignees}, ensure_ascii=False)),
                )
        except Exception as _e:
            print(f'[autoclose] audit failed: {_e}')
        print(f'[autoclose] task {task_id} -> active (автозакрытие отменено)')
        return True
    except Exception as e:
        print(f'[autoclose] reopen failed for {task_id}: {e}')
        return False

def _autoclose_if_all_done(db, task_id, u=None):
    """Если все назначенные закрыли задачу — перевести её в done.
    Не трогает периодические задачи и задачи без assignees.
    Возвращает True если задача была закрыта."""
    try:
        t = db.query_one('SELECT id, status FROM tasks WHERE id=?', (task_id,))
        if not t:
            return False
        st = (t.get('status') or 'active').strip()
        if st not in ('active', 'paused'):
            return False
        tags = [r.get('tag') or '' for r in db.query('SELECT tag FROM task_tags WHERE task_id=?', (task_id,))]
        if 'pereodic' in tags:
            return False
        assignees = [r.get('employee_id') or '' for r in db.query('SELECT employee_id FROM task_assignees WHERE task_id=?', (task_id,))]
        assignees = [a for a in assignees if a]
        if not assignees:
            return False
        last_map = {}
        for l in db.query('SELECT id, employee_id, status, date FROM work_logs WHERE task_id=? ORDER BY date, id', (task_id,)):
            eid = l.get('employee_id') or ''
            if not eid:
                continue
            cur = last_map.get(eid)
            if not cur or (l.get('date') or '', l.get('id') or 0) > (cur.get('date') or '', cur.get('id') or 0):
                last_map[eid] = l
        for eid in assignees:
            rec = last_map.get(eid)
            if not rec or (rec.get('status') or '') != 'done':
                return False
        # PATCH v1.0.8: completed_at = последняя done-отметка, а не today
        _last_done = None
        try:
            _row = db.query_one(
                "SELECT MAX(date) AS d FROM work_logs WHERE task_id=? AND status='done'",
                (task_id,),
            )
            if _row and _row.get('d'):
                _last_done = _row['d']
        except Exception as _e:
            print(f'[autoclose] max date failed: {_e}')
        _completed_at = _last_done or date.today().strftime('%Y-%m-%d')
        now_full = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        # PATCH v1.0.9: пишем auto_closed_at — по нему UI отличает автозакрытие
        db.exec(
            "UPDATE tasks SET status='done', completed_at=?, auto_closed_at=? WHERE id=?",
            (_completed_at, now_full, task_id),
        )
        try:
            with db.transaction() as tx:
                tx.exec(
                    'INSERT INTO audit_log (ts, user_id, username, kind, entity, entity_id, details) VALUES (?,?,?,?,?,?,?)',
                    (now_full,
                     (u or {}).get('id'), 'system:autoclose',
                     'update', 'task', str(task_id),
                     json.dumps({'action': 'auto_close', 'reason': 'all_assignees_done',
                                 'assignees': assignees,
                                 'auto_closed_at': now_full}, ensure_ascii=False)),
                )
        except Exception as _e:
            print(f'[autoclose] audit failed: {_e}')
        print(f'[autoclose] task {task_id} -> done (все назначенные закрыли, auto_closed_at={now_full})')
        return True
    except Exception as e:
        print(f'[autoclose] failed for {task_id}: {e}')
        return False


