    @app.route('/api/tracker/employee/save', methods=['POST'])
    @login_required
    def api_employee_save():
        body = request.get_json() or {}
        emp_id = str(body.get('id', '')).strip()
        name = str(body.get('name', '')).strip()[:100]
        color = str(body.get('color', '')).strip()[:20] or '#00897b'
        role = str(body.get('role', '')).strip()[:50]
        department_id = str(body.get('department_id', '')).strip()
        fired = bool(body.get('fired', False))
        fired_date = str(body.get('fired_date', '')).strip()[:20]
        hired_date = str(body.get('hired_date', '')).strip()[:20]
        if fired_date and not _valid_date(fired_date):
            fired_date = ''
        if not fired:
            fired_date = ''
        if hired_date and not _valid_date(hired_date):
            hired_date = ''
        # PATCH v1.0.6: дата увольнения не может быть раньше даты выхода
        if fired_date and hired_date and fired_date < hired_date:
            return jsonify({'success': False, 'error': 'Дата увольнения раньше даты выхода на работу'}), 400
        if not name:
            return jsonify({'success': False, 'error': 'Имя обязательно'}), 400

        u = current_user(db)
        need = 'action.employee.edit' if emp_id else 'action.employee.create'
        if not user_has(db, u, need):
            return jsonify({'success': False, 'error': 'forbidden', 'need': need}), 403

        data = _data(db)
        if department_id and not any(d['id'] == department_id for d in data['departments']):
            department_id = ''

        if not emp_id:
            base = _slugify(name)
            emp_id = base
            i = 1
            existing = {e['id'] for e in data['employees']}
            while emp_id in existing:
                i += 1
                emp_id = f'{base}_{i}'

        created = db.upsert_employee(emp_id, name, color, role, department_id, fired, fired_date, hired_date)
        _audit(db, u, 'create' if created else 'update', 'employee', emp_id, {'name': name})

        try:
            existing_user = db.query_one(
                'SELECT id FROM users WHERE employee_id=?', (emp_id,)
            )
            if not existing_user:
                base = _translit_username(name)
                uname = base
                i = 1
                while db.user_get_by_name(uname):
                    i += 1
                    uname = f'{base}_{i}'
                # PATCH v2: hash_kody (кириллица)
                new_uid = db.user_create(
                    uname, hash_kody('123456'), 'user', name, emp_id
                )
                db.user_permissions_set(
                    new_uid, {k: True for k in DEFAULT_USER_PERMISSIONS}
                )
                _audit(db, u, 'create', 'user', new_uid, {'username': uname, 'auto': True})
        except Exception as e:
            print(f'[employee_save] auto-create user failed: {e}')

        return jsonify({'success': True, 'id': emp_id, 'created': created})

