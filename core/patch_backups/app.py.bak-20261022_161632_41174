                continue
            ldate = l.get('date', '')
            if not ldate or ldate < date_from or ldate > date_to:
                continue
            if _ifu_tc and ldate > today:
                continue
            eid = l.get('employee_id')
            h = float(l.get('hours', 0) or 0)
            matrix.setdefault(eid, {})
            matrix[eid][ldate] = matrix[eid].get(ldate, 0.0) + h
            total += h

        combined = {}
        for eid, cm in matrix.items():
            for dk, h in cm.items():
                combined[dk] = combined.get(dk, 0.0) + h

        comb_cells = []
        max_h = 0.0
        cur = ts_show
        while cur <= te_show:
            dk = cur.strftime('%Y-%m-%d')
            h = round(combined.get(dk, 0.0) * 4) / 4
            if h > max_h:
                max_h = h
            wd = cur.weekday()
            is_wknd = wd >= 5
            is_hol = dk in holidays
            comb_cells.append({
                'date': dk, 'hours': h,
                'is_workday': (wd in WORK_WEEKDAYS) and not is_hol,
                'is_weekend': is_wknd, 'is_holiday': is_hol, 'is_today': dk == today,
            })
            cur += timedelta(days=1)

        _assigned_ids = list(t.get('assignees') or [])
        for _aid in _assigned_ids:
            if _aid and _aid not in matrix:
                matrix[_aid] = {}
        rows = []
        for eid, cm in matrix.items():
            e = em.get(eid) or {'id': eid, 'name': '— удалён —', 'color': '#888'}
            tot = sum(cm.values())
            ad = sum(1 for h in cm.values() if h > 0)
            emp_ck = _emp_completion_kind(t, data['log'], eid)
            emp_cells = []
            cur2 = ts_show
            while cur2 <= te_show:
                dk2 = cur2.strftime('%Y-%m-%d')
                h2 = round(cm.get(dk2, 0.0) * 4) / 4
                wd2 = cur2.weekday()
                is_wknd2 = wd2 >= 5
                is_hol2 = dk2 in holidays
                emp_cells.append({
                    'date': dk2, 'hours': h2,
                    'is_workday': (wd2 in WORK_WEEKDAYS) and not is_hol2,
                    'is_weekend': is_wknd2,
                    'is_holiday': is_hol2,
                    'is_today': dk2 == today,
                })
                cur2 += timedelta(days=1)
            _last_recs = [l for l in data['log']
                          if l.get('employee_id') == eid and l.get('task_id') == task_id]
            _last_recs.sort(key=lambda x: ((x.get('date') or ''), (x.get('id') or 0)))
            _last_status = _last_recs[-1].get('status', '') if _last_recs else ''
            _assigned = eid in (t.get('assignees') or [])
            _worked = tot > 0
            _cov = 0
            try:
                _cov = _calc_coverage(t, e, _last_recs, today_d)[2]
            except Exception:
                _cov = 0
            rows.append({
                'employee_id': eid,
                'employee_name': e.get('name', ''),
                'employee_color': e.get('color', '#888'),
                'employee_department': e.get('department', ''),
                'total_hours': round(tot * 4) / 4,
                'active_days': ad,
                'overdue': _emp_is_overdue(t, data['log'], eid, today),
                'emp_completed_at': _emp_last_done_date(data['log'], eid, task_id),
                'emp_completion_kind': emp_ck,
                'cells': emp_cells,
                'assigned': bool(_assigned),
                'worked': bool(_worked),
                'coverage': _cov,
                'last_status': _last_status,
            })
        rows.sort(key=lambda x: (0 if x.get('worked') else 1, -x['total_hours'], (x.get('employee_name') or '').lower()))

        logs_all = [l for l in data['log'] if l.get('task_id') == task_id]
        ad_all, pd_all, cov = _calc_coverage(t, None, logs_all, today_d)
        dd = None
        ck = _completion_kind(t)
        if ck and t.get('completed_at') and t.get('deadline'):
            try:
                dd = (datetime.strptime(t['completed_at'][:10], '%Y-%m-%d').date()
                      - datetime.strptime(t['deadline'], '%Y-%m-%d').date()).days
            except Exception:
                dd = None

        _feed = []
        _links_list = []
        for _l in data['log']:
            if _l.get('task_id') != task_id:
                continue
            _ld = _l.get('date', '')
            _eid = _l.get('employee_id', '')
            _e = em.get(_eid) or {}
            _cm = (_l.get('comment') or '').strip()
            if _cm:
                _feed.append({
                    'date': _ld,
                    'employee_id': _eid,
                    'employee_name': _e.get('name', ''),
                    'employee_color': _e.get('color', '#888'),
                    'comment': _cm[:1500],
                    'hours': float(_l.get('hours', 0) or 0),
                    'status': _l.get('status', ''),
                    'status_label': STATUS_LABELS.get(_l.get('status', ''), ''),
                })
            _lk = (_l.get('link') or '').strip()
            if _lk:
                _links_list.append({
                    'date': _ld,
                    'employee_name': _e.get('name', ''),
                    'employee_color': _e.get('color', '#888'),
                    'link': _lk[:500],
                })
        _feed.sort(key=lambda x: x['date'], reverse=True)
        _links_list.sort(key=lambda x: x['date'], reverse=True)
        _first_log = min((l.get('date', '') for l in logs_all if l.get('date')), default='')
        _last_log = max((l.get('date', '') for l in logs_all if l.get('date')), default='')
        return jsonify({
            'success': True, 'from': date_from, 'to': date_to,
            'task': {
                'id': t['id'], 'name': t.get('name', ''),
                'icon': t.get('icon', '📋'),
                'tags': list(t.get('tags') or []),
                'status': t.get('status', 'active'),
                'start_date': t.get('start_date', ''),
                'deadline': t.get('deadline', ''),
                'completed_at': t.get('completed_at', ''),
                'auto_closed_at': t.get('auto_closed_at', ''),
                'completion_kind': ck, 'days_delta': dd,
                'overdue': _is_overdue(t, today),
                'description': t.get('description', ''),
                'folder': t.get('folder', ''),
                'orders': list(t.get('orders') or []),
                'links': list(t.get('links') or []),
                'extra_meta': list(t.get('extra_meta') or []),
            },
            'cells': comb_cells, 'max_hours': max_h,
            'employees': rows,
            'total_hours': round(total * 4) / 4,
            'active_days': ad_all, 'possible_days': pd_all, 'coverage': cov,
            'feed': _feed[:80],
            'links': _links_list[:40],
            'first_log': _first_log,
            'last_log': _last_log,
        })

    # ============================================================
    # API: STATS
    # ============================================================
    @app.route('/api/tracker/stats', methods=['GET'])
    @login_required
    @permission_required('tab.stats')
    def api_stats():
        data = _data(db)
        u = current_user(db)
        perms = effective_permissions(db, u)
        date_from = request.args.get('from', '').strip()
        date_to = request.args.get('to', '').strip()
        emp_filter = request.args.get('employee', '').strip()
        dept_filter = request.args.get('department', '').strip()
        team_filter = request.args.get('team', '').strip()
        tag_filter = request.args.get('tag', '').strip()

        tag_mode = (request.args.get('tag_mode') or 'any').strip().lower()
        if tag_mode not in ('any', 'all'):
            tag_mode = 'any'
        if tag_filter:
            wanted_tags = [x.strip() for x in tag_filter.split(',') if x.strip()]
            if wanted_tags:
                if tag_mode == 'all':
                    data['tasks'] = [
                        t for t in data['tasks']
                        if all(tag in (t.get('tags') or []) for tag in wanted_tags)
                    ]
                else:
                    data['tasks'] = [
                        t for t in data['tasks']
                        if any(tag in (t.get('tags') or []) for tag in wanted_tags)
                    ]
                _valid_tag_task_ids = {t['id'] for t in data['tasks']}
                data['log'] = [l for l in data['log']
                               if l.get('task_id') in _valid_tag_task_ids]

        if not _valid_date(date_from):
            date_from = date.today().replace(day=1).strftime('%Y-%m-%d')
        if not _valid_date(date_to):
            date_to = date.today().strftime('%Y-%m-%d')
        df = datetime.strptime(date_from, '%Y-%m-%d').date()
        dt_ = datetime.strptime(date_to, '%Y-%m-%d').date()
        if df > dt_:
            df, dt_ = dt_, df
        today = date.today().strftime('%Y-%m-%d')
        team_ids = _team_filter_emp_ids(data, team_filter)

        em = {e['id']: e for e in data['employees']}
        tm = {t['id']: t for t in data['tasks']}

        emp_ids = set()
        for e in data['employees']:
            if emp_filter and e['id'] != emp_filter:
                continue
            if dept_filter and e.get('department_id', '') != dept_filter:
                continue
            if team_ids is not None and e['id'] not in team_ids:
                continue
            if not perms.get('block.stats.other_employees'):
                my_emp = u.get('employee_id') or ''
                if not my_emp or e['id'] != my_emp:
                    continue
            if e.get('fired') and e.get('fired_date') and e['fired_date'] <= date_from:
                continue
            emp_ids.add(e['id'])

        def log_in_period(l):
            e = em.get(l.get('employee_id'))
            if not e:
                return True
            dk = l.get('date', '')
            if not dk:
                return False
            return _is_active_on(e, dk)

        # PATCH 1.0.5: не учитываем отметки на будущее, если включён флаг
        try:
            _ifu_stats = str(db.get_setting('stats_ignore_future', '1')) != '0'
        except Exception:
            _ifu_stats = True
        _today_stats = date.today().strftime('%Y-%m-%d')
        logs_period = [l for l in data['log']
                       if date_from <= l.get('date', '') <= date_to
                       and (not _ifu_stats or (l.get('date', '') <= _today_stats))
                       and l.get('employee_id') in emp_ids
                       and log_in_period(l)]
        hours_by_emp = {}
        for l in logs_period:
            eid = l['employee_id']
            hours_by_emp[eid] = hours_by_emp.get(eid, 0.0) + float(l.get('hours', 0) or 0)

        by_employee = []
        for e in data['employees']:
            if e['id'] not in emp_ids:
                continue
            eid = e['id']
            task_ids = {t['id'] for t in data['tasks'] if eid in t.get('assignees', [])}
            task_ids |= {l.get('task_id') for l in logs_period
                         if l.get('employee_id') == eid}
            tasks_rel = [tm[tid] for tid in task_ids if tid in tm]
            emp_logs_all = [l for l in data['log'] if l.get('employee_id') == eid]

            done_cnt = active_cnt = overdue_cnt = 0
            early_ids = set(); late_ids = set(); on_time_ids = set()
            for t in tasks_rel:
                if _emp_done_task(t, emp_logs_all, eid):
                    done_cnt += 1
                elif t.get('status') == 'active':
                    active_cnt += 1
                if _emp_is_overdue(t, emp_logs_all, eid, today):
                    overdue_cnt += 1
                k = _emp_completion_kind(t, emp_logs_all, eid)
                if k == 'early':
                    early_ids.add(t['id'])
                elif k == 'late':
                    late_ids.add(t['id'])
                elif k == 'on_time':
                    on_time_ids.add(t['id'])

            wdone = set(); wprog = set()
            for l in logs_period:
                if l.get('employee_id') != eid:
                    continue
                st = l.get('status', 'done')
                if st == 'done':
                    wdone.add(l.get('task_id'))
                elif st == 'in_progress':
                    wprog.add(l.get('task_id'))

            vac_d = sick_d = trip_d = 0
            for v in e.get('vacations', []) or []:
                vf, vt = v.get('from', ''), v.get('to', '')
                if not vf or not vt:
                    continue
                s = max(vf, date_from)
                ee = min(vt, date_to)
                if s <= ee:
                    days = (datetime.strptime(ee, '%Y-%m-%d')
                            - datetime.strptime(s, '%Y-%m-%d')).days + 1
                    vt_type = v.get('type', 'vacation')
                    if vt_type == 'sick_leave':
                        sick_d += days
                    elif vt_type == 'business_trip':
                        trip_d += days
                    else:
                        vac_d += days

            by_employee.append({
                'employee_id': eid,
                'employee_name': e.get('name', ''),
                'employee_color': e.get('color', '#888'),
                'employee_department': e.get('department', ''),
                'employee_fired': bool(e.get('fired')),
                'employee_fired_date': e.get('fired_date', ''),
                'hours': round(hours_by_emp.get(eid, 0.0) * 4) / 4,
                'total_tasks': len(tasks_rel),
                'done_tasks': done_cnt,
                'active_tasks': active_cnt,
                'overdue_tasks': overdue_cnt,
                'worked_done': len(wdone),
                'worked_in_progress': len(wprog),
                'early_done': len(early_ids),
                'late_done': len(late_ids),
                'on_time_done': len(on_time_ids),
                'vacation_days': vac_d,
                'sick_days': sick_d,
                'business_trip_days': trip_d,
            })
        _emp_order_map = {e['id']: i for i, e in enumerate(data['employees'])}
        by_employee.sort(key=lambda r: _emp_order_map.get(r['employee_id'], 999999))

        by_task = []
        for t in data['tasks']:
            tid = t['id']
            assigned_f = [a for a in t.get('assignees', []) if a in emp_ids]
            logs_t = [l for l in logs_period if l.get('task_id') == tid]
            if dept_filter:
                dept_ids = {e['id'] for e in data['employees']
                            if e.get('department_id') == dept_filter}
                if not _task_matches_dept(t, dept_filter, dept_ids):
                    if not assigned_f and not logs_t:
                        continue
            if not assigned_f and not logs_t:
                continue
            workers = {l['employee_id'] for l in logs_t}
            total_h = sum(float(l.get('hours', 0) or 0) for l in logs_t)
            any_done = any(l.get('status') == 'done' for l in logs_t)
            any_ip = any(l.get('status') == 'in_progress' for l in logs_t)
            ck = _completion_kind(t)
            closed_by = []
            for a in assigned_f:
                alogs = [l for l in data['log'] if l.get('employee_id') == a]
                if _emp_closed_task(alogs, a, tid):
                    closed_by.append(a)
            by_task.append({
                'task_id': tid, 'task_name': t.get('name', ''),
                'task_icon': t.get('icon', '📋'),
                'task_tags': list(t.get('tags') or []),
                'status': t.get('status', 'active'),
                'deadline': t.get('deadline', ''),
                'completed_at': t.get('completed_at', ''),
                'completion_kind': ck,
                'overdue': _is_overdue(t, today),
                'assigned_count': len(assigned_f),
                'workers_count': len(workers),
                'closed_by_count': len(closed_by),
                'hours': round(total_h * 4) / 4,
                'any_done': any_done,
                'any_in_progress': any_ip,
            })
        by_task.sort(key=lambda r: -r['hours'])

        overall = {
            'employees_count': len(by_employee),
            'tasks_total': sum(r['total_tasks'] for r in by_employee),
            'tasks_done': sum(r['done_tasks'] for r in by_employee),
            'tasks_active': sum(r['active_tasks'] for r in by_employee),
            'tasks_overdue': sum(r['overdue_tasks'] for r in by_employee),
            'early_done': sum(r['early_done'] for r in by_employee),
            'late_done': sum(r['late_done'] for r in by_employee),
            'on_time_done': sum(r['on_time_done'] for r in by_employee),
            'hours_total': round(sum(r['hours'] for r in by_employee) * 4) / 4,
            'vacation_days': sum(r['vacation_days'] for r in by_employee),
            'sick_days': sum(r['sick_days'] for r in by_employee),
            'business_trip_days': sum(r['business_trip_days'] for r in by_employee),
        }

        overdue_details = []
        if perms.get('block.stats.overdue'):
            for t in data['tasks']:
                assigned = [e for e in data['employees']
                            if e['id'] in t.get('assignees', [])]
                if not perms.get('block.stats.other_employees') and u.get('employee_id'):
                    assigned = [e for e in assigned if e['id'] == u['employee_id']]
                if dept_filter:
                    assigned = [e for e in assigned
                                if e.get('department_id') == dept_filter]
                if team_ids is not None:
                    assigned = [e for e in assigned if e['id'] in team_ids]
                if emp_filter:
                    assigned = [e for e in assigned if e['id'] == emp_filter]
                if (emp_filter or dept_filter or team_filter) and not assigned:
                    continue
                overdue_emps = []
                for e in assigned:
                    elogs = [l for l in data['log'] if l.get('employee_id') == e['id']]
                    if _emp_is_overdue(t, elogs, e['id'], today):
                        overdue_emps.append(e)
                if not overdue_emps:
                    continue
                try:
                    days_ov = (date.today() - datetime.strptime(
                        t.get('deadline', ''), '%Y-%m-%d').date()).days
                except Exception:
                    days_ov = 0
                overdue_details.append({
                    'task_id': t['id'], 'task_name': t.get('name', ''),
                    'task_icon': t.get('icon', '📋'),
                    'deadline': t.get('deadline', ''),
                    'days_overdue': days_ov,
                    'status': t.get('status', 'active'),
                    'assignees': [{
                        'id': e['id'], 'name': e.get('name', ''),
                        'color': e.get('color', '#888'),
                    } for e in overdue_emps],
                })
            overdue_details.sort(key=lambda x: -x['days_overdue'])

        tag_stats = {}
        for t in data['tasks']:
            for tag in (t.get('tags') or []):
                ts = tag_stats.setdefault(tag, {
                    'tag': tag, 'tasks': 0, 'hours': 0.0,
                    'done': 0, 'overdue': 0,
                })
                ts['tasks'] += 1
                if t.get('status') == 'done':
                    ts['done'] += 1
                if _is_overdue(t, today):
                    ts['overdue'] += 1
        task_tag_map = {t['id']: (t.get('tags') or []) for t in data['tasks']}
        for l in logs_period:
            tid = l.get('task_id')
            h = float(l.get('hours', 0) or 0)
            for tag in task_tag_map.get(tid, []):
                tag_stats[tag]['hours'] += h
        for v in tag_stats.values():
            v['hours'] = round(v['hours'] * 4) / 4
        tags_summary = sorted(tag_stats.values(), key=lambda x: -x['hours'])

        all_days_stats = []
        curd = df
        while curd <= dt_:
            all_days_stats.append(curd.strftime('%Y-%m-%d'))
            curd += timedelta(days=1)
        hours_by_day = {dk: 0.0 for dk in all_days_stats}
        for l in logs_period:
            dk = l.get('date', '')
            if dk in hours_by_day:
                hours_by_day[dk] += float(l.get('hours', 0) or 0)
        hours_series = [
            {'date': dk, 'hours': round(hours_by_day[dk] * 4) / 4}
            for dk in all_days_stats
        ]

        return jsonify({
            'success': True, 'from': date_from, 'to': date_to,
            'by_employee': by_employee, 'by_task': by_task,
            'overall': overall, 'overdue_details': overdue_details,
            'tags_summary': tags_summary,
            'hours_series': hours_series,
            'absence_types': ABSENCE_TYPES,
        })

    # ============================================================
    # API: HEATMAP
    # ============================================================
    @app.route('/api/tracker/heatmap', methods=['GET'])
    @login_required
    @permission_required('tab.heatmap')
    def api_heatmap():
        u = current_user(db)
        perms = effective_permissions(db, u)
        # PATCH v1.0.46: мультивыбор отделов + периоды
        dept_filter_raw = request.args.get('department', '').strip()
        dept_ids = [x.strip() for x in dept_filter_raw.split(',') if x.strip()] if dept_filter_raw else []
        team_filter = request.args.get('team', '').strip()
        ym = request.args.get('ym', '').strip()
        date_from = request.args.get('from', '').strip()
        date_to = request.args.get('to', '').strip()
        period = (request.args.get('period') or '').strip().lower()
        anchor = (request.args.get('anchor') or '').strip()
        if period in ('year', 'quarter', 'month', 'week') and _valid_date(anchor):
            _a = datetime.strptime(anchor, '%Y-%m-%d').date()
            if period == 'year':
                date_from = f'{_a.year:04d}-01-01'
                date_to = f'{_a.year:04d}-12-31'
            elif period == 'quarter':
                _q = (_a.month - 1) // 3 + 1
                _m1 = (_q - 1) * 3 + 1
                _m3 = _m1 + 2
                date_from = f'{_a.year:04d}-{_m1:02d}-01'
                _last = monthrange(_a.year, _m3)[1]
                date_to = f'{_a.year:04d}-{_m3:02d}-{_last:02d}'
            elif period == 'month':
                _last = monthrange(_a.year, _a.month)[1]
                date_from = f'{_a.year:04d}-{_a.month:02d}-01'
                date_to = f'{_a.year:04d}-{_a.month:02d}-{_last:02d}'
            elif period == 'week':
                _mon = _a - timedelta(days=_a.weekday())
                _sun = _mon + timedelta(days=6)
                date_from = _mon.strftime('%Y-%m-%d')
                date_to = _sun.strftime('%Y-%m-%d')
        if not _valid_date(date_from) or not _valid_date(date_to):
            y, m = _parse_ym(ym or date.today().strftime('%Y-%m'))
            last = monthrange(y, m)[1]
            date_from = f'{y:04d}-{m:02d}-01'
            date_to = f'{y:04d}-{m:02d}-{last:02d}'
        # PATCH v1.0.7: грузим логи только за видимый период
        data = _data(db, since=date_from)
        df = datetime.strptime(date_from, '%Y-%m-%d').date()
        dt_ = datetime.strptime(date_to, '%Y-%m-%d').date()
        today = date.today().strftime('%Y-%m-%d')
        holidays = data['holidays']
        team_ids = _team_filter_emp_ids(data, team_filter)

        all_days = []
        cur = df
        while cur <= dt_:
            all_days.append(cur.strftime('%Y-%m-%d'))
            cur += timedelta(days=1)

        emps = data['employees']
        if dept_ids:
            emps = [e for e in emps if e.get('department_id') in dept_ids]
        if team_ids is not None:
            emps = [e for e in emps if e['id'] in team_ids]
        if not perms.get('block.heatmap.other_employees'):
            my_emp = u.get('employee_id') or ''
            emps = [e for e in emps if e['id'] == my_emp] if my_emp else []

        emps_ids = {e['id'] for e in emps}
        matrix = {}
        for l in data['log']:
            ldate = l.get('date', '')
            if not ldate or ldate < date_from or ldate > date_to:
                continue
            eid = l.get('employee_id')
            if eid not in emps_ids:
                continue
            matrix.setdefault(eid, {})
            matrix[eid][ldate] = matrix[eid].get(ldate, 0.0) + float(l.get('hours', 0) or 0)

        rows = []
        max_h = 0.0
        for e in emps:
            eid = e['id']
            cells = []
            tot = 0.0
            for dk in all_days:
                try:
                    wd = datetime.strptime(dk, '%Y-%m-%d').weekday()
                except Exception:
                    wd = 0
                is_wknd = wd >= 5
                is_hol = dk in holidays
                is_wd = (wd in WORK_WEEKDAYS) and not is_hol
                absence = _absence_type(e, dk)
                is_remote = (absence == 'remote')
                is_vac = bool(absence) and not is_remote
                h = round(matrix.get(eid, {}).get(dk, 0.0) * 4) / 4
                if h > max_h:
                    max_h = h
                tot += h
                missing = (
                    is_wd and not is_vac and dk <= today and h == 0
                    and _is_active_on(e, dk) and not _is_dept_head(e)
                )
                cells.append({
                    'date': dk, 'hours': h,
                    'is_workday': is_wd, 'is_vacation': is_vac,
                    'is_remote': is_remote,
                    'absence_type': absence,
                    'is_weekend': is_wknd, 'is_holiday': is_hol,
                    'missing': missing, 'is_today': dk == today,
                })
            rows.append({
                'employee_id': eid,
                'employee_name': e.get('name', ''),
                'employee_color': e.get('color', '#888'),
                'employee_department': e.get('department', ''),
                'employee_fired': bool(e.get('fired')),
                'employee_fired_date': e.get('fired_date', ''),
                'cells': cells,
                'total_hours': round(tot * 4) / 4,
            })
        _emp_order_map = {e['id']: i for i, e in enumerate(data['employees'])}
        rows.sort(key=lambda r: _emp_order_map.get(r['employee_id'], 999999))
        return jsonify({
            'success': True, 'from': date_from, 'to': date_to,
            'days': all_days, 'rows': rows, 'max_hours': max_h,
            'absence_types': ABSENCE_TYPES,
        })

