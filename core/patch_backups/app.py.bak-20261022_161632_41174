    # API: SUMMARY
    # ============================================================
    def _summary_impl(mode):
        data = _data(db)
        u = current_user(db)
        perms = effective_permissions(db, u)
        date_from = request.args.get('from', '').strip()
        date_to = request.args.get('to', '').strip()
        emp_filter = request.args.get('employee', '').strip()
        task_filter = request.args.get('task', '').strip()
        dept_filter = request.args.get('department', '').strip()
        team_filter = request.args.get('team', '').strip()
        tag_filter = request.args.get('tag', '').strip()

        tag_mode = (request.args.get('tag_mode') or 'any').strip().lower()
        if tag_mode not in ('any', 'all'):
            tag_mode = 'any'
        if tag_filter:
            wanted_tags = [x.strip() for x in tag_filter.split(',') if x.strip()]
            if wanted_tags:
                if tag_mode == 'all':
                    data['tasks'] = [
                        t for t in data['tasks']
                        if all(tag in (t.get('tags') or []) for tag in wanted_tags)
                    ]
                else:
                    data['tasks'] = [
                        t for t in data['tasks']
                        if any(tag in (t.get('tags') or []) for tag in wanted_tags)
                    ]
                _valid_tag_task_ids = {t['id'] for t in data['tasks']}
                data['log'] = [l for l in data['log']
                               if l.get('task_id') in _valid_tag_task_ids]

        if not _valid_date(date_from):
            date_from = date.today().replace(day=1).strftime('%Y-%m-%d')
        if not _valid_date(date_to):
            date_to = date.today().strftime('%Y-%m-%d')
        df = datetime.strptime(date_from, '%Y-%m-%d').date()
        dt_ = datetime.strptime(date_to, '%Y-%m-%d').date()
        if df > dt_:
            df, dt_ = dt_, df

        all_days = []
        cur = df
        while cur <= dt_:
            all_days.append(cur.strftime('%Y-%m-%d'))
            cur += timedelta(days=1)

        today = date.today().strftime('%Y-%m-%d')
        holidays = data['holidays']
        team_ids = _team_filter_emp_ids(data, team_filter)
        dept_ids = None
        if dept_filter:
            dept_ids = {e['id'] for e in data['employees']
                        if e.get('department_id') == dept_filter}

        def emp_ok(eid):
            if team_ids is not None and eid not in team_ids:
                return False
            if dept_ids is not None and eid not in dept_ids:
                return False
            if not perms.get('block.summary.other_employees'):
                my_emp = u.get('employee_id') or ''
                if not my_emp or eid != my_emp:
                    return False
            return True

        # PATCH 1.0.5: не учитываем отметки на будущее, если включён флаг
        try:
            _ifu = str(db.get_setting('stats_ignore_future', '1')) != '0'
        except Exception:
            _ifu = True

        pairs = {}
        for l in data['log']:
            ldate = l.get('date', '')
            if ldate < date_from or ldate > date_to:
                continue
            if _ifu and ldate > today:
                continue
            eid = l.get('employee_id')
            tid = l.get('task_id')
            if emp_filter and eid != emp_filter:
                continue
            if not emp_ok(eid):
                continue
            if task_filter and tid != task_filter:
                continue
            pairs.setdefault((eid, tid), {}).setdefault(ldate, []).append(l)

        assigned = set()
        for t in data['tasks']:
            if task_filter and t['id'] != task_filter:
                continue
            if dept_filter and not _task_matches_dept(t, dept_filter, dept_ids or set()):
                continue
            if not _task_in_period(t, date_from, date_to, today):
                continue
            for eid in t.get('assignees', []):
                if emp_filter and eid != emp_filter:
                    continue
                if not emp_ok(eid):
                    continue
                assigned.add((eid, t['id']))

        all_pairs = set(pairs.keys()) | assigned
        by_emp = {}
        for (eid, tid) in all_pairs:
            by_emp.setdefault(eid, set()).add(tid)

        em = {e['id']: e for e in data['employees']}
        tm = {t['id']: t for t in data['tasks']}
        priority = {'done': 4, 'in_progress': 3, 'blocked': 2, 'planned': 1}

        rows = []
        for eid, tids in by_emp.items():
            emp = em.get(eid) or {'id': eid, 'name': '— удалён —', 'color': '#888'}
            cells = {} if mode != 'grid' else None
            tasks_rows = [] if mode == 'grid' else None
            total = 0.0
            for tid in sorted(tids):
                t = tm.get(tid) or {'id': tid, 'name': '— удалена —', 'icon': '❓'}
                day_entries = pairs.get((eid, tid), {})
                t_cells = {}
                t_total = 0.0
                for dk in all_days:
                    entries = day_entries.get(dk, [])
                    if not entries:
                        continue
                    h = sum(float(e.get('hours', 0) or 0) for e in entries)
                    statuses = [e.get('status', 'done') for e in entries]
                    dom = max(statuses, key=lambda s: priority.get(s, 0))
                    t_cells[dk] = {
                        'hours': round(h * 4) / 4,
                        'status': dom,
                        'status_label': STATUS_LABELS.get(dom, ''),
                        'entries': [{
                            'id': e.get('id'),
                            'comment': e.get('comment', ''),
                            'status': e.get('status', 'done'),
                            'status_label': STATUS_LABELS.get(e.get('status', 'done'), ''),
                            'link': e.get('link', ''),
                            'hours': float(e.get('hours', 0) or 0),
                        } for e in entries],
                    }
                    t_total += h
                if mode == 'grid':
                    emp_ck = _emp_completion_kind(t, data['log'], eid)
                    tasks_rows.append({
                        'task_id': tid, 'task_name': t.get('name', ''),
                        'task_icon': t.get('icon', '📋'),
                        'task_tags': list(t.get('tags') or []),
                        'task_status': t.get('status', 'active'),
                        'start_date': t.get('start_date', ''),
                        'deadline': t.get('deadline', ''),
                        'completed_at': t.get('completed_at', ''),
                        'emp_completed_at': _emp_last_done_date(data['log'], eid, tid),
                        'completion_kind': emp_ck or _completion_kind(t),
                        'emp_completion_kind': emp_ck,
                        'overdue': _emp_is_overdue(t, data['log'], eid, today),
                        'cells': t_cells,
                        'total_hours': round(t_total * 4) / 4,
                    })
                else:
                    for dk, c in t_cells.items():
                        cell = cells.setdefault(dk, {
                            'date': dk, 'hours': 0.0, 'tasks': []
                        })
                        cell['hours'] += c['hours']
                        cell['tasks'].append({
                            'task_id': tid, 'task_name': t.get('name', ''),
                            'task_icon': t.get('icon', '📋'),
                            'task_tags': list(t.get('tags') or []),
                            'task_status': t.get('status', 'active'),
                            'deadline': t.get('deadline', ''),
                            'overdue': _emp_is_overdue(t, data['log'], eid, today),
                            'hours': c['hours'],
                            'entries': c['entries'],
                        })
                total += t_total

            if mode == 'grid':
                tasks_rows.sort(key=lambda x: (-x['total_hours'], x['task_name'].lower()))
                rows.append({
                    'employee_id': eid,
                    'employee_name': emp.get('name', ''),
                    'employee_color': emp.get('color', '#888'),
                    'employee_department': emp.get('department', ''),
                    'tasks': tasks_rows,
                    'total_hours': round(total * 4) / 4,
                })
            else:
                for dk in cells:
                    cells[dk]['hours'] = round(cells[dk]['hours'] * 4) / 4
                    cells[dk]['tasks'].sort(key=lambda x: -x['hours'])
                rows.append({
                    'employee_id': eid,
                    'employee_name': emp.get('name', ''),
                    'employee_color': emp.get('color', '#888'),
                    'employee_department': emp.get('department', ''),
                    'cells': cells,
                    'total_hours': round(total * 4) / 4,
                })
        _emp_order_map = {e['id']: i for i, e in enumerate(data['employees'])}
        rows.sort(key=lambda r: _emp_order_map.get(r['employee_id'], 999999))

        absences_by_day = {}
        for e in data['employees']:
            if not emp_ok(e['id']):
                continue
            for v in e.get('vacations', []) or []:
                vf, vt = v.get('from', ''), v.get('to', '')
                if not vf or not vt:
                    continue
                s = max(vf, date_from)
                ee = min(vt, date_to)
                if s > ee:
                    continue
                cur_v = datetime.strptime(s, '%Y-%m-%d').date()
                end_v = datetime.strptime(ee, '%Y-%m-%d').date()
                while cur_v <= end_v:
                    absences_by_day.setdefault(e['id'], {})[
                        cur_v.strftime('%Y-%m-%d')
                    ] = v.get('type', 'vacation')
                    cur_v += timedelta(days=1)
        for r in rows:
            r['absence_days'] = absences_by_day.get(r['employee_id'], {})
            r['vacation_days'] = sorted(r['absence_days'].keys())

        day_totals = {dk: 0.0 for dk in all_days}
        for r in rows:
            if mode == 'grid':
                for t in r['tasks']:
                    for dk, c in t['cells'].items():
                        if dk in day_totals:
                            day_totals[dk] += c['hours']
            else:
                for dk, cell in r['cells'].items():
                    if dk in day_totals:
                        day_totals[dk] += cell['hours']
        for dk in day_totals:
            day_totals[dk] = round(day_totals[dk] * 4) / 4
        grand_total = round(sum(day_totals.values()) * 4) / 4

        for r in rows:
            if mode == 'grid':
                r['tasks'].sort(key=lambda x: (
                    (x['task_tags'][0] if x.get('task_tags') else 'zzz'),
                    -x['total_hours'],
                    x['task_name'].lower(),
                ))

        task_agg = {}
        for r in rows:
            if mode == 'grid':
                for t in r['tasks']:
                    tid = t['task_id']
                    if tid not in task_agg:
                        task_agg[tid] = {
                            'task_id': tid, 'task_name': t['task_name'],
                            'task_icon': t['task_icon'], 'hours': 0.0, 'count': 0,
                        }
                    task_agg[tid]['hours'] += t['total_hours']
                    for dk, c in t['cells'].items():
                        task_agg[tid]['count'] += len(c['entries'])
            else:
                for cell in r['cells'].values():
                    for t in cell['tasks']:
                        tid = t['task_id']
                        if tid not in task_agg:
                            task_agg[tid] = {
                                'task_id': tid, 'task_name': t['task_name'],
                                'task_icon': t['task_icon'], 'hours': 0.0, 'count': 0,
                            }
                        task_agg[tid]['hours'] += t['hours']
                        task_agg[tid]['count'] += len(t['entries'])
        top_tasks = sorted(task_agg.values(), key=lambda x: -x['hours'])[:10]
        for t in top_tasks:
            t['hours'] = round(t['hours'] * 4) / 4

        vacations_in_period = []
        for e in data['employees']:
            if not emp_ok(e['id']):
                continue
            for v in e.get('vacations', []) or []:
                vf, vt = v.get('from', ''), v.get('to', '')
                if vt < date_from or vf > date_to:
                    continue
                vacations_in_period.append({
                    'employee_id': e['id'],
                    'employee_name': e.get('name', ''),
                    'employee_color': e.get('color', '#888'),
                    'from': vf, 'to': vt,
                    'type': v.get('type', 'vacation'),
                    'type_label': ABSENCE_TYPES.get(v.get('type', 'vacation'), ''),
                    'comment': v.get('comment', ''),
                })

        return jsonify({
            'success': True, 'from': date_from, 'to': date_to,
            'view': 'grid' if mode == 'grid' else request.args.get('view', 'compact'),
            'days': all_days, 'rows': rows,
            'day_totals': day_totals, 'grand_total': grand_total,
            'top_tasks': top_tasks, 'vacations': vacations_in_period,
            'day_meta': _day_meta(all_days, holidays, today),
            'absence_types': ABSENCE_TYPES,
        })

