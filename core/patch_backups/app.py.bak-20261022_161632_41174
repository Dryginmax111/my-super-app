def _is_active_on(emp, dk):
    if not emp:
        return False
    # PATCH v1.0.3: учитываем дату выхода на работу — до неё сотрудник неактивен
    hired = (emp.get('hired_date') or '').strip()
    if hired and dk < hired:
        return False
    if emp.get('fired') and emp.get('fired_date'):
        return dk < emp['fired_date']
    return True


def _is_dept_head(emp):
    if not emp:
        return False
    role = (emp.get('role') or '').strip().lower()
    if not role:
        return False
    return any(m in role for m in EXEMPT_ROLES_MARKERS)


def _is_overdue(task, today):
    if not task:
        return False
    dl = task.get('deadline', '')
    st = task.get('status', 'active')
    return bool(dl) and dl < today and st not in ('done', 'archived')


def _completion_kind(task):
    if not task:
        return ''
    if task.get('status') not in ('done', 'archived'):
        return ''
    ca = (task.get('completed_at') or '')[:10]
    dl = task.get('deadline') or ''
    if not ca or not dl:
        return ''
    return 'early' if ca < dl else ('late' if ca > dl else 'on_time')


# Кэш: id(list) -> { (emp_id,task_id): 'YYYY-MM-DD' }
_LAST_DONE_CACHE = {}


def _last_done_map(logs):
    """Один проход по logs -> dict {(emp_id,task_id): max_date}.
    Кэш по id() списка: в рамках одного запроса data['log'] — один и тот же объект."""
    key = id(logs)
    hit = _LAST_DONE_CACHE.get(key)
    if hit is not None and hit[0] is logs:
        return hit[1]
    m = {}
    for l in logs:
        if l.get('status') != 'done':
            continue
        eid = l.get('employee_id')
        tid = l.get('task_id')
        d = l.get('date') or ''
        if not eid or not tid or not d:
            continue
        k = (eid, tid)
        prev = m.get(k)
        if prev is None or d > prev:
            m[k] = d
    if len(_LAST_DONE_CACHE) > 8:
        _LAST_DONE_CACHE.clear()
    _LAST_DONE_CACHE[key] = (logs, m)
    return m


def _emp_last_done_date(logs, emp_id, task_id):
    return _last_done_map(logs).get((emp_id, task_id), '')


def _emp_closed_task(logs, emp_id, task_id):
    return bool(_emp_last_done_date(logs, emp_id, task_id))


def _emp_completion_kind(task, logs, emp_id):
    if not task:
        return ''
    ca = _emp_last_done_date(logs, emp_id, task['id'])
    dl = task.get('deadline') or ''
    if not ca or not dl:
        return ''
    return 'early' if ca < dl else ('late' if ca > dl else 'on_time')


def _emp_days_delta(task, logs, emp_id):
    if not task:
        return None
    ca = _emp_last_done_date(logs, emp_id, task['id'])
    dl = task.get('deadline') or ''
    if not ca or not dl:
        return None
    try:
        return (datetime.strptime(ca, '%Y-%m-%d').date()
                - datetime.strptime(dl, '%Y-%m-%d').date()).days
    except Exception:
        return None


def _emp_is_overdue(task, logs, emp_id, today):
    if not task:
        return False
    st = task.get('status', 'active')
    if st in ('archived', 'done'):
        return False
    dl = task.get('deadline') or ''
    if not dl or dl >= today:
        return False
    if _emp_closed_task(logs, emp_id, task['id']):
        return False
    return True


def _emp_done_task(task, logs, emp_id):
    if not task:
        return False
    if task.get('status') in ('done', 'archived'):
        return True
    return _emp_closed_task(logs, emp_id, task['id'])


def _task_matches_dept(task, dept_id, dept_emp_ids):
    if not dept_id:
        return True
    if dept_id in (task.get('department_ids') or []):
        return True
    if not task.get('department_ids'):
        for a in task.get('assignees', []) or []:
            if a in dept_emp_ids:
                return True
    return False


def _task_in_period(task, date_from, date_to, today):
    if not task:
        return False
    if _is_overdue(task, today):
        return True
    start = task.get('start_date') or '1900-01-01'
    end = task.get('deadline') or today
    if not _valid_date(start):
        start = '1900-01-01'
    if not _valid_date(end):
        end = today
    return (start <= date_to) and (end >= date_from)


def _calc_coverage(task, emp, logs, today_d):
    if not task:
        return 0, 0, 0
    ts = None
    for src in (task.get('start_date'), (task.get('created_at') or '')[:10]):
        if src and _valid_date(src):
            try:
                ts = datetime.strptime(src, '%Y-%m-%d').date()
                break
            except Exception:
                pass
    if ts is None:
        ts = today_d
    te = None
    if task.get('deadline') and _valid_date(task['deadline']):
        try:
            te = datetime.strptime(task['deadline'], '%Y-%m-%d').date()
        except Exception:
            te = None
    if te is None:
        te = today_d
    if te > today_d:
        te = today_d
    if emp and emp.get('fired') and emp.get('fired_date') and _valid_date(emp['fired_date']):
        fd = datetime.strptime(emp['fired_date'], '%Y-%m-%d').date()
        if fd < te:
            te = fd
    if ts > te:
        return 0, 0, 0
    active_dates = set()
    for l in logs:
        dk = l.get('date', '')
        try:
            h = float(l.get('hours', 0) or 0)
        except Exception:
            h = 0
        if h > 0 and _valid_date(dk):
            active_dates.add(dk)
    possible = 0
    cur = ts
    while cur <= te:
        if cur.weekday() in WORK_WEEKDAYS:
            dk = cur.strftime('%Y-%m-%d')
            if (emp is None or not _in_vacation(emp, dk)) and \
               (emp is None or _is_active_on(emp, dk)):
                possible += 1
        cur += timedelta(days=1)
    cov = round(100 * len(active_dates) / possible) if possible else 0
    return len(active_dates), possible, cov


def _day_meta(all_days, holidays_map, today):
    out = {}
    for dk in all_days:
        try:
            wd = datetime.strptime(dk, '%Y-%m-%d').weekday()
        except Exception:
            wd = 0
        is_wknd = wd >= 5
        is_hol = dk in holidays_map
        out[dk] = {
            'date': dk, 'weekday': wd,
            'is_weekend': is_wknd, 'is_holiday': bool(is_hol),
            'holiday_name': holidays_map.get(dk, ''),
            'is_today': dk == today,
            'is_workday': not (is_wknd or is_hol),
        }
    return out


def _team_filter_emp_ids(data, team_id):
    if not team_id:
        return None
    tm = next((x for x in (data.get('teams') or []) if x.get('id') == team_id), None)
    if tm is None:
        return set()
    s = set()
    if tm.get('manager_id'):
        s.add(tm['manager_id'])
    for m in tm.get('member_ids') or []:
        if m:
            s.add(m)
    return s


def _actor_is_manager_of(db, actor_user, employee_id):
    """True если actor — manager команды сотрудника, head его отдела или admin."""
    if not actor_user or not employee_id:
        return False
    if (actor_user.get('role') or '') == 'admin':
        return True
    actor_eid = (actor_user.get('employee_id') or '').strip()
    if not actor_eid:
        return False
    try:
        emp = db.query_one('SELECT department_id FROM employees WHERE id=?', (employee_id,))
        dept_id = (emp or {}).get('department_id') or ''
        if dept_id:
            dept = db.query_one('SELECT head_employee_id FROM departments WHERE id=?', (dept_id,))
            if ((dept or {}).get('head_employee_id') or '') == actor_eid:
                return True
        for r in db.query('SELECT id, manager_id FROM teams'):
            mgr = (r.get('manager_id') or '').strip()
            if mgr != actor_eid:
                continue
            if mgr == employee_id:
                return True
            m = db.query_one(
                'SELECT 1 FROM team_members WHERE team_id=? AND employee_id=? LIMIT 1',
                (r['id'], employee_id),
            )
            if m:
                return True
    except Exception as e:
        print(f'[notify] actor_is_manager failed: {e}')
    return False


def _find_notification_recipients(db, employee_id, exclude_user_id=None, actor_user=None, event_kind='task_done'):
    """Вертикаль вверх: manager команды + head отдела.
    Admin — только fallback, если вертикали нет."""
    recipients = set()
    vertical = set()
    try:
        actor_eid = ((actor_user or {}).get('employee_id') or '').strip()
        actor_is_admin = ((actor_user or {}).get('role') or '') == 'admin'
        emp = db.query_one('SELECT department_id FROM employees WHERE id=?', (employee_id,))
        dept_id = (emp or {}).get('department_id') or ''
        head_eid = ''
        if dept_id:
            dept = db.query_one('SELECT head_employee_id FROM departments WHERE id=?', (dept_id,))
            head_eid = (dept or {}).get('head_employee_id') or ''
            if head_eid and head_eid != actor_eid:
                hu = db.query_one('SELECT id FROM users WHERE employee_id=? AND is_active=1', (head_eid,))
                if hu:
                    vertical.add(hu['id'])
        for r in db.query('SELECT id, manager_id FROM teams'):
            mgr = (r.get('manager_id') or '').strip()
            if not mgr or mgr == actor_eid:
                continue
            is_member = False
            if mgr == employee_id:
                is_member = True
            else:
                m = db.query_one(
                    'SELECT 1 FROM team_members WHERE team_id=? AND employee_id=? LIMIT 1',
                    (r['id'], employee_id),
                )
                is_member = bool(m)
            if not is_member:
                continue
            mu = db.query_one('SELECT id FROM users WHERE employee_id=? AND is_active=1', (mgr,))
            if mu:
                vertical.add(mu['id'])
        actor_is_boss = _actor_is_manager_of(db, actor_user, employee_id) if actor_user else False
        if actor_is_boss:
            recipients |= vertical
            if actor_is_admin or (actor_eid and actor_eid == head_eid):
                for u in db.query("SELECT id FROM users WHERE role='admin' AND is_active=1"):
                    recipients.add(u['id'])
        else:
            recipients |= vertical
            if not recipients:
                for u in db.query("SELECT id FROM users WHERE role='admin' AND is_active=1"):
                    recipients.add(u['id'])
    except Exception as e:
        print(f'[notify] recipients failed: {e}')
    if exclude_user_id is not None:
        recipients.discard(exclude_user_id)
    return list(recipients)


def _notif_dedup(db, kind, task_id, employee_id, hours=24):
    try:
        row = db.query_one(
            'SELECT id FROM notifications WHERE kind=? AND task_id=? AND employee_id=? '
            "AND ts >= datetime('now', ?) ORDER BY id DESC LIMIT 1",
            (kind, task_id or '', employee_id or '', f'-{int(hours)} hours'),
        )
        return bool(row)
    except Exception:
        return False


def _notify_task_done(db, task_id, employee_id, from_user):
    try:
        from_uid = (from_user or {}).get('id')
        is_boss = _actor_is_manager_of(db, from_user, employee_id)
        recipients = _find_notification_recipients(
            db, employee_id, exclude_user_id=from_uid,
            actor_user=from_user, event_kind='task_done',
        )
        if not recipients:
            return
        if _notif_dedup(db, 'task_done', task_id, employee_id):
            return
        emp = db.query_one('SELECT name FROM employees WHERE id=?', (employee_id,))
        emp_name = (emp or {}).get('name', employee_id)
        t = db.query_one('SELECT name, icon FROM tasks WHERE id=?', (task_id,))
        task_name = (t or {}).get('name', task_id)
        task_icon = (t or {}).get('icon', '📋')
        if is_boss:
            msg = f'{task_icon} {emp_name}: задача закрыта руководителем — {task_name}'
        else:
            msg = f'{task_icon} {emp_name} закрыл задачу: {task_name}'
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        init_status = 'info' if is_boss else 'new'
        with db.transaction() as tx:
            for uid in recipients:
                tx.exec(
                    'INSERT INTO notifications (ts, to_user_id, from_user_id, from_username, kind, task_id, employee_id, message, status) '
                    'VALUES (?,?,?,?,?,?,?,?,?)',
                    (now, uid, from_uid, (from_user or {}).get('username', ''),
                     'task_done', task_id, employee_id, msg, init_status),
                )
    except Exception as e:
        print(f'[notify] task_done failed: {e}')


def _notify_task_created(db, task_id, from_user):
    """Уведомление по вертикали о создании задачи (без confirm)."""
    try:
        from_uid = (from_user or {}).get('id')
        actor_eid = (from_user or {}).get('employee_id') or ''
        t = db.query_one('SELECT name, icon FROM tasks WHERE id=?', (task_id,))
        if not t:
            return
        assignees = []
        try:
            for r in db.query('SELECT employee_id FROM task_assignees WHERE task_id=?', (task_id,)):
                if r.get('employee_id'):
                    assignees.append(r['employee_id'])
        except Exception:
            pass
        anchor_eid = actor_eid or (assignees[0] if assignees else '')
        if not anchor_eid:
            recipients = set()
            for u in db.query("SELECT id FROM users WHERE role='admin' AND is_active=1"):
                recipients.add(u['id'])
            if from_uid is not None:
                recipients.discard(from_uid)
        else:
            recipients = set(_find_notification_recipients(
                db, anchor_eid, exclude_user_id=from_uid,
                actor_user=from_user, event_kind='task_created',
            ))
        if not recipients:
            return
        if _notif_dedup(db, 'task_created', task_id, anchor_eid or ''):
            return
        who = (from_user or {}).get('display_name') or (from_user or {}).get('username') or 'пользователь'
        if actor_eid:
            emp = db.query_one('SELECT name FROM employees WHERE id=?', (actor_eid,))
            if emp and emp.get('name'):
                who = emp['name']
        task_name = t.get('name', task_id)
        task_icon = t.get('icon', '📋')
        msg = f'{task_icon} {who} создал задачу: {task_name}'
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        with db.transaction() as tx:
            for uid in recipients:
                tx.exec(
                    'INSERT INTO notifications (ts, to_user_id, from_user_id, from_username, kind, task_id, employee_id, message, status) '
                    'VALUES (?,?,?,?,?,?,?,?,?)',
                    (now, uid, from_uid, (from_user or {}).get('username', ''),
                     'task_created', task_id, anchor_eid or '', msg, 'info'),
                )
    except Exception as e:
        print(f'[notify] task_created failed: {e}')


