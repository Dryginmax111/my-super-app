    @app.route('/api/tracker/log/save', methods=['POST'])
    @login_required
    def api_log_save():
        body = request.get_json() or {}
        try:
            _dbg_path = Path(__file__).parent / 'trk_debug.log'
            with _dbg_path.open('a', encoding='utf-8') as _dbgf:
                _dbgf.write(f'{datetime.now().strftime("%H:%M:%S")} log_save task={body.get("task_id")} emp={body.get("employee_id")} id={body.get("id")} comment_len={len(str(body.get("comment") or ""))} merge={body.get("merge_into_task")}' + chr(10))
        except Exception:
            pass
        log_id_raw = body.get('id')
        employee_id = str(body.get('employee_id', '')).strip()
        task_id = str(body.get('task_id', '')).strip()
        date_str = str(body.get('date', '')).strip()
        comment = str(body.get('comment', '')).strip()[:2000]
        status = str(body.get('status', 'in_progress')).strip()[:20]
        link = str(body.get('link', '')).strip()[:500]
        # PATCH v1.0.4: описание + multi-поля
        _desc_from_body = str(body.get('description', '') or '').strip()[:2000]
        if _desc_from_body:
            comment = _desc_from_body
        _extra_raw = body.get('extra_data') or []
        if not isinstance(_extra_raw, list):
            _extra_raw = []
        extra_data = [str(x).strip()[:500] for x in _extra_raw if str(x or '').strip()][:30]
        _orders_raw = body.get('orders') or []
        if not isinstance(_orders_raw, list):
            _orders_raw = []
        orders = []
        for _o in _orders_raw[:30]:
            if not isinstance(_o, dict):
                continue
            _v = str(_o.get('value') or '').strip()[:1000]
            if not _v:
                continue
            orders.append({
                'description': str(_o.get('description') or '').strip()[:200],
                'value': _v,
            })
        _links_raw = body.get('links') or []
        if not isinstance(_links_raw, list):
            _links_raw = []
        links = []
        for _l in _links_raw[:30]:
            if not isinstance(_l, dict):
                continue
            _u = str(_l.get('url') or '').strip()[:1000]
            if not _u:
                continue
            links.append({
                'description': str(_l.get('description') or '').strip()[:200],
                'url': _u,
            })
        try:
            hours = float(body.get('hours', 0) or 0)
        except (ValueError, TypeError):
            hours = 0
        hours = max(0.0, min(24.0, hours))
        hours = round(hours * 4) / 4

        _is_create = not log_id_raw
        # PATCH v1.0.6: минимум 30 минут работает и при редактировании
        if hours < 0.5:
            return jsonify({'success': False, 'error': 'Минимум 30 минут (0.5 ч)'}), 400
        # PATCH v1.0.19: запрет дубля отметки за день
        if _is_create and employee_id and task_id and _valid_date(date_str):
            _dup_row = db.query_one(
                'SELECT id, hours, comment FROM work_logs WHERE employee_id=? AND task_id=? AND date=? ORDER BY id DESC LIMIT 1',
                (employee_id, task_id, date_str),
            )
            if _dup_row:
                _emp_obj = db.query_one('SELECT name FROM employees WHERE id=?', (employee_id,))
                _tsk_obj = db.query_one('SELECT name FROM tasks WHERE id=?', (task_id,))
                return jsonify({
                    'success': False,
                    'error': 'already_logged_today',
                    'existing_id': _dup_row['id'],
                    'existing_hours': float(_dup_row.get('hours') or 0),
                    'employee_name': (_emp_obj or {}).get('name', employee_id),
                    'task_name': (_tsk_obj or {}).get('name', task_id),
                    'date': date_str,
                    'message': 'У этого сотрудника уже есть отметка за этот день по этой задаче',
                }), 409
        if not employee_id:
            return jsonify({'success': False, 'error': 'Выберите сотрудника'}), 400
        if not task_id:
            return jsonify({'success': False, 'error': 'Выберите задачу'}), 400
        if not _valid_date(date_str):
            return jsonify({'success': False, 'error': 'Некорректная дата'}), 400
        if not db.query_one('SELECT id FROM employees WHERE id=?', (employee_id,)):
            return jsonify({'success': False, 'error': 'Сотрудник не найден'}), 400
        if not db.query_one('SELECT id FROM tasks WHERE id=?', (task_id,)):
            return jsonify({'success': False, 'error': 'Задача не найдена'}), 400
        if status not in STATUS_LABELS:
            status = 'in_progress'

        u = current_user(db)
        now_merge = datetime.now().strftime('%Y-%m-%d %H:%M')
        if not log_id_raw:
            _existing_merge = db.query_one(
                'SELECT * FROM work_logs WHERE employee_id=? AND task_id=? AND date=? ORDER BY id DESC LIMIT 1',
                (employee_id, task_id, date_str)
            )
            if _existing_merge:
                _old_c = (_existing_merge.get('comment') or '').strip()
                _old_l = (_existing_merge.get('link') or '').strip()
                _old_h = float(_existing_merge.get('hours') or 0)
                _parts_c = []
                if _old_c:
                    _parts_c.append(_old_c)
                if comment:
                    _parts_c.append('[' + now_merge + '] ' + comment)
                _merged_c = '\n'.join(_parts_c)[:2000]
                _parts_l = []
                if _old_l:
                    _parts_l.append(_old_l)
                if link and link != _old_l:
                    _parts_l.append('[' + now_merge + '] ' + link)
                _merged_l = '\n'.join(_parts_l)[:500]
                _total_h = round((_old_h + hours) * 4) / 4
                if _total_h > 24:
                    _total_h = 24.0
                log_id_raw = _existing_merge['id']
                comment = _merged_c
                link = _merged_l
                hours = _total_h
        if log_id_raw:
            existing = db.query_one('SELECT * FROM work_logs WHERE id=?', (log_id_raw,))
            if not existing:
                return jsonify({'success': False, 'error': 'Отметка не найдена'}), 404
            own = (existing['employee_id'] == (u.get('employee_id') or ''))
            if own:
                if not (user_has(db, u, 'action.log.edit.own')
                        or user_has(db, u, 'action.log.edit.any')):
                    return jsonify({'success': False, 'error': 'forbidden'}), 403
            else:
                if not user_has(db, u, 'action.log.edit.any'):
                    return jsonify({'success': False, 'error': 'forbidden'}), 403
        else:
            if not user_has(db, u, 'action.log.create'):
                return jsonify({'success': False, 'error': 'forbidden'}), 403
            if not user_has(db, u, 'action.log.edit.any'):
                my_emp = u.get('employee_id') or ''
                if not my_emp or employee_id != my_emp:
                    return jsonify({
                        'success': False,
                        'error': 'Можно вносить отметки только за себя'
                    }), 403

        # PATCH v1.0.6: проверка 8 часов работает и при редактировании.
        # Редактируемая отметка исключается из суммы, чтобы не считать её дважды.
        if hours > 0:
            _existing = db.query(
                'SELECT id, task_id, hours FROM work_logs WHERE employee_id=? AND date=?',
                (employee_id, date_str)
            )
            if log_id_raw:
                _cur_id = int(log_id_raw)
                _existing = [r for r in _existing if r['id'] != _cur_id]
            _sum_existing = sum(float(r.get('hours') or 0) for r in _existing)
            if _sum_existing + hours > 8 + 1e-6:
                _action = str(body.get('overflow_action') or '').strip()
                if _action == 'accept':
                    pass
                elif _action == 'distribute':
                    _existing_pos = [r for r in _existing if float(r.get('hours') or 0) > 0]
                    _all_hours = [float(r.get('hours') or 0) for r in _existing_pos] + [hours]
                    _n = len(_all_hours)
                    if _n >= 1:
                        _target = round((8.0 / _n) * 4) / 4
                        if _target < 0.5:
                            _target = 0.5
                        _last_val = round((8.0 - _target * (_n - 1)) * 4) / 4
                        if _last_val < 0.5:
                            _last_val = 0.5
                        _new_vals = [_target] * (_n - 1) + [_last_val]
                        _existing_sorted = sorted(_existing_pos, key=lambda r: (r.get('id') or 0))
                        _idx = 0
                        _update_pairs = []
                        for _r in _existing_sorted:
                            _update_pairs.append((_new_vals[_idx], _r['id']))
                            _idx += 1
                        hours = _new_vals[_idx] if _idx < len(_new_vals) else _target
                        with db.transaction() as _tx:
                            for _h, _lid in _update_pairs:
                                _tx.exec('UPDATE work_logs SET hours=? WHERE id=?', (_h, _lid))
                else:
                    return jsonify({
                        'success': False,
                        'error': 'daily_overflow',
                        'sum_existing': round(_sum_existing * 4) / 4,
                        'new_hours': hours,
                        'total': round((_sum_existing + hours) * 4) / 4,
                        'message': 'Превышение 8 часов за день',
                    }), 409
        # PATCH v1.0.4: сериализация multi-полей
        _extra_json = json.dumps(extra_data, ensure_ascii=False) if extra_data else '[]'
        _orders_json = json.dumps(orders, ensure_ascii=False) if orders else '[]'
        _links_json = json.dumps(links, ensure_ascii=False) if links else '[]'
        created = db.upsert_log(
            int(log_id_raw) if log_id_raw else None,
            {
                'employee_id': employee_id, 'task_id': task_id, 'date': date_str,
                'hours': hours, 'comment': comment, 'status': status, 'link': link,
                'extra_data_json': _extra_json,
                'orders_json': _orders_json,
                'links_json': _links_json,
            }
        )
        _audit(db, u, 'create' if created else 'update', 'log', log_id_raw or created,
               {'employee_id': employee_id, 'task_id': task_id,
                'date': date_str, 'hours': hours, 'status': status})
        try:
            app.config['PLUGIN_REGISTRY'].emit('on_log_save', user=u,
                                                log_id=created, created=created)
        except Exception:
            pass
        # PATCH v1.0.9: при любом сохранении лога к задаче проверяем
        # (а) все ли закрыли — если да, автозакрываем;
        # (б) не откатил ли кто-то auto-закрытую задачу назад.
        if task_id:
            try:
                _autoclose_if_all_done(db, task_id, u)
            except Exception as _e:
                print(f'[autoclose] hook failed: {_e}')
            try:
                _try_reopen_if_stale_autoclose(db, task_id, u)
            except Exception as _e:
                print(f'[reopen] hook failed: {_e}')
        # PATCH v1.0.20: уведомляем админов/руководителей о закрытии
        if status == 'done' and task_id and created:
            try:
                _notify_task_done(db, task_id, employee_id, u)
            except Exception as _e:
                print(f'[notify] hook failed: {_e}')
        # PATCH v1.0.4 + v1.0.15: при создании или правке отметки — пушим данные в задачу
        _merge_into_task = bool(body.get('merge_into_task'))
        _merge_info = None
        # PATCH v1.0.19: при обновлении отметки тоже сливаем (построчно),
        # чтобы добавленные строки описания/приказов/ссылок попадали в задачу.
        if task_id:
            try:
                _merge_info = _merge_log_data_into_task(
                    db, task_id, employee_id, u,
                    description=comment,
                    extra_data=extra_data,
                    orders=orders,
                    links=links,
                )
            except Exception as _e:
                print(f'[merge_log] failed: {_e}')
        _resp = {'success': True, 'created': created}
        if _merge_info:
            _resp['merge_info'] = _merge_info
        return jsonify(_resp)

