    @app.route('/api/tracker/task/merge', methods=['POST'])
    @login_required
    @permission_required('action.task.edit')
    def api_task_merge():
        body = request.get_json() or {}
        task_ids = body.get('task_ids') or []
        if not isinstance(task_ids, list) or len(task_ids) < 2:
            return jsonify({'success': False, 'error': 'Нужно минимум 2 задачи'}), 400
        task_ids = [str(t).strip() for t in task_ids if str(t).strip()]
        data = _data(db)
        existing = {t['id'] for t in data['tasks']}
        task_ids = [t for t in task_ids if t in existing]
        if len(task_ids) < 2:
            return jsonify({'success': False, 'error': 'Меньше двух существующих задач'}), 400
        survivor_id = str(body.get('survivor_id', '')).strip()
        if survivor_id not in task_ids:
            survivor_id = task_ids[0]
        merge_ids = [t for t in task_ids if t != survivor_id]
        keep = body.get('keep') or {}
        name = str(keep.get('name') or '').strip()[:200]
        icon = str(keep.get('icon') or '').strip()[:8] or '📋'
        description = str(keep.get('description') or '').strip()[:2000]
        status = str(keep.get('status') or 'active').strip()
        if status not in TASK_STATUS_LABELS:
            status = 'active'
        start_date = str(keep.get('start_date') or '').strip()[:20]
        deadline = str(keep.get('deadline') or '').strip()[:20]
        completed_at = str(keep.get('completed_at') or '').strip()[:20]
        _surv = next((t for t in data['tasks'] if t['id'] == survivor_id), {})
        name = (_surv.get('name') or '').strip() or 'Объединённая задача'
        icon = _surv.get('icon') or '📋'
        start_date = _surv.get('start_date') or ''
        deadline = _surv.get('deadline') or ''
        completed_at = _surv.get('completed_at') or ''
        status = _surv.get('status') or 'active'
        all_tags, all_assignees, all_deps = set(), set(), set()
        _descs, _folders, _orders = [], [], []
        _seen_desc, _seen_folder, _seen_order = set(), set(), set()
        for t in data['tasks']:
            if t['id'] in task_ids:
                for tag in (t.get('tags') or []): all_tags.add(tag)
                for a in (t.get('assignees') or []): all_assignees.add(a)
                for d in (t.get('department_ids') or []): all_deps.add(d)
                _d = (t.get('description') or '').strip()
                if _d and _d not in _seen_desc:
                    _seen_desc.add(_d)
                    _descs.append(_d)
                _f = (t.get('folder') or '').strip()
                if _f and _f not in _seen_folder:
                    _seen_folder.add(_f)
                    _folders.append(_f)
                _o = (t.get('order_ref') or '').strip()
                if _o and _o not in _seen_order:
                    _seen_order.add(_o)
                    _orders.append(_o)
        if _descs:
            description = '\n\n'.join(_descs)[:2000]
        _folder_merged = '\n'.join(_folders)[:2000]
        _order_merged = '\n'.join(_orders)[:1000]
        folder_field = _folder_merged
        order_ref_field = _order_merged
        if isinstance(body.get('tags'), list):
            all_tags = set(str(x).strip() for x in body['tags'] if str(x).strip())
        if isinstance(body.get('assignees'), list):
            all_assignees = set(str(x).strip() for x in body['assignees'] if str(x).strip())
        if isinstance(body.get('department_ids'), list):
            all_deps = set(str(x).strip() for x in body['department_ids'] if str(x).strip())
        valid_emps = {e['id'] for e in data['employees']}
        valid_deps = {d['id'] for d in data['departments']}
        all_assignees = all_assignees & valid_emps
        all_deps = all_deps & valid_deps
        try:
            with db.transaction() as tx:
                tx.exec(
                    'UPDATE tasks SET name=?, icon=?, description=?, status=?, '
                    'start_date=?, deadline=?, completed_at=?, folder=?, order_ref=? '
                    'WHERE id=?',
                    (name, icon, description, status, start_date, deadline, completed_at,
                     folder_field, order_ref_field, survivor_id))
                _ph = ','.join('?' * len(merge_ids))
                tx.exec('UPDATE work_logs SET task_id=? WHERE task_id IN (' + _ph + ')',
                        tuple([survivor_id] + merge_ids))
                tx.exec('DELETE FROM task_tags WHERE task_id=?', (survivor_id,))
                for tag in sorted(all_tags):
                    tx.exec('INSERT OR IGNORE INTO task_tags (task_id, tag) VALUES (?,?)', (survivor_id, tag))
                tx.exec('DELETE FROM task_assignees WHERE task_id=?', (survivor_id,))
                for a in sorted(all_assignees):
                    tx.exec('INSERT OR IGNORE INTO task_assignees (task_id, employee_id) VALUES (?,?)', (survivor_id, a))
                tx.exec('DELETE FROM task_departments WHERE task_id=?', (survivor_id,))
                for d in sorted(all_deps):
                    tx.exec('INSERT OR IGNORE INTO task_departments (task_id, department_id) VALUES (?,?)', (survivor_id, d))
                for mid in merge_ids:
                    tx.exec('DELETE FROM task_tags WHERE task_id=?', (mid,))
                    tx.exec('DELETE FROM task_assignees WHERE task_id=?', (mid,))
                    tx.exec('DELETE FROM task_departments WHERE task_id=?', (mid,))
                    tx.exec('DELETE FROM tasks WHERE id=?', (mid,))
        except Exception as e:
            traceback.print_exc()
            return jsonify({'success': False, 'error': f'merge failed: {e}'}), 500
        _audit(db, current_user(db), 'merge', 'task', survivor_id,
               {'merged_ids': merge_ids, 'name': name})
        return jsonify({'success': True, 'survivor_id': survivor_id, 'merged_ids': merge_ids})

