def _translit_username(name):
    out = []
    for ch in str(name or '').strip().lower():
        if ch.isascii() and ch.isalnum():
            out.append(ch)
        elif ch in _TRANSLIT:
            out.append(_TRANSLIT[ch])
        elif ch in (' ', '-', '_', '.'):
            out.append('_')
    s = ''.join(out).strip('_')
    return (s or 'user')[:32]


def _valid_date(s):
    try:
        datetime.strptime(str(s), '%Y-%m-%d')
        return True
    except Exception:
        return False


def _parse_ym(ym):
    try:
        y, m = ym.split('-')
        return int(y), int(m)
    except Exception:
        t = date.today()
        return t.year, t.month


def _slugify(name):
    s = str(name or '').strip().lower()
    out = []
    for ch in s:
        if ch.isascii() and ch.isalnum():
            out.append(ch)
        elif ch in (' ', '-', '_', '.'):
            out.append('_')
    return (''.join(out).strip('_') or 'item')[:40]


def _in_vacation(emp, dk):
    if not emp:
        return False
    for v in emp.get('vacations', []) or []:
        if v.get('type') == 'remote':
            continue
        f, t = v.get('from', ''), v.get('to', '')
        if f and t and f <= dk <= t:
            return True
    return False


def _is_remote(emp, dk):
    if not emp:
        return False
    for v in emp.get('vacations', []) or []:
        if v.get('type') != 'remote':
            continue
        f, t = v.get('from', ''), v.get('to', '')
        if f and t and f <= dk <= t:
            return True
    return False


def _absence_type(emp, dk):
    if not emp:
        return ''
    for v in emp.get('vacations', []) or []:
        f, t = v.get('from', ''), v.get('to', '')
        if f and t and f <= dk <= t:
            return v.get('type', 'vacation') or 'vacation'
