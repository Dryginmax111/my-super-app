    # ============================================================
    # API: TASKS
    # ============================================================
    @app.route('/api/tracker/task/save', methods=['POST'])
    @login_required
    def api_task_save():
        body = request.get_json() or {}
        task_id = str(body.get('id', '')).strip()
        name = str(body.get('name', '')).strip()[:200]
        icon = str(body.get('icon', '')).strip()[:8] or '📋'
        description = str(body.get('description', '')).strip()[:2000]
        status = str(body.get('status', 'active')).strip()[:20]
        deadline = str(body.get('deadline', '')).strip()[:20]
        start_date = str(body.get('start_date', '')).strip()[:20]
        completed_at = str(body.get('completed_at', '')).strip()[:20]
        folder = str(body.get('folder', '')).strip()[:2000]
        order_ref = str(body.get('order_ref', '')).strip()[:1000]
        # PATCH tasks-stages: тип задачи, карман, даты начала этапов
        from db import (TASK_TYPES as _TASK_TYPES,
                        TASK_STAGE_ORDER as _STAGE_ORDER)
        task_type = str(body.get('task_type', '')).strip()
        if task_type not in _TASK_TYPES:
            task_type = ''
        pocket = str(body.get('pocket', '')).strip()[:200]
        # PATCH tasks-lead: руководитель проверки (банк обязателен, сотрудник опц.)
        lead_department = str(body.get('lead_department', '')).strip()
        lead_employee = str(body.get('lead_employee', '')).strip()
        _stages_raw = body.get('stages') or {}
        if not isinstance(_stages_raw, dict):
            _stages_raw = {}
        stages = {}
        for _sk in _STAGE_ORDER:
            _sv = str(_stages_raw.get(_sk, '') or '').strip()[:20]
            if _sv and not _valid_date(_sv):
                _sv = ''
            stages[_sk] = _sv
        # PATCH v1.0.18: метка «очень срочная»
        is_urgent = bool(body.get('is_urgent', False))
        # PATCH v1.0.19: несколько ссылок с описанием
        _links_raw = body.get('links') or []
        if not isinstance(_links_raw, list):
            _links_raw = []
        links = []
        for _lk in _links_raw[:30]:
            if isinstance(_lk, str):
                _u = _lk.strip()
                _d = ''
            elif isinstance(_lk, dict):
                _u = str(_lk.get('url', '')).strip()
                _d = str(_lk.get('description', '')).strip()[:200]
            else:
                continue
            if not _u:
                continue
            links.append({'url': _u[:1000], 'description': _d})
        # PATCH v1.0.32: приказы/распоряжения как список {description, value}
        _orders_raw = body.get('orders') or []
        if not isinstance(_orders_raw, list):
            _orders_raw = []
        orders = []
        for _o in _orders_raw[:50]:
            if not isinstance(_o, dict):
                continue
            _od = str(_o.get('description', '')).strip()[:200]
            _ov = str(_o.get('value', '')).strip()[:1000]
            if not _ov and not _od:
                continue
            orders.append({'description': _od, 'value': _ov})
        if start_date and not _valid_date(start_date):
            start_date = ''
        if completed_at and not _valid_date(completed_at):
            completed_at = ''
        if deadline and not _valid_date(deadline):
            return jsonify({'success': False, 'error': 'Некорректный дедлайн'}), 400
        # PATCH v1.0.6: дата начала не может быть позже дедлайна
        if start_date and deadline and start_date > deadline:
            return jsonify({'success': False, 'error': 'Дата начала позже дедлайна'}), 400
        if status not in TASK_STATUS_LABELS:
            status = 'active'

        tags_raw = body.get('tags', [])
        if isinstance(tags_raw, str):
            tags = [t.strip() for t in tags_raw.split(',') if t.strip()][:20]
        elif isinstance(tags_raw, list):
            tags = [str(t).strip()[:40] for t in tags_raw if str(t).strip()][:20]
        else:
            tags = []
        clean_tags = []
        seen = set()
        for tag in tags:
            tag = tag.lstrip('#').replace(' ', '_').lower()
            if not tag or tag in seen:
                continue
            seen.add(tag)
            clean_tags.append(tag)
        tags = clean_tags[:20]

        assignees = body.get('assignees', [])
        if not isinstance(assignees, list):
            assignees = []
        assignees = [str(a).strip() for a in assignees if str(a).strip()]

        dep_ids_raw = body.get('department_ids', [])
        if isinstance(dep_ids_raw, str):
            dep_ids_raw = [dep_ids_raw.strip()] if dep_ids_raw.strip() else []
        if not isinstance(dep_ids_raw, list):
            dep_ids_raw = []
        dep_ids = [str(x).strip() for x in dep_ids_raw if str(x).strip()]

        if not name:
            return jsonify({'success': False, 'error': 'Название обязательно'}), 400

        u = current_user(db)
        need = 'action.task.edit' if task_id else 'action.task.create'
        if not user_has(db, u, need):
            return jsonify({'success': False, 'error': 'forbidden', 'need': need}), 403

        data = _data(db)
        valid_depts = {d['id'] for d in data['departments']}
        valid_emps = {e['id'] for e in data['employees']}
        dep_ids = [x for x in dep_ids if x in valid_depts]
        if dep_ids:
            allowed = {e['id'] for e in data['employees']
                       if e.get('department_id') in dep_ids}
            assignees = [a for a in assignees if a in allowed]
        else:
            assignees = [a for a in assignees if a in valid_emps]

        # PATCH tasks-lead: руководитель проверки.
        # Банк-руководитель обязателен и должен быть среди банков-участников.
        # Сотрудник-руководитель опционален; если задан — должен работать
        # в банке-руководителе.
        if not dep_ids:
            return jsonify({'success': False,
                            'error': 'Нужно выбрать минимум один банк-участник'}), 400
        if not lead_department:
            return jsonify({'success': False,
                            'error': 'Укажите банк-руководитель проверки'}), 400
        if lead_department not in dep_ids:
            return jsonify({'success': False,
                            'error': 'Банк-руководитель должен быть среди банков-участников'}), 400
        if lead_employee:
            _emp_by_id = {e['id']: e for e in data['employees']}
            _le = _emp_by_id.get(lead_employee)
            if not _le or _le.get('department_id') != lead_department:
                # Сотрудник не из банка-руководителя — не критично, просто сбрасываем
                lead_employee = ''

        # PATCH 19 — проверка дубликатов имён задач (только при создании)
        if not task_id:
            def _norm_name(s):
                import re as _re_n
                return _re_n.sub(r'\s+', ' ', str(s or '').strip().lower())
            def _lev(a, b):
                if a == b:
                    return 0
                la, lb = len(a), len(b)
                if la == 0:
                    return lb
                if lb == 0:
                    return la
                prev = list(range(lb + 1))
                for i in range(1, la + 1):
                    cur = [i] + [0] * lb
                    for j in range(1, lb + 1):
                        cost = 0 if a[i-1] == b[j-1] else 1
                        cur[j] = min(cur[j-1] + 1, prev[j] + 1, prev[j-1] + cost)
                    prev = cur
                return prev[lb]
            _force_dup = bool(body.get('force_duplicate'))
            _name_norm = _norm_name(name)
            _exact = None
            _similar = []
            try:
                for _t in db.query('SELECT id, name FROM tasks'):
                    _tn = _norm_name(_t.get('name') or '')
                    if not _tn:
                        continue
                    if _tn == _name_norm:
                        _exact = {'id': _t['id'], 'name': _t.get('name') or ''}
                        break
                    if len(_name_norm) >= 5 and len(_tn) >= 5:
                        if _tn in _name_norm or _name_norm in _tn:
                            _similar.append({'id': _t['id'], 'name': _t.get('name') or ''})
                        elif _lev(_name_norm, _tn) <= 2:
                            _similar.append({'id': _t['id'], 'name': _t.get('name') or ''})
            except Exception as _e:
                print(f'[task_save] dup check failed: {_e}')
            if (_exact or _similar) and not _force_dup:
                return jsonify({
                    'success': False,
                    'error': 'duplicate_name',
                    'exact': _exact,
                    'similar': _similar[:5],
                    'message': 'Задача с таким или похожим названием уже существует',
                }), 409
            if (_exact or _similar) and _force_dup:
                _audit(db, u, 'create', 'task', '', {
                    'name': name, 'force_duplicate': True,
                    'exact_match': _exact['id'] if _exact else '',
                    'similar_count': len(_similar),
                })
        # PATCH 23 — автоназначение: сотрудник, создающий задачу, добавляется в assignees
        if not task_id:
            try:
                _u_emp = (u.get('employee_id') or '').strip()
                _is_admin = (u.get('role') == 'admin')
                if _u_emp and not _is_admin and _u_emp not in assignees:
                    assignees.append(_u_emp)
                    print(f'[task_save] auto-assign {_u_emp} to new task')
            except Exception as _e:
                print(f'[task_save] auto-assign failed: {_e}')
        now_str = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        if not task_id:
            base = _slugify(name)
            task_id = base
            i = 1
            existing = {t['id'] for t in data['tasks']}
            while task_id in existing:
                i += 1
                task_id = f'{base}_{i}'
        if not start_date:
            start_date = now_str[:10]
        # PATCH v1.0.14: completed_at принимается от клиента как есть.
        # Пустое значение = «закрыта без даты». Автозаполнение today
        # перенесено на клиент (при переходе в done подставляется
        # сегодня, но админ может его стереть и сохранить).
        if status not in ('done', 'archived'):
            completed_at = ''

        try:
            created = db.upsert_task(task_id, {
                'name': name, 'icon': icon, 'description': description,
                'status': status, 'start_date': start_date, 'deadline': deadline,
                'completed_at': completed_at, 'folder': folder, 'order_ref': order_ref,
                'tags': tags, 'assignees': assignees, 'department_ids': dep_ids,
                'created_at': now_str,
                'is_urgent': is_urgent,
                'links': links,
                'orders': orders,
                'task_type': task_type,
                'pocket': pocket,
                'lead_department': lead_department,
                'lead_employee': lead_employee,
                'stages': stages,
            })
        except ValueError as _ve:
            # PATCH tasks-stages: валидация пересечения этапов в db.upsert_task
            return jsonify({'success': False, 'error': str(_ve)}), 400
        # PATCH v1.0.9: если админ вручную вернул задачу из done в другой
        # статус — снимаем метку авто (статус снова считается решением админа).
        try:
            if status != 'done':
                db.exec("UPDATE tasks SET auto_closed_at='' WHERE id=?", (task_id,))
        except Exception as _e:
            print(f'[task_save] reset auto_closed_at failed: {_e}')
        _audit(db, u, 'create' if created else 'update', 'task', task_id,
               {'name': name, 'tags': tags})
        try:
            app.config['PLUGIN_REGISTRY'].emit('on_task_save', user=u,
                                                task_id=task_id, created=created)
        except Exception:
            pass
        # PATCH v1.0.16: уведомление по вертикали о новой задаче
        if created:
            try:
                _notify_task_created(db, task_id, u)
            except Exception as _e:
                print(f'[notify] task_created hook failed: {_e}')
        return jsonify({'success': True, 'id': task_id, 'created': created})

