        row = db.query_one('SELECT * FROM notifications WHERE id=? AND to_user_id=?', (nid, u['id']))
        if not row:
            return jsonify({'success': False, 'error': 'not found'}), 404
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        if action == 'accept':
            db.exec(
                'UPDATE notifications SET status="confirmed", read_at=? WHERE id=?',
                (now, nid),
            )
            return jsonify({'success': True})
        # reject: откатываем последнюю done-отметку сотрудника по этой задаче
        tid = row.get('task_id') or ''
        emp_id = row.get('employee_id') or ''
        if not tid or not emp_id:
            return jsonify({'success': False, 'error': 'no task/employee'}), 400
        _last = db.query_one(
            'SELECT id FROM work_logs WHERE task_id=? AND employee_id=? AND status="done" ORDER BY date DESC, id DESC LIMIT 1',
            (tid, emp_id),
        )
        if _last:
            db.exec('UPDATE work_logs SET status="in_progress" WHERE id=?', (_last['id'],))
            try:
                _try_reopen_if_stale_autoclose(db, tid, u)
            except Exception:
                pass
        db.exec(
            'UPDATE notifications SET status="rejected", read_at=? WHERE id=?',
            (now, nid),
        )
        return jsonify({'success': True, 'reverted_log': bool(_last)})

    # ============================================================
    # PLUGINS
    # ============================================================
    registry = HookRegistry()
    app.config['PLUGIN_REGISTRY'] = registry
    try:
        loaded_plugins = load_plugins(BASE_DIR / 'plugins', app, db, registry)
        app.config['LOADED_PLUGINS'] = loaded_plugins
    except Exception as e:
        print(f'[plugins] fatal: {e}')
        app.config['LOADED_PLUGINS'] = []
    try:
        registry.emit('on_startup', app=app, db=db)
    except Exception:
        pass

    import atexit
    def _emit_shutdown():
        try:
            registry.emit('on_shutdown', app=app, db=db)
        except Exception:
            pass
    atexit.register(_emit_shutdown)

    return app

