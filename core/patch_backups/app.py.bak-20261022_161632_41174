def _normalize_url(u):
    """Нормализация URL/пути для сравнения дубликатов:
    strip, lower, убрать trailing slash."""
    s = str(u or '').strip().lower()
    while len(s) > 1 and s.endswith('/'):
        s = s[:-1]
    return s


def _normalize_line(s):
    """Нормализация строки описания для сравнения дублей:
    strip, lower, ё→е, схлопывание пробелов."""
    x = str(s or '').strip().lower().replace('ё', 'е')
    x = ' '.join(x.split())
    return x


def _split_lines(s):
    """Разбить строку на непустые строки, strip'нутые, в исходном регистре."""
    return [ln.strip() for ln in str(s or '').split('\n') if ln.strip()]


def _merge_description_lines(existing_text, new_text):
    """Построчный merge описания.

    Из existing_text сохраняем все строки и их порядок.
    Из new_text добавляем только те строки, которых нет в existing (по нормализованному виду).
    Возвращает (итоговый текст, сколько строк добавлено)."""
    existing_lines = _split_lines(existing_text)
    new_lines = _split_lines(new_text)
    seen = set(_normalize_line(ln) for ln in existing_lines)
    added = 0
    for ln in new_lines:
        nk = _normalize_line(ln)
        if not nk or nk in seen:
            continue
        existing_lines.append(ln)
        seen.add(nk)
        added += 1
    return ('\n'.join(existing_lines), added)


def _parse_json_list(s):
    try:
        v = json.loads(s or '[]')
        return v if isinstance(v, list) else []
    except Exception:
        return []


def _merge_log_data_into_task(db, task_id, employee_id, user,
                              description, extra_data, orders, links):
    """PATCH 1.0.28: description → tasks.description (merge построчно).
    extra/orders/links → соответствующие поля задачи. Лог действий → в начало folder.
    Использует chr(10) вместо 
 для избежания проблем с экранированием."""
    _NL = chr(10)
    now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    added_by = (user or {}).get('display_name') or (user or {}).get('username') or ''
    result = {
        'added_description': False,
        'description_lines_added': 0,
        'extra_added': 0, 'extra_skipped': 0,
        'orders_added': 0, 'orders_skipped': 0,
        'links_added': 0, 'links_skipped': 0,
        'total_added': 0,
    }
    pass  # PATCH 1.0.34: debug-print убран
    t = db.query_one('SELECT * FROM tasks WHERE id=?', (task_id,))
    if not t:
        return result

    cur_orders = _parse_json_list(t.get('orders_json') or '[]')
    cur_links = _parse_json_list(t.get('links_json') or '[]')
    cur_extra_meta = _parse_json_list(t.get('extra_meta') or '[]')
    cur_folder = (t.get('folder') or '')
    cur_description = (t.get('description') or '')

    new_desc = (description or '').strip()
    if new_desc:
        _merged_desc, _added_n = _merge_description_lines(cur_description, new_desc)
        if _added_n > 0:
            cur_description = _merged_desc
            result['added_description'] = True
            result['description_lines_added'] = _added_n

    folder_lines = [ln.strip() for ln in cur_folder.split(_NL) if ln.strip()]
    seen_norm = set(_normalize_url(x) for x in folder_lines)
    for line in (extra_data or []):
        line = str(line or '').strip()
        if not line:
            continue
        norm = _normalize_url(line)
        if norm in seen_norm:
            result['extra_skipped'] += 1
            continue
        folder_lines.append(line)
        cur_extra_meta.append({'line': line, 'added_by': added_by, 'added_at': now})
        seen_norm.add(norm)
        result['extra_added'] += 1

    seen_ord = set(_normalize_url(o.get('value') or '') for o in cur_orders if isinstance(o, dict))
    for o in (orders or []):
        if not isinstance(o, dict):
            continue
        val = str(o.get('value') or '').strip()
        if not val:
            continue
        norm = _normalize_url(val)
        if norm in seen_ord:
            result['orders_skipped'] += 1
            continue
        cur_orders.append({
            'description': str(o.get('description') or '').strip()[:200],
            'value': val[:1000],
            'added_by': added_by, 'added_at': now, 'source': 'log',
        })
        seen_ord.add(norm)
        result['orders_added'] += 1

    seen_lnk = set(_normalize_url(l.get('url') or '') for l in cur_links if isinstance(l, dict))
    for l in (links or []):
        if not isinstance(l, dict):
            continue
        url = str(l.get('url') or '').strip()
        if not url:
            continue
        norm = _normalize_url(url)
        if norm in seen_lnk:
            result['links_skipped'] += 1
            continue
        cur_links.append({
            'description': str(l.get('description') or '').strip()[:200],
            'url': url[:1000],
            'added_by': added_by, 'added_at': now, 'source': 'log',
        })
        seen_lnk.add(norm)
        result['links_added'] += 1

    result['total_added'] = (
        result['extra_added'] + result['orders_added'] + result['links_added']
        + (1 if result['added_description'] else 0)
    )

    if result['total_added'] > 0:
        _who = added_by or 'user'
        _parts = []
        if result['added_description']:
            _n_d = result['description_lines_added']
            _parts.append(f'✏️ описание +{_n_d} стр.' if _n_d > 1 else '✏️ описание')
        if result['extra_added']:
            _parts.append(f"📁 доп. данные +{result['extra_added']}")
        if result['orders_added']:
            _parts.append(f"📄 приказы +{result['orders_added']}")
        if result['links_added']:
            _parts.append(f"🔗 ссылки +{result['links_added']}")
        _marker = f'🔄 {now[:16]} · {_who} · ' + ' · '.join(_parts)
        folder_lines.insert(0, _marker)

    if result['total_added'] == 0:
        return result

    new_folder = _NL.join(folder_lines)[:4000]
    db.exec(
        'UPDATE tasks SET description=?, folder=?, orders_json=?, links_json=?, extra_meta=?, updated_at=? WHERE id=?',
        (
            cur_description[:8000],
            new_folder,
            json.dumps(cur_orders, ensure_ascii=False),
            json.dumps(cur_links, ensure_ascii=False),
            json.dumps(cur_extra_meta, ensure_ascii=False),
            now, task_id,
        )
    )
    return result



