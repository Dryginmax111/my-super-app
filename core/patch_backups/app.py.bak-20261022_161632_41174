    @app.route('/api/tracker/state', methods=['GET'])
    @login_required
    def api_state():
        u = current_user(db)
        perms = effective_permissions(db, u)
        try:
            log_days = int(request.args.get('log_days', 365))
        except (ValueError, TypeError):
            log_days = 365
        # PATCH v2: используем load_all(since=...) — не грузим старые логи в память
        if log_days > 0:
            _cutoff = (date.today() - timedelta(days=log_days)).strftime('%Y-%m-%d')
            data = _data(db, since=_cutoff)
            log_truncated = True
        else:
            data = _data(db)
            log_truncated = False
        today = date.today().strftime('%Y-%m-%d')
        tasks = []
        for t in data['tasks']:
            tt = dict(t)
            tt['overdue'] = _is_overdue(t, today)
            tt['completion_kind'] = _completion_kind(t)
            tasks.append(tt)

        all_tags = sorted({tag for t in data['tasks'] for tag in (t.get('tags') or [])})

        return jsonify({
            'success': True,
            'employees': data['employees'],
            'tasks': tasks,
            'log': data['log'],
            'log_truncated': log_truncated,
            'log_days_used': log_days,
            'departments': data['departments'],
            'teams': data['teams'],
            'holidays': data['holidays'],
            'all_tags': all_tags,
            'tag_presets': DEFAULT_TAG_PRESETS,
            'log_count': len(data['log']),
            'status_labels': STATUS_LABELS,
            'task_status_labels': TASK_STATUS_LABELS,
            'absence_types': ABSENCE_TYPES,
            'palette': PALETTE,
            'emoji': EMOJI_LIST,
            'today': today,
            'work_weekdays': list(WORK_WEEKDAYS),
            'permissions': perms,
            'current_user': {
                'id': u['id'], 'username': u['username'],
                'role': u['role'], 'display_name': u.get('display_name', ''),
                'employee_id': u.get('employee_id') or '',
            },
        })

