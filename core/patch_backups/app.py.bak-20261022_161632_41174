    # API: EMPLOYEE CARD
    # ============================================================
    @app.route('/api/tracker/employee/card', methods=['GET'])
    @login_required
    def api_employee_card():
        emp_id = request.args.get('employee', '').strip()
        if not emp_id:
            return jsonify({'success': False, 'error': 'Нужен employee'}), 400
        u = current_user(db)
        perms = effective_permissions(db, u)
        if not perms.get('block.summary.other_employees'):
            my_emp = u.get('employee_id') or ''
            if not my_emp or emp_id != my_emp:
                return jsonify({'success': False, 'error': 'forbidden'}), 403

        date_from = request.args.get('from', '').strip()
        date_to = request.args.get('to', '').strip()
        if not _valid_date(date_from):
            date_from = date.today().replace(day=1).strftime('%Y-%m-%d')
        if not _valid_date(date_to):
            date_to = date.today().strftime('%Y-%m-%d')
        df = datetime.strptime(date_from, '%Y-%m-%d').date()
        dt_ = datetime.strptime(date_to, '%Y-%m-%d').date()

        data = _data(db)
        em = {e['id']: e for e in data['employees']}
        tm = {t['id']: t for t in data['tasks']}
        emp = em.get(emp_id)
        if not emp:
            return jsonify({'success': False, 'error': 'Сотрудник не найден'}), 404

        today_d = date.today()
        today = today_d.strftime('%Y-%m-%d')
        holidays = data['holidays']
        # PATCH 1.0.8: не учитываем будущие отметки в статистике карточки
        try:
            _ifu_card = str(db.get_setting('stats_ignore_future', '1')) != '0'
        except Exception:
            _ifu_card = True

        relevant_tids = set()
        for t in data['tasks']:
            if _task_in_period(t, date_from, date_to, today) and emp_id in t.get('assignees', []):
                relevant_tids.add(t['id'])

        by_date = {}
        by_task = {}
        by_task_active = {}
        for l in data['log']:
            if l.get('employee_id') != emp_id:
                continue
            ldate = l.get('date', '')
            if not ldate or ldate < date_from or ldate > date_to:
                continue
            h = float(l.get('hours', 0) or 0)
            by_date[ldate] = by_date.get(ldate, 0.0) + h
            tid = l.get('task_id')
            by_task.setdefault(tid, {})[ldate] = by_task.get(tid, {}).get(ldate, 0.0) + h
            if not _ifu_card or ldate <= today:
                by_task_active.setdefault(tid, {})[ldate] = by_task_active.get(tid, {}).get(ldate, 0.0) + h
            relevant_tids.add(tid)

        cells = []
        max_h = 0.0
        total = 0.0
        cur = df
        while cur <= dt_:
            dk = cur.strftime('%Y-%m-%d')
            wd = cur.weekday()
            is_wknd = wd >= 5
            is_hol = dk in holidays
            is_wd = (wd in WORK_WEEKDAYS) and not is_hol
            absence = _absence_type(emp, dk)
            is_remote = (absence == 'remote')
            is_vac = bool(absence) and not is_remote
            h = round(by_date.get(dk, 0.0) * 4) / 4
            if h > max_h:
                max_h = h
            total += h
            missing = (
                is_wd and not is_vac and dk <= today and h == 0
                and _is_active_on(emp, dk) and not _is_dept_head(emp)
            )
            cells.append({
                'date': dk, 'hours': h,
                'is_workday': is_wd, 'is_weekend': is_wknd,
                'is_holiday': is_hol, 'holiday_name': holidays.get(dk, ''),
                'is_vacation': is_vac, 'is_remote': is_remote, 'absence_type': absence,
                'missing': missing, 'is_today': dk == today,
            })
            cur += timedelta(days=1)

        tasks_out = []
        for tid in relevant_tids:
            t = tm.get(tid) or {'id': tid, 'name': '— удалена —', 'icon': '❓'}
            logs_emp = [l for l in data['log']
                        if l.get('employee_id') == emp_id and l.get('task_id') == tid]
            ad, pd, cov = _calc_coverage(t, emp, logs_emp, today_d)
            ts_raw = t.get('start_date') or date_from
            te_raw = t.get('deadline') or today
            try:
                ts = datetime.strptime(ts_raw, '%Y-%m-%d').date()
            except Exception:
                ts = df
            try:
                te = datetime.strptime(te_raw, '%Y-%m-%d').date()
            except Exception:
                te = today_d
            if t.get('deadline') and _valid_date(t['deadline']) and t['deadline'] < today \
                    and t.get('status') not in ('done', 'archived'):
                te = today_d
            ts_show = max(ts, df)
            te_show = min(te, dt_)
            if ts_show > te_show:
                ts_show, te_show = df, dt_
            t_cells = []
            cur = ts_show
            while cur <= te_show:
                dk = cur.strftime('%Y-%m-%d')
                h = round(by_task.get(tid, {}).get(dk, 0.0) * 4) / 4
                wd = cur.weekday()
                is_wknd = wd >= 5
                is_hol = dk in holidays
                t_cells.append({
                    'date': dk, 'hours': h,
                    'is_workday': (wd in WORK_WEEKDAYS) and not is_hol,
                    'is_weekend': is_wknd, 'is_holiday': is_hol,
                    'is_today': dk == today,
                })
                cur += timedelta(days=1)
            task_total = sum(by_task_active.get(tid, {}).values())
            emp_ck = _emp_completion_kind(t, data['log'], emp_id)
            emp_ca = _emp_last_done_date(data['log'], emp_id, tid)
            tasks_out.append({
                'task_id': tid,
                'task_name': t.get('name', ''),
                'task_icon': t.get('icon', '📋'),
                'task_tags': list(t.get('tags') or []),
                'overdue': _emp_is_overdue(t, data['log'], emp_id, today),
                'start_date': t.get('start_date', ''),
                'deadline': t.get('deadline', ''),
                'completed_at': emp_ca or t.get('completed_at', ''),
                'emp_completed_at': emp_ca,
                'completion_kind': emp_ck or _completion_kind(t),
                'emp_completion_kind': emp_ck,
                'days_delta': _emp_days_delta(t, data['log'], emp_id),
                'status': t.get('status', 'active'),
                'total_hours': round(task_total * 4) / 4,
                'active_days': ad, 'possible_days': pd, 'coverage': cov,
                'cells': t_cells,
            })
        tasks_out.sort(key=lambda x: (-x['total_hours'], x['task_name'].lower()))

        return jsonify({
            'success': True, 'from': date_from, 'to': date_to,
            'employee': {
                'id': emp['id'], 'name': emp.get('name', ''),
                'color': emp.get('color', '#888'),
                'role': emp.get('role', ''),
                'department': emp.get('department', ''),
                'fired': emp.get('fired', False),
                'fired_date': emp.get('fired_date', ''),
            },
            'cells': cells, 'tasks': tasks_out,
            'total_hours': round(total * 4) / 4,
            'max_hours': max_h,
        })

