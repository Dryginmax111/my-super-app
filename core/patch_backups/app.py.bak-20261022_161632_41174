    @app.route('/api/settings/db_path/save', methods=['POST'])
    @login_required
    @permission_required('tab.settings')
    def api_db_path_save():
        body = request.get_json() or {}
        new_path = str(body.get('db_path', '')).strip()
        copy_data = bool(body.get('copy_data', True))
        force_empty = bool(body.get('force_empty', False))
        if not new_path:
            return jsonify({'success': False, 'error': 'Путь не указан'}), 400
        p = Path(new_path)
        if not p.is_absolute():
            p = BASE_DIR / p
        if not p.parent.exists():
            return jsonify({
                'success': False,
                'error': f'Папка не существует: {p.parent}',
            }), 400

        old_path_str = str(cfg.get('db_path') or '')
        old_path = Path(old_path_str) if old_path_str else None
        if old_path is not None and not old_path.is_absolute():
            old_path = BASE_DIR / old_path

        # PATCH v1.0.27: если путь тот же — ничего не делаем
        same_path = False
        try:
            if old_path is not None and old_path.resolve() == p.resolve():
                same_path = True
        except Exception:
            pass

        copied = False
        if not same_path:
            # Есть ли данные в новой БД?
            new_has_users = 0
            if p.exists():
                try:
                    import sqlite3 as _sq1
                    with _sq1.connect(str(p), timeout=10.0) as _c1:
                        _t = _c1.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='users'").fetchone()
                        if _t:
                            _r = _c1.execute('SELECT COUNT(*) FROM users').fetchone()
                            new_has_users = int(_r[0]) if _r else 0
                except Exception as _e:
                    print(f'[db_path] проверка нового файла: {_e}')
            if new_has_users > 0 and not force_empty:
                return jsonify({
                    'success': False,
                    'error': (f'По пути уже существует БД с данными ({new_has_users} пользователей): {p}. '
                              f'Укажите другой путь или подтвердите перезапись.'),
                    'exists_with_data': True,
                    'users_count': new_has_users,
                }), 409

            # Копируем текущую БД в новое место (только если старый файл есть)
            if copy_data and not force_empty and old_path is not None and old_path.exists():
                try:
                    import sqlite3 as _sq2
                    _src = _sq2.connect(str(old_path), timeout=30.0)
                    _dst = _sq2.connect(str(p))
                    try:
                        with _dst:
                            _src.backup(_dst)
                    finally:
                        try: _src.close()
                        except Exception: pass
                        try: _dst.close()
                        except Exception: pass
                    copied = True
                    print(f'[db_path] скопировано: {old_path} -> {p}')
                except Exception as e:
                    return jsonify({'success': False, 'error': f'Не удалось скопировать БД: {e}'}), 500

        try:
            cfg_local = json.loads(CONFIG_PATH.read_text(encoding='utf-8'))
            cfg_local['db_path'] = str(p)
            CONFIG_PATH.write_text(
                json.dumps(cfg_local, ensure_ascii=False, indent=2),
                encoding='utf-8',
            )
        except Exception as e:
            return jsonify({'success': False, 'error': f'Ошибка записи: {e}'}), 500
        _audit(db, current_user(db), 'update', 'config', 'db_path',
               {'old': old_path_str, 'new': str(p), 'copied': copied})
        return jsonify({
            'success': True,
            'message': ('Данные скопированы. ' if copied else '') + 'Перезапустите сервер для применения.',
            'copied': copied,
            'new_path': str(p),
        })

