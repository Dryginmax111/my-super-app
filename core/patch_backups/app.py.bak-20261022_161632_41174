            employees = [e for e in employees if e['id'] in member_ids]
        if emp_id:
            employees = [e for e in employees if e['id'] == emp_id]
        logs_by_emp = {}
        for l in all_logs:
            if l['date'] > end_date:
                continue
            logs_by_emp.setdefault(l['employee_id'], {}).setdefault(l['date'], []).append(l)
        ABSENCE_ICON = {'vacation': '🏖', 'sick_leave': '🤒', 'business_trip': '✈️', 'remote': '🏠'}
        STATUS_FILL_HEX = {'done': 'C8E6C9', 'in_progress': 'DCEDC8', 'planned': 'E0E0E0', 'blocked': 'FFCDD2'}
        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = f'Календарь {month:02d}.{year}'
        total_cols = days_in_month + 2
        ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=total_cols)
        ws['A1'] = f'Календарь задач: {month:02d}.{year}'
        ws['A1'].font = Font(bold=True, size=14)
        ws['A1'].alignment = Alignment(horizontal='center')
        header_fill = PatternFill('solid', fgColor='2C3E50')
        header_font = Font(bold=True, color='FFFFFF')
        header_align = Alignment(horizontal='center', vertical='center', wrap_text=True)
        thin = Side(style='thin', color='CCCCCC')
        thin_border = Border(left=thin, right=thin, top=thin, bottom=thin)
        for c, val in ((1, 'Сотрудник'), (2, 'Отдел')):
            cell = ws.cell(row=3, column=c, value=val)
            cell.font = header_font
            cell.fill = header_fill
            cell.alignment = header_align
            cell.border = thin_border
        WD = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс']
        today = date.today()
        for day in range(1, days_in_month + 1):
            col = day + 2
            d = date(year, month, day)
            cell = ws.cell(row=3, column=col, value=f'{day:02d}\n{WD[d.weekday()]}')
            cell.font = header_font
            cell.fill = header_fill
            cell.alignment = header_align
            cell.border = thin_border
            ds = d.strftime('%Y-%m-%d')
            if ds in holidays:
                cell.fill = PatternFill('solid', fgColor='FFE0E0')
            elif d.weekday() >= 5:
                cell.fill = PatternFill('solid', fgColor='EEEEEE')
            if d == today:
                cell.fill = PatternFill('solid', fgColor='C8E6C9')
        row = 4
        total_tasks = {day: 0 for day in range(1, days_in_month + 1)}
        total_hours = {day: 0.0 for day in range(1, days_in_month + 1)}
        for emp in employees:
            ws.cell(row=row, column=1, value=emp.get('name', '')).font = Font(bold=True)
            ws.cell(row=row, column=1).border = thin_border
            ws.cell(row=row, column=2, value=emp.get('department', '')).border = thin_border
            emp_logs = logs_by_emp.get(emp['id'], {})
            emp_vacs = emp.get('vacations', [])
            for day in range(1, days_in_month + 1):
                col = day + 2
                ds = date(year, month, day).strftime('%Y-%m-%d')
                cell = ws.cell(row=row, column=col)
                cell.border = thin_border
                cell.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)
                vac = None
                for v in emp_vacs:
                    if v.get('from', '') <= ds <= v.get('to', ''):
                        vac = v
                        break
                if vac:
                    cell.value = ABSENCE_ICON.get(vac.get('type', 'vacation'), '📅')
                    cell.font = Font(size=14)
                    cell.fill = PatternFill('solid', fgColor='BBDEFB')
                elif ds in emp_logs:
                    logs = emp_logs[ds]
                    first_status = (logs[0].get('status') or 'planned')
                    cnt = len(logs)
                    hrs = sum(float(l.get('hours') or 0) for l in logs)
                    txt = f'{cnt} задач' if cnt > 1 else '1 задача'
                    if hrs > 0:
                        txt += f'\n{hrs:g}ч'
                    cell.value = txt
                    cell.fill = PatternFill('solid', fgColor=STATUS_FILL_HEX.get(first_status, 'F5F5F5'))
                    total_tasks[day] += cnt
                    total_hours[day] += hrs
                else:
                    cell.value = ''
            row += 1
        ws.cell(row=row, column=1, value='ИТОГО').font = Font(bold=True, size=11)
        for c in (1, 2):
            ws.cell(row=row, column=c).fill = PatternFill('solid', fgColor='FDEBD0')
            ws.cell(row=row, column=c).border = thin_border
        for day in range(1, days_in_month + 1):
            col = day + 2
            cell = ws.cell(row=row, column=col)
            cell.border = thin_border
            cell.fill = PatternFill('solid', fgColor='FDEBD0')
            cell.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)
            if total_tasks[day] > 0:
                cell.value = f'{total_tasks[day]}\n{total_hours[day]:g}ч'
        ws.column_dimensions['A'].width = 25
        ws.column_dimensions['B'].width = 16
        for day in range(1, days_in_month + 1):
            ws.column_dimensions[get_column_letter(day + 2)].width = 9
        ws.row_dimensions[3].height = 40
        for r in range(4, row + 1):
            ws.row_dimensions[r].height = 38
        from io import BytesIO
        output = BytesIO()
        wb.save(output)
        output.seek(0)
        filename = f'calendar_{year}_{month:02d}.xlsx'
        return send_file(output, mimetype='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', as_attachment=True, download_name=filename)


    @app.route('/api/tracker/calendar', methods=['GET'])
    @login_required
    @permission_required('tab.calendar')
    def api_calendar():
        u = current_user(db)
        perms = effective_permissions(db, u)
        ym = request.args.get('ym', '').strip()
        emp_filter = request.args.get('employee', '').strip()
        dept_filter_raw = request.args.get('department', '').strip()
        dept_ids = [x.strip() for x in dept_filter_raw.split(',') if x.strip()] if dept_filter_raw else []
        team_filter = request.args.get('team', '').strip()
        y, m = _parse_ym(ym)
        first = date(y, m, 1)
        last = date(y, m, monthrange(y, m)[1])
        start = first - timedelta(days=first.weekday())
        end = last + timedelta(days=(6 - last.weekday()))
        # PATCH v1.0.7: грузим логи только за видимый период
        data = _data(db, since=start.strftime('%Y-%m-%d'))
        today = date.today().strftime('%Y-%m-%d')
        holidays = data['holidays']

        team_ids = _team_filter_emp_ids(data, team_filter)
        emps = data['employees']
        if dept_ids:
            emps = [e for e in emps if e.get('department_id') in dept_ids]
        if team_ids is not None:
            emps = [e for e in emps if e['id'] in team_ids]
        if emp_filter:
            emps = [e for e in emps if e['id'] == emp_filter]

        if not perms.get('block.calendar.other_employees'):
            my_emp = u.get('employee_id') or ''
            if emp_filter:
                if emp_filter != my_emp:
                    emps = []
            else:
                emps = [e for e in emps if e['id'] == my_emp] if my_emp else []

        allowed = {e['id'] for e in emps}
        em = {e['id']: e for e in data['employees']}
        tm = {t['id']: t for t in data['tasks']}

        days = {}
        cur = start
        while cur <= end:
            dk = cur.strftime('%Y-%m-%d')
            vac = [e['id'] for e in emps if _in_vacation(e, dk)]
            rem = [e['id'] for e in emps if _is_remote(e, dk)]
            is_hol = dk in holidays
            is_wknd = cur.weekday() >= 5
            days[dk] = {
                'date': dk, 'in_month': (cur.month == m and cur.year == y),
                'weekday': cur.weekday(),
                'is_workday': (cur.weekday() in WORK_WEEKDAYS) and not is_hol,
                'is_weekend': is_wknd, 'is_holiday': bool(is_hol),
                'holiday_name': holidays.get(dk, ''),
                'entries': [], 'total_hours': 0.0,
                'employees': [], 'missing': [], 'vacation': vac, 'remote': rem,
                'overdue_tasks': [], 'not_started': [],
            }
            cur += timedelta(days=1)

        for l in data['log']:
            ldate = l.get('date', '')
            if ldate not in days:
                continue
            if l.get('employee_id') not in allowed:
                continue
            e = em.get(l.get('employee_id')) or {
                'id': l.get('employee_id'), 'name': '— удалён —', 'color': '#888888'
            }
            t = tm.get(l.get('task_id')) or {
                'id': l.get('task_id'), 'name': '— удалена —', 'icon': '❓'
            }
            entry = {
                'id': l.get('id'),
                'employee_id': e['id'],
                'employee_name': e.get('name', ''),
                'employee_color': e.get('color', '#888'),
                'employee_department': e.get('department', ''),
                'task_id': t['id'],
                'task_name': t.get('name', ''),
                'task_icon': t.get('icon', '📋'),
                'task_start_date': t.get('start_date', ''),
                'task_deadline': t.get('deadline', ''),
                'task_created_at': t.get('created_at', ''),
                'task_tags': list(t.get('tags') or []),
                'hours': float(l.get('hours', 0) or 0),
                'comment': l.get('comment', ''),
                'status': l.get('status', 'done'),
                'status_label': STATUS_LABELS.get(l.get('status', 'done'), ''),
                'link': l.get('link', ''),
                'overdue': _is_overdue(t, today),
                'extra_data': l.get('extra_data') or [],
                'orders': l.get('orders') or [],
                'links': l.get('links') or [],
            }
            days[ldate]['entries'].append(entry)
            days[ldate]['total_hours'] += entry['hours']
            if e['id'] not in days[ldate]['employees']:
                days[ldate]['employees'].append(e['id'])

        for t in data['tasks']:
            if not _is_overdue(t, today):
                continue
            dl = t.get('deadline', '')
            if dl in days:
                days[dl]['overdue_tasks'].append({
                    'id': t['id'], 'name': t.get('name', ''), 'icon': t.get('icon', '📋'),
                })

        for dk, day in days.items():
            if not day['is_workday'] or dk > today:
                continue
            for e in emps:
                if e['id'] in day['employees']:
                    continue
                if _absence_type(e, dk):
                    continue
                if not _is_active_on(e, dk):
                    continue
                if _is_dept_head(e):
                    continue
                day['missing'].append({
                    'id': e['id'], 'name': e.get('name', ''),
                    'color': e.get('color', '#888'),
                    'department': e.get('department', ''),
                })

        task_assignees = {}
        for _t in data['tasks']:
            if _t.get('status') not in ('active', 'paused'):
                continue
            _aids = [a for a in (_t.get('assignees') or []) if a]
            if _aids:
                task_assignees[_t['id']] = _aids

        day_entries_by_emp_task = {}
        for l in data['log']:
            ld = l.get('date', '')
            if ld not in days:
                continue
            eid = l.get('employee_id')
            tid = l.get('task_id')
            if not eid or not tid:
                continue
            day_entries_by_emp_task.setdefault(ld, set()).add((eid, tid))

        emps_by_id = {e['id']: e for e in emps}
        for dk, day in days.items():
            if dk > today:
                continue
            _day_set = day_entries_by_emp_task.get(dk, set())
            for t in data['tasks']:
                if t.get('status') not in ('active', 'paused'):
                    continue
                _sd = t.get('start_date') or ''
                _dl = t.get('deadline') or ''
                if _sd and dk < _sd:
                    continue
                if _dl and dk > _dl:
                    continue
                for _aid in task_assignees.get(t['id'], []):
                    if _aid not in emps_by_id:
                        continue
                    if (_aid, t['id']) in _day_set:
                        continue
                    _e = emps_by_id[_aid]
                    # PATCH v1.0.3: до найма задачи не считаем «назначено, не начато»
                    if not _is_active_on(_e, dk):
                        continue
                    day['not_started'].append({
                        'employee_id': _aid,
                        'employee_name': _e.get('name', ''),
                        'employee_color': _e.get('color', '#888'),
                        'task_id': t['id'],
                        'task_name': t.get('name', ''),
                        'task_icon': t.get('icon', '📋'),
                        'deadline': _dl,
                        # PATCH v1.0.18: метка для приоритета/подсветки
                        'is_urgent': bool(t.get('is_urgent')),
                    })
            day['not_started'] = day['not_started'][:30]

        for dk in days:
            days[dk]['entries'].sort(key=lambda x: -x['hours'])
            days[dk]['total_hours'] = round(days[dk]['total_hours'] * 4) / 4

        return jsonify({
            'success': True, 'year': y, 'month': m,
            'start': start.strftime('%Y-%m-%d'),
            'end': end.strftime('%Y-%m-%d'),
            'days': list(days.values()),
            'employees': data['employees'],
            'holidays': holidays,
        })

