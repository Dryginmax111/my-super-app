/* ============================================================
   PATCH v1.0.3 — фидбек кнопки «Добавить» в блоке
   «Назначено, но не заведено» (модалка новой отметки).
   Перехват на window в capture-фазе — раньше v1.2.3 / PATCH 23.
   ============================================================ */
(function(){
'use strict';
if (window.__trkLabAddFeedbackV103) return;
window.__trkLabAddFeedbackV103 = true;

function _notify(msg, kind){
    if (typeof window.__trackerNotify === 'function') {
        try { window.__trackerNotify(msg, kind); return; } catch (e) {}
    }
    console.log('[lab-feedback]', msg);
}

function _modalContent(){
    var m = document.getElementById('logModal');
    return m ? m.querySelector('.modal-content') : null;
}
function _blockModal(){
    var c = _modalContent();
    if (c) c.classList.add('lab-modal-blocked');
}
function _unblockModal(){
    var c = _modalContent();
    if (c) c.classList.remove('lab-modal-blocked');
}

function _labelizeBtn(btn){
    if (!btn) return;
    var tile = btn.closest('.lab-tile');
    if (tile && (tile.classList.contains('lab-processing') || tile.classList.contains('lab-success'))) return;
    var txt = (btn.textContent || '').trim();
    if (txt !== '➕ Добавить') btn.textContent = '➕ Добавить';
}
function _decorateAll(){
    var btns = document.querySelectorAll('#logModal .log-assigned-block .lab-tile .lab-add');
    btns.forEach(_labelizeBtn);
}

function _findBtn(e){
    if (!e || !e.target || !e.target.closest) return null;
    return e.target.closest('#logModal .log-assigned-block .lab-tile .lab-add');
}

function _buildPayload(tile){
    var tid = tile.getAttribute('data-task-id');
    if (!tid) return {error: 'Не найдена задача'};
    var empEl = document.getElementById('log_employee');
    var dtEl = document.getElementById('log_date');
    var empId = empEl ? empEl.value : '';
    var dk = dtEl ? dtEl.value : '';
    if (!empId) return {error: 'Выберите сотрудника'};
    if (!dk) return {error: 'Некорректная дата'};

    var st = window.__trkState || {};
    var day = null;
    if (st.calendar && st.calendar.days) {
        day = st.calendar.days.find(function(d){ return d.date === dk; });
    }
    var n = 0;
    if (day && day.entries) {
        day.entries.forEach(function(en){ if (en.employee_id === empId) n++; });
    }
    var hrs = Math.round((8 / (n + 1)) * 4) / 4;
    if (hrs < 0.5) hrs = 0.5;
    if (hrs > 24) hrs = 24;

    return {
        employee_id: empId,
        task_id: tid,
        date: dk,
        hours: hrs,
        status: 'in_progress',
        comment: 'Назначенная задача, добавлена из карточки отметки',
        link: ''
    };
}

// === Перерисовка списка «Уже заведено за этот день» ===
function _refreshDayExisting(){
    try {
        var tabs = document.getElementById('logExistingTabs');
        if (tabs) {
            var activeTab = tabs.querySelector('.log-existing-tab.active')
                         || tabs.querySelector('.log-existing-tab');
            if (activeTab) {
                activeTab.click();
                return true;
            }
        }
        // Fallback: смена даты → change → renderExistingDayEntries
        var dtEl = document.getElementById('log_date');
        if (dtEl) {
            dtEl.dispatchEvent(new Event('change', {bubbles: true}));
            return true;
        }
    } catch(e) { console.error('[lab-feedback] refresh list', e); }
    return false;
}

// === Обновление календаря (state.calendar) и dayModal ===
function _refreshCalendarThen(){
    var p = Promise.resolve();
    try {
        if (typeof window.__trkRenderCalendar === 'function') {
            p = Promise.resolve(window.__trkRenderCalendar());
        }
    } catch(e) { console.error('[lab-feedback] calendar refresh', e); }
    return p;
}
function _refreshDayModalIfOpen(){
    try {
        var dm = document.getElementById('dayModal');
        var st = window.__trkState || {};
        if (dm && dm.classList.contains('active') && st.currentDay) {
            if (typeof window.__trkOpenDayModal === 'function') {
                window.__trkOpenDayModal(st.currentDay);
            }
        }
    } catch(e) { console.error('[lab-feedback] dayModal refresh', e); }
}

function _doAdd(tile, btn){
    var payload = _buildPayload(tile);
    if (!payload) return;
    if (payload.error) { _notify('❌ ' + payload.error, 'error'); return; }

    // === «Обрабатывается»: состояние плитки + блокировка модалки ===
    tile.classList.remove('lab-success');
    tile.classList.add('lab-processing');
    btn.disabled = true;
    btn.textContent = 'Обрабатывается…';
    _blockModal();

    var hdrs = {'Content-Type': 'application/json'};
    if (window.REESTR_CSRF) hdrs['X-CSRF-Token'] = window.REESTR_CSRF;

    fetch('/api/tracker/log/save', {
        method: 'POST',
        headers: hdrs,
        credentials: 'same-origin',
        body: JSON.stringify(payload)
    })
    .then(function(r){
        return r.text().then(function(t){
            var j = null;
            try { j = JSON.parse(t); } catch(e) {}
            if (!r.ok || !j || !j.success) {
                var msg = (j && j.error) || ('HTTP ' + r.status);
                throw new Error(msg);
            }
            return j;
        });
    })
    .then(function(){
        // === «Успешно добавлено» ===
        tile.classList.remove('lab-processing');
        tile.classList.add('lab-success');
        btn.textContent = '✅ Успешно добавлено';
        _notify('✅ Задача добавлена в день', 'success');

        // Локально в state.calendar — чтобы сразу подхватилось списком
        try {
            var st = window.__trkState || {};
            if (st.calendar && st.calendar.days) {
                var day = st.calendar.days.find(function(d){ return d.date === payload.date; });
                if (day) {
                    if (!day.entries) day.entries = [];
                    var exists = day.entries.some(function(e){
                        return e.employee_id === payload.employee_id &&
                               e.task_id === payload.task_id &&
                               e.date === payload.date;
                    });
                    if (!exists) {
                        day.entries.push({
                            id: 'tmp_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                            employee_id: payload.employee_id,
                            task_id: payload.task_id,
                            date: payload.date,
                            hours: payload.hours,
                            status: 'in_progress',
                            comment: payload.comment,
                            link: ''
                        });
                    }
                }
            }
        } catch(e) { console.error('[lab-feedback] state update', e); }

        // Разблокируем модалку сразу после успеха
        _unblockModal();

        // Обновляем state.calendar с сервера, затем триггерим списки
        _refreshCalendarThen().then(function(){
            _refreshDayExisting();
            _refreshDayModalIfOpen();
        });

        // Плавно убираем плитку через 1.2 сек
        setTimeout(function(){
            tile.classList.add('lab-removing');
            setTimeout(function(){
                if (tile.parentNode) tile.parentNode.removeChild(tile);
                // После удаления плитки пересобираем блок «Назначено»
                try {
                    if (window.__trkLogAssignedDecorate) window.__trkLogAssignedDecorate();
                } catch(e) {}
            }, 380);
        }, 1200);
    })
    .catch(function(err){
        // === Возврат в исходное состояние при ошибке ===
        tile.classList.remove('lab-processing');
        btn.disabled = false;
        btn.textContent = '➕ Добавить';
        _unblockModal();
        var msg = (err && err.message) || 'Ошибка';
        if (msg.indexOf('cancelled') !== -1) return;
        _notify('❌ ' + msg, 'error');
    });
}

// === Основной перехват ===
window.addEventListener('click', function(e){
