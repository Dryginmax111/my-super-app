    var hasO = Array.isArray(task.orders) && task.orders.length;
    var hasL = Array.isArray(task.links) && task.links.length;
    if (hasD || hasF || hasO || hasL) return Promise.resolve(task);
    if (task._v1016Fetched) return Promise.resolve(task);
    task._v1016Fetched = true;

    var from = (document.getElementById('sumDateFrom') || {}).value || '';
    var to = (document.getElementById('sumDateTo') || {}).value || '';
    if (!from || !to) {
        var d = new Date();
        var y = d.getFullYear(), m = d.getMonth() + 1;
        var pad = function(n){ return n < 10 ? '0'+n : ''+n; };
        from = y + '-' + pad(m) + '-01';
        to   = y + '-' + pad(m) + '-' + pad(new Date(y, m, 0).getDate());
    }
    var url = '/api/tracker/task/card?task=' + encodeURIComponent(task.id)
            + '&from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to);
    var hdrs = {};
    if (window.REESTR_CSRF) hdrs['X-CSRF-Token'] = window.REESTR_CSRF;
    return fetch(url, {credentials:'same-origin', headers:hdrs})
        .then(function(r){ return r.json(); })
        .then(function(d){
            if (d && d.success && d.task) {
                var ft = d.task;
                if (!task.orders) task.orders = ft.orders || [];
                if (!task.links) task.links = ft.links || [];
