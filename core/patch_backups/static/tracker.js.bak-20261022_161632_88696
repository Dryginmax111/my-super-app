        function fh(x){ var v = Math.round((x || 0) * 100) / 100; return (v === Math.floor(v) ? v : v.toFixed(2).replace(/0+$/, '').replace(/\.$/, '')) + ' ч'; }
        if (nums) nums.innerHTML = '<div class="ov-num-row"><span class="ov-num-label">Уже за день</span><span class="ov-num-val">' + fh(info.sum_existing) + '</span></div>'
