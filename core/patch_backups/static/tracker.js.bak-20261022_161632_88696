/* ============================================================
   v1.0.6 — Стабильный блок «Назначено, но не начато»
   ============================================================ */
(function(){
    'use strict';
    if (window.__trkDayNSStableV106) return;
    window.__trkDayNSStableV106 = true;

    var CTX_ID = 'dayNotStartedWrap';
    var _lastSig = '';

    function esc(s){
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
            return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
        });
    }

    function fmtD(iso){
        if (!iso) return '';
        var p = iso.split('-');
        if (p.length !== 3) return iso;
        return p[2] + '.' + p[1];
    }

    function getWrap() {
        var wrap = document.getElementById(CTX_ID);
        if (wrap) return wrap;
        var list = document.getElementById('dayList');
        if (!list || !list.parentNode) return null;
        wrap = document.createElement('div');
        wrap.id = CTX_ID;
        wrap.className = 'day-notstarted-wrap';
        list.parentNode.insertBefore(wrap, list);
        return wrap;
    }

    function currentDay() {
        var st = window.__trkState;
        if (!st || !st.calendar || !st.currentDay) return null;
        return st.calendar.days.find(function(d){ return d.date === st.currentDay; }) || null;
    }

    function buildHtml(day) {
        var ns = day && day.not_started ? day.not_started : [];
        if (!ns.length) return '';
        var h = '<div class="day-notstarted-block">';
        h += '<div class="dns-head">';
        h += '<span class="dns-icon">🩶</span>';
        h += '<span class="dns-title">Назначено, но не начато</span>';
        h += '<span class="dns-count">' + ns.length + '</span>';
        h += '</div>';
        h += '<div class="dns-list">';
        ns.forEach(function(x){
            h += '<div class="dns-row">';
            h += '<span class="dns-emp-dot" style="background:' + esc(x.employee_color || '#888') + ';"></span>';
            h += '<span class="dns-task">' + esc(x.task_icon || '📋') + ' ' + esc(x.task_name || '') + '</span>';
            h += '<span class="dns-emp">' + esc(x.employee_name || '') + '</span>';
            h += '<span class="dns-dl">' + (x.deadline ? '⏰ ' + esc(fmtD(x.deadline)) : '') + '</span>';
            h += '</div>';
        });
        h += '</div></div>';
        return h;
    }

    function signature(day) {
        if (!day) return 'none';
        var ns = day.not_started || [];
        var parts = [day.date, String(ns.length)];
        for (var i = 0; i < ns.length; i++) {
            parts.push(ns[i].employee_id + ':' + ns[i].task_id);
        }
        return parts.join('|');
    }

    function render() {
        var modal = document.getElementById('dayModal');
        if (!modal || !modal.classList.contains('active')) return;
        var st = window.__trkState;
        if (st && st.dayViewMode === 'employee') return;
        var day = currentDay();
        var sig = signature(day);
        if (sig === _lastSig) return;
        _lastSig = sig;
        var wrap = getWrap();
        if (!wrap) return;
        var html = buildHtml(day);
        if (!html) {
            if (wrap.innerHTML) wrap.innerHTML = '';
            return;
        }
        if (wrap.innerHTML !== html) wrap.innerHTML = html;
    }

    function attach() {
        var list = document.getElementById('dayList');
        if (!list || list._nsStableV106) return;
        list._nsStableV106 = true;
        new MutationObserver(function(){ render(); })
            .observe(list, { childList: true });
    }

    function wrapOpen() {
        var orig = window.__trkOpenDayModal;
        if (typeof orig !== 'function' || orig._nsStableV106) return;
        var w = function() {
            _lastSig = '';
            var r = orig.apply(this, arguments);
            setTimeout(render, 60);
            setTimeout(render, 220);
            return r;
        };
        w._nsStableV106 = true;
        window.__trkOpenDayModal = w;
    }

    function boot() {
        attach();
        wrapOpen();
        setTimeout(function(){ attach(); wrapOpen(); }, 700);
        setTimeout(function(){ attach(); wrapOpen(); }, 1800);
        setTimeout(render, 300);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else { boot(); }

    document.addEventListener('click', function(e){
        if (!e.target || !e.target.closest) return;
        if (e.target.closest('#dayViewMode button')) {
            _lastSig = '';
            setTimeout(render, 120);
        }
        if (e.target.closest('#dayAddBtn')) {
            _lastSig = '';
        }
    });

    window.__trkRenderDayNotStarted = render;
})();
