    window.__trkDelLogSuppressFetch = true;
    window.fetch = function(url, opts){
        var isDel = (typeof url === 'string' && url.indexOf('/api/tracker/log/delete') !== -1);
        var isPost = opts && (opts.method || 'GET').toUpperCase() === 'POST';
        if (!isDel || !isPost) {
            return _native.apply(this, arguments);
        }

