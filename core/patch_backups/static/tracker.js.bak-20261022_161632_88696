        var st = window.__trkState;
        if (!st || !st.tasks) return null;
        var t = st.tasks.find(function(x) { return x.id === taskId; });
        if (!t) return null;

        var assignees = t.assignees || [];
        var lastByEmp = {};
        (st.log || []).forEach(function(l) {
            if (l.task_id !== taskId) return;
            var eid = l.employee_id;
            if (!eid) return;
            var cur = lastByEmp[eid];
            var ld = l.date || '';
            var cd = cur ? (cur.date || '') : '';
            if (!cur || ld > cd || (ld === cd && (l.id || 0) > (cur.id || 0))) {
                lastByEmp[eid] = l;
            }
        });

        var closed = [], open = [];
        assignees.forEach(function(eid) {
            var e = (st.employees || []).find(function(x) { return x.id === eid; });
            var name = e ? e.name : eid;
            var color = e ? (e.color || '#888') : '#888';
            var rec = lastByEmp[eid];
            if (rec && rec.status === 'done') {
                closed.push({ id: eid, name: name, color: color, date: rec.date });
