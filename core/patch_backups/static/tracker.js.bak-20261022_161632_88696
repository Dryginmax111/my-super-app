    window.__trkDelLogCleanFetch = true;
    window.fetch = function(url, opts){
        var isDel = (typeof url === 'string' && url.indexOf('/api/tracker/log/delete') !== -1);
        if (!isDel) return _nativeFetch.apply(this, arguments);
        if (!opts || (opts.method || 'GET').toUpperCase() !== 'POST') {
            return _nativeFetch.apply(this, arguments);
        }

        var ctx = window.__trkDelLogCtxV1018;
        var p = _nativeFetch.apply(this, arguments);
        if (!ctx || !ctx.modal) return p;

        var modal = ctx.modal;

