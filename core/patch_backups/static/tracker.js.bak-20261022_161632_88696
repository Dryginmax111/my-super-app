window.fetch = function(url, opts){
    var isLogSave = (typeof url === 'string' && url.indexOf('/api/tracker/log/save') !== -1);
    var isPost = opts && (opts.method || 'GET').toUpperCase() === 'POST';
    if (!isLogSave || !isPost) {
        return _native.apply(this, arguments);
    }

    var body = {};
    try { body = JSON.parse(opts.body || '{}'); } catch (e) {}
    body = _enrichBody(body);

    var self = this;
    var newOpts = Object.assign({}, opts, { body: JSON.stringify(body) });

    return _native.call(self, url, newOpts).then(function(r){
        // 409 daily_overflow
        if (r.status === 409) {
            return r.clone().json().then(function(d){
                if (d && d.error === 'daily_overflow') {
                    var info = {
                        sum_existing: d.sum_existing || 0,
                        new_hours: d.new_hours || 0,
                        total: d.total || 0,
                        employee_name: d.employee_name || '',
                        date: d.date || body.date || ''
                    };
                    if (!info.employee_name) {
                        var st = window.__trkState || {};
                        var emp = (st.employees || []).find(function(e){ return e.id === body.employee_id; });
                        if (emp) info.employee_name = emp.name;
                    }
                    if (!info.date) info.date = body.date || '';
                    return _showOverflow(info).then(function(choice){
                        if (choice === 'cancel') {
                            return new Response(JSON.stringify({success: false, error: 'cancelled'}), {
                                status: 200, headers: {'Content-Type': 'application/json'}
                            });
                        }
                        var payload = Object.assign({}, body, {
                            overflow_action: choice === 'accept' ? 'accept' : 'distribute'
                        });
                        var retryOpts = Object.assign({}, opts, { body: JSON.stringify(payload) });
                        return _native.call(self, url, retryOpts);
                    });
                }
                return r;
            });
        }
        // 409 already_logged_today
        if (r.status === 409) {
            return r.clone().json().then(function(d){
                if (d && d.error === 'already_logged_today') {
                    var msg = 'У сотрудника «' + (d.employee_name || '') + '» уже есть отметка '
                            + (d.date || '') + ' по задаче «' + (d.task_name || '') + '».\n\nОткрыть её?';
                    if (window.confirm(msg)) {
                        var st = window.__trkState || {};
                        var entry = null;
                        if (st.calendar && st.calendar.days) {
                            for (var i = 0; i < st.calendar.days.length; i++) {
                                var day = st.calendar.days[i];
                                var arr = day.entries || [];
                                for (var j = 0; j < arr.length; j++) {
                                    if (String(arr[j].id) === String(d.existing_id)) { entry = arr[j]; break; }
                                }
                                if (entry) break;
                            }
                        }
                        if (entry && typeof window.__trkOpenLogModal === 'function') {
                            setTimeout(function(){ window.__trkOpenLogModal(entry); }, 80);
                        }
                    }
                    return new Response(JSON.stringify({success: false, error: 'cancelled'}), {
                        status: 200, headers: {'Content-Type': 'application/json'}
                    });
                }
                return r;
            });
        }
        if (!r || !r.ok) return r;
        return r.clone().json().then(function(d){
            if (d && d.success && !d.cancelled) {
                _onSuccess(body, d);
            }
            return r;
        }).catch(function(){ return r; });
    });
};

