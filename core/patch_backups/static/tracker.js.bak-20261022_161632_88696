})();
/* ============================================================
   v1.0.2 — Пересчёт часов в карточке дня (клиентская страховка)
   ============================================================ */
(function(){
    'use strict';
    if (window.__trkDayTotalFixV102) return;
    window.__trkDayTotalFixV102 = true;

    function fmtH(h){
        h = Number(h) || 0;
        if (h === Math.floor(h)) return h + ' ч';
        return h.toFixed(2).replace(/0+$/, '').replace(/\.$/, '') + ' ч';
    }

    function recalc() {
        var st = window.__trkState;
        if (!st || !st.currentDay || !st.calendar) return;
        var day = (st.calendar.days || []).find(function(d){ return d.date === st.currentDay; });
        if (!day) return;
        var entries = day.entries || [];
        var sum = 0;
        entries.forEach(function(en){
            var h = parseFloat(en.hours);
            if (!isNaN(h)) sum += h;
        });
        sum = Math.round(sum * 4) / 4;
        var el = document.getElementById('dayModalTotal');
        if (!el) return;
        var txt = fmtH(sum) + ' · ' + entries.length + ' записей';
        if (day.missing && day.missing.length) txt += ' · не заполнено: ' + day.missing.length;
        if (el.textContent !== txt) el.textContent = txt;
    }

    function wrapOpen() {
        var orig = window.__trkOpenDayModal;
        if (typeof orig !== 'function' || orig._totalFixHooked) return;
        var w = function() {
            var r = orig.apply(this, arguments);
            setTimeout(recalc, 40);
            setTimeout(recalc, 180);
            setTimeout(recalc, 400);
            return r;
        };
        w._totalFixHooked = true;
        window.__trkOpenDayModal = w;
    }

    wrapOpen();
    setTimeout(wrapOpen, 500);
    setTimeout(wrapOpen, 1500);
    setInterval(function(){
        var m = document.getElementById('dayModal');
        if (m && m.classList.contains('active')) recalc();
    }, 700);

    window.__trkRecalcDayTotal = recalc;
})();
