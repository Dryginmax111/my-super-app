(function(){
    'use strict';
    if (window.__trkQuickAddAssigned) return;
    window.__trkQuickAddAssigned = true;

    function toast(msg, kind){
        var n = document.getElementById('trackerNotif');
        if (!n) { alert(msg); return; }
        n.textContent = msg;
        n.className = 'tracker-notification show' + (kind === 'error' ? ' error' : '');
        clearTimeout(n._t);
        n._t = setTimeout(function(){ n.classList.remove('show'); }, 3500);
    }

    function doQuickAdd(tile) {
        var logModal = document.getElementById('logModal');
        if (!logModal) return;
        var tid = tile.getAttribute('data-task-id');
        if (!tid) return;

        var empEl = document.getElementById('log_employee');
        var dtEl = document.getElementById('log_date');
        var empId = empEl ? empEl.value : '';
        var dk = dtEl ? dtEl.value : '';
        if (!empId) { toast('❌ Выберите сотрудника', 'error'); return; }
        if (!dk) { toast('❌ Некорректная дата', 'error'); return; }

        var st = window.__trkState || {};
        var day = null;
        if (st.calendar && st.calendar.days) {
            day = st.calendar.days.find(function(d){ return d.date === dk; });
        }
        var n = 0;
        if (day && day.entries) {
            day.entries.forEach(function(en){
                if (en.employee_id === empId) n++;
            });
        }
        var hrs = Math.round((8 / (n + 1)) * 4) / 4;
        if (hrs < 0.5) hrs = 0.5;
        if (hrs > 24) hrs = 24;

        var hdrs = { 'Content-Type': 'application/json' };
        if (window.REESTR_CSRF) hdrs['X-CSRF-Token'] = window.REESTR_CSRF;

        var btn = tile.querySelector('.lab-add');
        if (btn) btn.disabled = true;
        tile.style.opacity = '0.5';

        fetch('/api/tracker/log/save', {
            method: 'POST',
            headers: hdrs,
            credentials: 'same-origin',
            body: JSON.stringify({
                employee_id: empId,
                task_id: tid,
                date: dk,
                hours: hrs,
                status: 'in_progress',
                comment: 'Назначенная задача, добавлена из карточки отметки',
                link: ''
            })
        })
        .then(function(r){ return r.json().then(function(j){ return { ok: r.ok, d: j }; }); })
        .then(function(res){
            if (!res.ok || !res.d || !res.d.success) {
                if (btn) btn.disabled = false;
                tile.style.opacity = '';
                var err = (res.d && res.d.error) || ('HTTP ' + res.ok);
                if (err === 'cancelled' || err === 'Отменено пользователем') return;
                toast('❌ ' + err, 'error');
                return;
            }
            logModal.classList.remove('active');
            toast('✅ Задача добавлена в день', 'success');
            // PATCH v1.0.6: обновляем активную вкладку, не только календарь
            var _refresh = (typeof window.__trkRefreshAll === 'function')
                ? window.__trkRefreshAll
                : (typeof window.__trkRenderCalendar === 'function' ? window.__trkRenderCalendar : null);
            if (_refresh) { Promise.resolve(_refresh()); }
        })
        .catch(function(e){
            if (btn) btn.disabled = false;
            tile.style.opacity = '';
            if (e && e.message && e.message.indexOf('cancelled') !== -1) return;
            toast('❌ ' + (e.message || 'Ошибка'), 'error');
        });
    }

