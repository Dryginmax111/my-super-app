// --- 3. Обёртка trkRefreshAll — не мигаем лоадером при повторной загрузке
(function _wrapRefreshAll(){
    function _apply(){
        if (typeof window.__trkRefreshAll !== 'function') return;
        if (window.__trkRefreshAll._noDoubleV1014) return;
