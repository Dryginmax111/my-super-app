            + '<div class="ov-num-row ov-num-warn"><span class="ov-num-label">Переработка</span><span class="ov-num-val">' + fh(over) + '</span></div>';
        var forget = m.querySelector('#trkOvForget');
        if (forget) forget.onclick = function(ev){ ev.preventDefault(); try { sessionStorage.removeItem(SK); } catch(e){} };
        m.classList.add('active');
        var resolved = false;
        function finish(choice){
            if (resolved) return;
            resolved = true;
            m.classList.remove('active');
            m.removeEventListener('click', onClick);
            if (choice !== 'cancel' && remember && remember.checked) {
                try { sessionStorage.setItem(SK, choice); } catch(e){}
            }
            resolve(choice);
        }
        function onClick(e){
            if (e.target === m) { finish('cancel'); return; }
            var b = e.target.closest && e.target.closest('[data-ov]');
            if (!b) return;
            finish(b.getAttribute('data-ov'));
        }
        m.addEventListener('click', onClick);
    });
