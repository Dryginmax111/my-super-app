}

function _mergeEntryWithTask(entry, task){
    task = task || {}; entry = entry || {};

    var descTask = String(task.description || '').trim();
    var descEntry = String(entry.comment || '').trim();
    var descCombined;
    if (descTask && descEntry) {
        if (_norm(descTask) === _norm(descEntry)) descCombined = descTask;
        else descCombined = descTask + '\n' + descEntry;
    } else if (descTask) descCombined = descTask;
    else descCombined = descEntry;

    var folderLines = String(task.folder || '').split(/\r?\n/).map(function(x){ return x.trim(); });
    var entryExtra = (entry.extra_data || []).map(function(x){
        if (typeof x === 'string') return x;
        return (x && x.line) || '';
    });
    var extraMerged = _uniqLines(folderLines.concat(entryExtra));

    var ordersTask = Array.isArray(task.orders) ? task.orders : [];
    var ordersEntry = Array.isArray(entry.orders) ? entry.orders : [];
    var ordersMerged = _uniqByKey(ordersTask.concat(ordersEntry), function(o){
        return _normUrl(o && o.value);
    });

    var linksTask = Array.isArray(task.links) ? task.links : [];
    var linksEntry = Array.isArray(entry.links) ? entry.links : [];
    var linksAll = linksTask.concat(linksEntry);
    if (entry.link) {
        var _u = String(entry.link).trim();
        if (_u) {
            var _has = linksAll.some(function(l){ return l && _normUrl(l.url) === _normUrl(_u); });
            if (!_has) linksAll = linksAll.concat([{ description: '', url: _u }]);
        }
    }
    var linksMerged = _uniqByKey(linksAll, function(l){
        return _normUrl(l && l.url);
    });

    return {
        description: descCombined,
        extra_data: extraMerged,
        orders: ordersMerged,
        links: linksMerged,
    };
}

