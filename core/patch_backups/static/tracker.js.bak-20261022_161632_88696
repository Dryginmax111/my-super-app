            } catch(e) {
                window.__trkDelLogSuppressLoader = prev;
                throw e;
            }
            var restore = function(){
                setTimeout(function(){
                    // Если параллельно ничего нового не поставили — вернуть
                    if (!window.__trkDelLogSuppressLoaderNext) {
                        window.__trkDelLogSuppressLoader = false;
                    }
                }, 300);
            };
            if (p && typeof p.then === 'function') {
                return p.then(function(v){ restore(); return v; },
                              function(e){ restore(); throw e; });
            }
            restore();
            return p;
        };
        wrapped._noDoubleV1014 = true;
        window.__trkRefreshAll = wrapped;
    }
    _apply();
    setTimeout(_apply, 500);
    setTimeout(_apply, 1500);
})();

// --- 4. Снимаем блокировку модалки только когда удаление + refresh завершены
//        (страховка поверх v1.0.13, у которой снятие идёт по факту ответа delete)
(function _wrapDelLogSuccess(){
