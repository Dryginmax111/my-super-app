            // Поэтому вызываем origSuccess, а он сам скроет через 900мс — 
            // но при этом suppress уже работает, так что второй «Загрузка…» не появится.
            return origSuccess.apply(this, arguments);
        };
        wrappedSuccess._noDoubleV1014 = true;
        window.__trkDelLogFeedback.success = wrappedSuccess;
    }
    _apply();
    setTimeout(_apply, 800);
