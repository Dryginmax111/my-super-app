        if (!e.target || !e.target.closest) return;
        var tile = e.target.closest('#logModal .lab-tile');
        if (!tile) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        doQuickAdd(tile);
    }, true);
})();
