// v1.0.10 уже перехватывает этот же URL; наш слушатель должен работать
// ПОСЛЕ него, чтобы блокировка шла с момента реального запроса.
var _native = window.fetch;
if (typeof _native === 'function' && !window.__trkAddMeFetch) {
    window.__trkAddMeFetch = true;
    window.fetch = function(url, opts){
        var isLogSave = (typeof url === 'string' && url.indexOf('/api/tracker/log/save') !== -1);
        var isPost = opts && (opts.method || 'GET').toUpperCase() === 'POST';
        if (!isLogSave || !isPost) {
            return _native.apply(this, arguments);
        }

        // Наш ли это клик? Флаг выставляется в обработчике ниже.
        var w = window.__trkAddMeCtx;
        var isAddMe = !!(w && w.content);
        var p = _native.apply(this, arguments);
