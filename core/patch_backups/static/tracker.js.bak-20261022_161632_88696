            if (!r || !r.ok) {
                try { _error(w.content, 'Ошибка HTTP ' + (r ? r.status : '?')); } catch(e) {}
                return r;
            }
            return r.clone().json().then(function(d){
                if (d && d.success) {
                    _success(w.content);
                } else {
                    _error(w.content, (d && d.error) || 'Ошибка');
                }
                return r;
            }).catch(function(){
                _error(w.content, 'Ошибка');
                return r;
            });
        }).catch(function(err){
            try { _error(w.content, (err && err.message) || 'Ошибка'); } catch(e) {}
            throw err;
        }).finally(function(){
            try { window.__trkAddMeCtx = null; } catch(e) {}
        });
    };
}

// === Навешиваем блокировку при клике по кнопкам ===
document.addEventListener('click', function(e){
    if (!e.target || !e.target.closest) return;
    if (!_isAddMeBtn(e.target)) return;

    // Уже заблокировано?
    var content = _getModalContent(e.target);
