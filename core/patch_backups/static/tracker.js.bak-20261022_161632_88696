    function hasPerm(k) {
        return !!(window.REESTR_PERMS && window.REESTR_PERMS[k]);
    }
    function _isPeriodic(t) {
        if (!t || !t.tags) return false;
        return t.tags.indexOf(PERIODIC_TAG) !== -1;
    }

