          +  '<input type="text" class="task-link-url" placeholder="https://… или \\\\server\\share\\file" value="' + _escapeAttr(url) + '" maxlength="1000">'
          +  '<button type="button" class="task-link-del" title="Удалить">×</button>'
          +  '</div>';
