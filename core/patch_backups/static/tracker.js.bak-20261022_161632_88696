(function() {
    'use strict';

    function measureHeader() {
        var header = document.querySelector('.tracker-header');
        if (!header) return;
        var h = Math.ceil(header.getBoundingClientRect().height);
        if (h > 0) {
            document.documentElement.style.setProperty('--tracker-header-h', h + 'px');
        }
    }

    window.addEventListener('load', measureHeader);
    window.addEventListener('resize', measureHeader);
    setTimeout(measureHeader, 100);
    setTimeout(measureHeader, 400);
    setTimeout(measureHeader, 1500);

    var header = document.querySelector('.tracker-header');
    if (header) {
        try {
            new MutationObserver(measureHeader).observe(header, {
                childList: true, subtree: true
            });
        } catch (e) {}
    }

    window.__trkMeasureHeader = measureHeader;
})();

/* ============================================================
   PATCH 44 — Отметки на будущие даты: коричневая штриховка
   Без MutationObserver с attributes — циклы исключены.
   ============================================================ */
(function() {
    'use strict';

    function _st() { return window.__trkState || null; }

    function decorateCalendar() {
        var st = _st();
        if (!st) return;
        var today = st.today || '';
        var grid = document.getElementById('calGrid');
        if (!grid) return;
        grid.querySelectorAll('.cal-cell').forEach(function(cell) {
            var dk = cell.getAttribute('data-date');
            var hasEntries = !!cell.querySelector('.cal-entry');
            var isFuture = !!(dk && today && dk > today);
            cell.classList.toggle('cal-future', isFuture && hasEntries);
        });
    }

    function decorateSummary() {
        var st = _st();
        if (!st) return;
        var today = st.today || '';
        var wrap = document.getElementById('sumWrap');
        if (!wrap) return;
        wrap.querySelectorAll('td.day-cell').forEach(function(td) {
            td.classList.remove('cell-future');
            var dk = td.getAttribute('data-date');
            if (!dk || !today || dk <= today) return;
            if (td.classList.contains('empty-cell')) return;
            var txt = (td.textContent || '').replace(/\s+/g, ' ').trim();
            if (!txt || txt === '·' || txt === '—') return;
            td.classList.add('cell-future');
        });
    }

    function decorateDayModal() {
        var st = _st();
        if (!st) return;
        var modal = document.getElementById('dayModal');
        if (!modal) return;
        var today = st.today || '';
        var dk = st.currentDay || '';
        modal.classList.toggle('day-modal-future', !!(dk && today && dk > today));
    }

    var _prev = window.__trkOnSummaryRender;
    window.__trkOnSummaryRender = function() {
        if (typeof _prev === 'function') { try { _prev(); } catch (e) {} }
        try { decorateSummary(); } catch (e) { console.error('[future-markers]', e); }
    };

    function observeCalendar() {
        var grid = document.getElementById('calGrid');
        if (!grid || grid._futureObserved) return;
        grid._futureObserved = true;
        new MutationObserver(function() { setTimeout(decorateCalendar, 20); })
            .observe(grid, { childList: true });
    }

    function observeDayModal() {
        var list = document.getElementById('dayList');
        if (list && !list._futureObserved) {
            list._futureObserved = true;
            new MutationObserver(function() { setTimeout(decorateDayModal, 20); })
                .observe(list, { childList: true });
        }
        var modal = document.getElementById('dayModal');
        if (modal && !modal._futureClassHooked) {
            modal._futureClassHooked = true;
            new MutationObserver(function() {
                if (modal.classList.contains('active')) {
                    setTimeout(decorateDayModal, 60);
                    setTimeout(decorateDayModal, 250);
                }
            }).observe(modal, { attributes: true, attributeFilter: ['class'] });
        }
    }

    function markLogSummary() {
        var summary = document.getElementById('logDaySummary');
        var dt = document.getElementById('log_date');
        if (!summary || !dt) return;
        var st = _st();
        var today = (st && st.today) || '';
        var v = dt.value || '';
        summary.classList.toggle('log-day-summary-future', !!(v && today && v > today));
    }

    document.addEventListener('change', function(e) {
        if (e.target && e.target.id === 'log_date') setTimeout(markLogSummary, 30);
    }, true);

    function boot() {
        observeCalendar();
        observeDayModal();
        setTimeout(decorateCalendar, 700);
        setTimeout(decorateSummary, 700);
        setTimeout(function() { observeCalendar(); observeDayModal(); }, 1500);
        setTimeout(function() { observeCalendar(); observeDayModal(); }, 3000);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else { boot(); }

    document.addEventListener('click', function(e) {
        if (!e.target || !e.target.closest) return;
        if (e.target.closest('.tracker-tab[data-tab="calendar"]')) {
            setTimeout(function() { observeCalendar(); decorateCalendar(); }, 300);
        }
        if (e.target.closest('.cal-nav-btn')) {
            setTimeout(decorateCalendar, 500);
            setTimeout(decorateCalendar, 1200);
        }
        if (e.target.closest('#dayAddBtn')) {
            setTimeout(markLogSummary, 300);
        }
    });

    window.__trkDecorateFuture = { calendar: decorateCalendar, summary: decorateSummary, day: decorateDayModal };
})();


/* ============================================================
   PATCH 2026-10-08 — Горизонтальная карточка новой отметки
   v2: в новом tracker.html .log-row-4 и .log-row-2 уже есть, 
   функция restructure становится no-op (проверка idempotence).
   Оставляю как fallback для старого HTML.
   ============================================================ */
(function() {
    'use strict';

    function restructure() {
        var m = document.getElementById('logModal');
        if (!m) return;
        var content = m.querySelector('.modal-content');
        if (!content) return;

        // PATCH v2: если уже размечено — выходим
        if (content.classList.contains('log-modal-wide') && 
            content.querySelector('.log-row-4')) {
            return;
        }

        var rows = content.querySelectorAll('.form-row');
        var rowDate = null, rowEmp = null;
        for (var i = 0; i < rows.length; i++) {
            if (rows[i].querySelector('#log_date')) rowDate = rows[i];
            if (rows[i].querySelector('#log_employee')) rowEmp = rows[i];
        }
        if (rowDate && rowEmp && !rowDate.classList.contains('log-row-4')) {
            while (rowEmp.firstChild) rowDate.appendChild(rowEmp.firstChild);
            rowEmp.parentNode.removeChild(rowEmp);
            rowDate.classList.remove('form-row');
            rowDate.classList.add('log-row-4');
        }

        var groups = content.querySelectorAll('.form-group');
        var gComment = null, gLink = null;
        for (var j = 0; j < groups.length; j++) {
            if (groups[j].querySelector('#log_comment')) gComment = groups[j];
            if (groups[j].querySelector('#log_link')) gLink = groups[j];
        }
        if (gComment && gLink && !gComment.parentNode.classList.contains('log-row-2')) {
            var wrap = document.createElement('div');
            wrap.className = 'log-row-2';
            gComment.parentNode.insertBefore(wrap, gComment);
            wrap.appendChild(gComment);
            wrap.appendChild(gLink);
        }

        content.classList.add('log-modal-wide');
    }

    document.addEventListener('click', function(e) {
        if (!e.target || !e.target.closest) return;
        if (e.target.closest('#dayAddBtn') ||
            e.target.closest('#dayModal .dict-action-btn[data-act="edit"]')) {
            setTimeout(restructure, 80);
            setTimeout(restructure, 300);
        }
    }, true);

    setTimeout(restructure, 800);

    window.__trkLogModalRestructure = restructure;
})();



/* ============================================================
   v1.2.7-merge-v2 — Объединение задач с чекбоксами при наведении
   Guard: window.__trkTaskMerge — повторный запуск блока ничего не делает.
   ============================================================ */
(function(){
    'use strict';
    if (window.__trkTaskMerge) return;
    window.__trkTaskMerge = true;

    function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}

    function selected(){
        var out = [];
        document.querySelectorAll('.task-merge-cb:checked').forEach(function(cb){
            out.push(cb.getAttribute('data-task-id'));
        });
        return out;
    }

    function updateBar(){
        var bar = document.getElementById('taskMergeBar');
        if (!bar) return;
        var n = selected().length;
        bar.style.display = n >= 2 ? '' : 'none';
        var c = document.getElementById('taskMergeCount');
        if (c) c.textContent = n;
    }

    function ensureBar(){
        var panel = document.getElementById('panel-tasks');
        if (!panel) return;
        if (document.getElementById('taskMergeBar')) return;
        var toolbar = panel.querySelector('.sum-toolbar');
        if (!toolbar) return;
        var bar = document.createElement('div');
