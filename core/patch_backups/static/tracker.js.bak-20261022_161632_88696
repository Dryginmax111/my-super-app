        if (!query) {
            for (var i = 0; i < cards.length; i++) cards[i].style.display = '';
            if (countEl) countEl.textContent = '';
            return;
        }

        var map = getTasksMap();
        var shown = 0, total = cards.length;
        for (var j = 0; j < cards.length; j++) {
            var c = cards[j];
            var id = c.getAttribute('data-id');
            var t = map[id];
