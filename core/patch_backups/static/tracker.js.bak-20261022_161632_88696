                var w=tw[j];
                if (w===q){hits++;hitWords.push(q);break;}
                if (w.length>=4&&q.length>=4&&w.indexOf(q)!==-1){hits++;hitWords.push(q);break;}
                if (w.length>=4&&q.length>=4&&q.indexOf(w)!==-1){hits++;hitWords.push(q);break;}
                if (w.length>=5&&q.length>=5&&lev(w,q)<=1){hits++;hitWords.push(q);break;}
