function _installLoaderGate(){
    var _origShow = window.__trkShowLoaderOrig;
    var _origHide = window.__trkHideLoaderOrig;

    // Внутренние функции трекера не экспортированы в window — перехватываем через
    // #globalLoader напрямую: если активен suppress-флаг, не даём включить лоадер.
