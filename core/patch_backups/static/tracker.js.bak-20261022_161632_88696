    var _softMs = [30000, 60000, 90000];
    var _softTimers = [];
    _softMs.forEach(function(delayMs){
        if (delayMs >= TIMEOUT_MS) return;
        _softTimers.push(setTimeout(function(){
            if (window.__trkAddMeCtx && window.__trkAddMeCtx.content === content) {
                var ov = content.querySelector('.addme-overlay.addme-overlay--soft');
                if (!ov) {
