        if (!st || !st.maskNames) return name;
        return String(name == null ? '' : name).split(/\s+/).map(function(w) {
            if (w.length <= 1) return w;
            return w[0] + new Array(w.length).join('*');
        }).join(' ');
    }
    function _isMine(en) {
        var st = window.__trkState;
