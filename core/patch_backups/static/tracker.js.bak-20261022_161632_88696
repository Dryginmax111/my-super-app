    // Никакого _prevFetch — используем только нативный fetch.
    var _nativeFetch = window.fetch;
    if (_nativeFetch && !window.__trkOverflowModalV2) {
        window.__trkOverflowModalV2 = true;
        window.fetch = function(url, opts) {
            if (typeof url !== 'string' || url.indexOf('/api/tracker/log/save') === -1) {
                return _nativeFetch.apply(this, arguments);
            }
            if (!opts || (opts.method || 'GET').toUpperCase() !== 'POST') {
                return _nativeFetch.apply(this, arguments);
            }
            var wantHours = 0;
            try { wantHours = parseFloat(JSON.parse(opts.body || '{}').hours) || 0; } catch (e) {}

            var self = this;
            return _nativeFetch.apply(this, arguments).then(function(resp) {
                if (resp.status !== 409 && resp.status !== 400) return resp;
                return resp.clone().json().then(function(d) {
                    var info = parseErr(resp.status, d, wantHours);
                    if (!info) {
                        return new Response(JSON.stringify(d || {success:false}), {
                            status: resp.status,
                            headers: {'Content-Type': 'application/json'}
                        });
                    }
                    if (!info.employee_name) {
                        try {
                            var st = window.__trkState;
                            var body = JSON.parse(opts.body || '{}');
                            if (st && st.employees && body.employee_id) {
                                var emp = st.employees.find(function(e) { return e.id === body.employee_id; });
                                if (emp) info.employee_name = emp.name;
                            }
                            if (!info.date) info.date = body.date || '';
                        } catch (e) {}
                    }

                    var stored = getStored();
                    var choiceP = (stored === 'accept' || stored === 'distribute')
                        ? Promise.resolve(stored)
                        : showDialog(info);

                    return choiceP.then(function(choice) {
                        if (choice === 'cancel') {
                            return new Response(JSON.stringify({
                                success: false,
                                error: 'cancelled'
                            }), { status: 200, headers: {'Content-Type': 'application/json'} });
                        }
                        var payload;
                        try { payload = JSON.parse(opts.body || '{}'); } catch (e) { payload = {}; }
                        payload.overflow_action = (choice === 'accept') ? 'accept' : 'distribute';
                        var newOpts = Object.assign({}, opts, { body: JSON.stringify(payload) });
                        return _nativeFetch.call(self, url, newOpts);
                    });
                });
            });
        };
    }
})();
/* ============================================================
   PATCH 08 — Удаление отметки с перераспределением часов
   ============================================================ */
(function() {
    'use strict';

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
            return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
        });
    }
    function fmtH(x) {
        var v = Math.round((Number(x) || 0) * 100) / 100;
        if (v === Math.floor(v)) return v + ' ч';
        return v.toFixed(2).replace(/0+$/, '').replace(/\.$/, '') + ' ч';
    }

    function getModal() {
        var m = document.getElementById('trkDeleteLogModal');
        if (m) return m;
        m = document.createElement('div');
        m.id = 'trkDeleteLogModal';
        m.className = 'modal trk-del-log-modal';
        // PATCH v3: inline z-index — гарантированно поверх logModal
        m.style.setProperty('z-index', '9000', 'important');
        m.innerHTML = [
            '<div class="modal-content dl-modal">',
            '  <div class="dl-head">',
            '    <span class="dl-icon">🗑</span>',
            '    <div class="dl-title-block">',
            '      <div class="dl-title">Удалить отметку?</div>',
            '      <div class="dl-sub" id="trkDlSub"></div>',
            '    </div>',
            '  </div>',
            '  <div class="dl-info" id="trkDlInfo"></div>',
            '  <div class="dl-question" id="trkDlQuestion"></div>',
            '  <div class="dl-actions">',
            '    <button type="button" class="btn btn-secondary" data-dl="cancel">Отмена</button>',
            '    <button type="button" class="btn btn-secondary" data-dl="keep">Оставить как есть</button>',
            '    <button type="button" class="btn btn-primary" data-dl="redistribute">Перераспределить поровну</button>',
            '  </div>',
            '</div>'
        ].join('');
        document.body.appendChild(m);
		m.style.setProperty('z-index', '9000', 'important');
        return m;
    }

    function showDialog(info) {
        return new Promise(function(resolve) {
            var m = getModal();
            var sub = m.querySelector('#trkDlSub');
            var infoEl = m.querySelector('#trkDlInfo');
            var qEl = m.querySelector('#trkDlQuestion');
            if (sub) sub.textContent = (info.employee_name || '') + ' · ' + (info.date || '');
            if (infoEl) {
                infoEl.innerHTML = [
                    '<div class="dl-row"><span class="dl-label">Задача</span><span class="dl-val">' + esc(info.task_name || '') + '</span></div>',
                    '<div class="dl-row"><span class="dl-label">Часы</span><span class="dl-val dl-danger">' + fmtH(info.hours) + '</span></div>'
                ].join('');
            }
            if (qEl) {
                qEl.innerHTML = 'У сотрудника остаётся <b>' + info.remaining.length + '</b> задач(и) на <b>' +
                    fmtH(info.remaining_hours) + '</b>.<br>' +
                    'Что сделать с освободившимися <b>' + fmtH(info.hours) + '</b>?';
            }
			m.style.setProperty('z-index', '9000', 'important');
            m.classList.add('active');
            var resolved = false;
            function finish(choice) {
                if (resolved) return;
                resolved = true;
                m.classList.remove('active');
                m.removeEventListener('click', onClick);
                resolve(choice);
            }
            function onClick(e) {
                if (e.target === m) { finish('cancel'); return; }
                var b = e.target.closest && e.target.closest('[data-dl]');
                if (!b) return;
                finish(b.getAttribute('data-dl'));
            }
            m.addEventListener('click', onClick);
        });
    }

    function findInfo(logId) {
        var st = window.__trkState;
        if (!st || !st.calendar || !st.calendar.days) return null;
        for (var i = 0; i < st.calendar.days.length; i++) {
            var day = st.calendar.days[i];
            var entries = day.entries || [];
            var target = null;
            for (var j = 0; j < entries.length; j++) {
                if (entries[j].id === logId) { target = entries[j]; break; }
            }
            if (!target) continue;
            var empId = target.employee_id;
            var same = entries.filter(function(e) {
                return e.employee_id === empId && e.id !== logId;
            });
            var remH = same.reduce(function(s, e) { return s + (parseFloat(e.hours) || 0); }, 0);
            var totalB = remH + (parseFloat(target.hours) || 0);
            return {
                entry: target,
                date: day.date,
                employee_id: empId,
                employee_name: target.employee_name,
                task_name: target.task_name,
                hours: parseFloat(target.hours) || 0,
                remaining: same,
                remaining_hours: remH,
                total_before: totalB
            };
        }
        return null;
    }

    function distribute(total, n) {
        if (n < 1) return [];
        var each = Math.floor((total / n) * 4) / 4;
        if (each < 0.25) each = 0.25;
        var out = [];
        for (var i = 0; i < n - 1; i++) out.push(each);
        var last = Math.round((total - each * (n - 1)) * 4) / 4;
        if (last < 0.25) last = 0.25;
        out.push(last);
        return out;
    }

    var _nativeFetch = window.fetch;
    if (_nativeFetch && !window.__trkDeleteLogModalV1) {
        window.__trkDeleteLogModalV1 = true;
        window.fetch = function(url, opts) {
            if (typeof url !== 'string' || url.indexOf('/api/tracker/log/delete') === -1) {
                return _nativeFetch.apply(this, arguments);
            }
            if (!opts || (opts.method || 'GET').toUpperCase() !== 'POST') {
                return _nativeFetch.apply(this, arguments);
            }
            var logId = 0;
            try { logId = parseInt(JSON.parse(opts.body || '{}').id, 10); } catch (e) {}
            if (!logId) return _nativeFetch.apply(this, arguments);

            var info = findInfo(logId);
            if (!info || !info.remaining.length) {
                return _nativeFetch.apply(this, arguments);
            }

            var self = this;
            return showDialog(info).then(function(choice) {
                if (choice === 'cancel') {
                    return new Response(JSON.stringify({
                        success: false,
                        error: 'cancelled'
                    }), { status: 200, headers: {'Content-Type': 'application/json'} });
                }
                return _nativeFetch.call(self, url, opts).then(function(r) {
                    if (!r.ok) return r;
                    if (choice !== 'redistribute') return r;
                    var ids = info.remaining.map(function(e) { return e.id; });
                    var vals = distribute(info.total_before, ids.length);
                    var chain = Promise.resolve();
                    info.remaining.forEach(function(e, i) {
                        chain = chain.then(function() {
                            var newH = vals[i];
                            if (Math.abs(newH - (parseFloat(e.hours) || 0)) < 0.01) return null;
                            var hdrs = Object.assign({}, opts.headers || {}, {'Content-Type': 'application/json'});
                            return _nativeFetch('/api/tracker/log/save', {
                                method: 'POST',
                                headers: hdrs,
                                credentials: 'same-origin',
                                body: JSON.stringify({
                                    id: e.id,
                                    employee_id: e.employee_id,
                                    task_id: e.task_id,
                                    date: e.date,
                                    hours: newH,
                                    status: e.status || 'in_progress',
                                    comment: e.comment || '',
                                    link: e.link || '',
                                    overflow_action: 'accept'
                                })
                            });
                        });
                    });
                    return chain.then(function() { return r; });
                });
            });
        };
    }
})();
