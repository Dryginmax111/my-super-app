/* ============================================================
   PATCH v1.0.6 — кастомный выпадающий список задач.
   position:fixed + рендер в body; минимум 220px высоты;
   расширенный нечёткий поиск; счётчик в шапке.
   ============================================================ */
(function(){
'use strict';
if (window.__trkLogTaskDropdownV106) return;
window.__trkLogTaskDropdownV106 = true;

var _activeIdx = -1;
var _items = [];
var _total = 0;
var _open = false;
var _dropdownEl = null;
var _query = '';

function _esc(s){
    return String(s==null?'':s).replace(/[&<>"']/g,function(c){
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
}

function _getInput(){ return document.getElementById('log_task_input'); }
function _getHidden(){ return document.getElementById('log_task'); }

function _ensureDropdown(){
    if (_dropdownEl && document.body.contains(_dropdownEl)) return _dropdownEl;
    var el = document.getElementById('log_task_dropdown');
    if (el && el.parentNode !== document.body) {
        document.body.appendChild(el);
    }
    if (!el) {
        el = document.createElement('div');
        el.id = 'log_task_dropdown';
        el.className = 'log-task-dropdown';
        el.setAttribute('hidden', '');
        document.body.appendChild(el);
    }
    _dropdownEl = el;
    return el;
}

function _positionDropdown(){
    var inp = _getInput();
    var drop = _ensureDropdown();
    if (!inp || !drop) return;
    var r = inp.getBoundingClientRect();
    var vw = window.innerWidth;
    var vh = window.innerHeight;
    var width = Math.max(300, r.width);
    var left = r.left;
    if (left + width > vw - 8) left = Math.max(8, vw - width - 8);

    var spaceBelow = vh - r.bottom - 8;
    var spaceAbove = r.top - 8;
    var MIN_H = 220;
    var PREF_H = 420;
    var maxH;
    var placeBelow;
    if (spaceBelow >= Math.min(PREF_H, MIN_H)) {
        placeBelow = true;
        maxH = Math.min(PREF_H, spaceBelow);
    } else if (spaceAbove >= Math.min(PREF_H, MIN_H)) {
        placeBelow = false;
        maxH = Math.min(PREF_H, spaceAbove);
    } else {
        // ни снизу, ни сверху нормально — берём ту сторону, где больше
        placeBelow = spaceBelow >= spaceAbove;
        maxH = Math.max(MIN_H, Math.max(spaceBelow, spaceAbove));
        // всё равно ограничим, чтобы не вылезти за экран полностью
        if (placeBelow) maxH = Math.min(maxH, vh - r.bottom - 8);
        else maxH = Math.min(maxH, r.top - 8);
        if (maxH < MIN_H) maxH = MIN_H;
    }

    drop.style.left = left + 'px';
    drop.style.width = width + 'px';
    drop.style.maxHeight = maxH + 'px';
    if (placeBelow) {
        drop.style.top = (r.bottom + 4) + 'px';
        drop.style.bottom = 'auto';
    } else {
        drop.style.top = 'auto';
        drop.style.bottom = (vh - r.top + 4) + 'px';
    }
}

function _isSelectable(t){
    if (!t || !t.id) return false;
    var st = t.status || 'active';
    return st === 'active' || st === 'paused';
}

// Нормализация текста: ё→е, убрать пунктуацию (кроме дефиса), схлопнуть пробелы
function _norm(s){
    return String(s == null ? '' : s)
        .toLowerCase()
        .replace(/ё/g, 'е')
        .replace(/[^\wа-я\s-]/gi, ' ')
        .replace(/\s+/g, ' ')
        .trim();
}

// Расширенный поиск: 0 — самое релевантное, 999 — не подходит
function _rank(t, q){
    if (!q) return 0;
    var qn = _norm(q);
    if (!qn) return 0;
    var name = _norm(t.name || '');
    var desc = _norm(t.description || '');
    var tags = _norm((t.tags || []).join(' '));
    var folder = _norm(t.folder || '');
    var hay = name + ' \u0001 ' + desc + ' \u0001 ' + tags + ' \u0001 ' + folder;

    // 0 — точное совпадение всего запроса
    if (name === qn) return 0;
    // 1 — имя начинается с запроса
    if (name.indexOf(qn) === 0) return 1;
    // 2 — имя содержит запрос
    if (name.indexOf(qn) !== -1) return 2;
    // 3 — тег содержит запрос
    if (tags.indexOf(qn) !== -1) return 3;
    // 4 — описание содержит запрос
    if (desc.indexOf(qn) !== -1) return 4;

    // Разбиваем запрос на слова. Отдельно — слова >1 символа, для надёжности
    var words = qn.split(/\s+/).filter(function(w){ return w.length >= 2; });
    if (!words.length) words = qn.split(/\s+/).filter(Boolean);
    if (!words.length) return 999;

    // 5 — все слова встречаются как подстрока в любом месте haystack
    var allIn = words.every(function(w){ return hay.indexOf(w) !== -1; });
    if (allIn) return 5;

    // 6 — все слова встречаются как начало слова (word-start) в name или tags
    var nameWords = name.split(/[\s-]+/).filter(Boolean);
    var tagsWords = tags.split(/[\s-]+/).filter(Boolean);
    var wStart = function(ws){ return function(w){
        for (var i = 0; i < ws.length; i++) {
            if (ws[i] === w) return true;
            if (ws[i].indexOf(w) === 0) return true;
        }
        return false;
    }; };
    var nameStart = wStart(nameWords);
    var tagsStart = wStart(tagsWords);
    var allName = words.every(nameStart);
    if (allName) return 6;
    var allNameOrTags = words.every(function(w){ return nameStart(w) || tagsStart(w); });
    if (allNameOrTags) return 7;

    // 7 — большинство слов совпадают (≥ 60%)
    var hits = 0;
    for (var i = 0; i < words.length; i++) {
        if (name.indexOf(words[i]) !== -1 || tags.indexOf(words[i]) !== -1
            || desc.indexOf(words[i]) !== -1 || folder.indexOf(words[i]) !== -1) {
            hits++;
        }
    }
    if (hits >= Math.ceil(words.length * 0.6)) return 8;

    return 999;
}

function _buildList(){
    var st = window.__trkState || {};
    var tasks = Array.isArray(st.tasks) ? st.tasks.slice() : [];
    var inp = _getInput();
    var q = inp ? (inp.value || '').trim() : '';
    _query = q;

    var pool = tasks.filter(_isSelectable);
    var matched = [];
    if (!q) {
        matched = pool.slice();
    } else {
        for (var i = 0; i < pool.length; i++) {
            var r = _rank(pool[i], q);
            if (r !== 999) matched.push({ t: pool[i], r: r });
        }
        matched.sort(function(a, b){
            if (a.r !== b.r) return a.r - b.r;
            var ad = a.t.deadline || '9999-99-99';
            var bd = b.t.deadline || '9999-99-99';
            if (ad !== bd) return ad < bd ? -1 : 1;
            return String(a.t.name || '').toLowerCase().localeCompare(String(b.t.name || '').toLowerCase(), 'ru');
        });
        matched = matched.map(function(x){ return x.t; });
    }

    // Если запрос пустой — сортируем по имени
    if (!q) {
        matched.sort(function(a, b){
            var ad = a.deadline || '9999-99-99';
            var bd = b.deadline || '9999-99-99';
            if (ad !== bd) return ad < bd ? -1 : 1;
            return String(a.name || '').toLowerCase().localeCompare(String(b.name || '').toLowerCase(), 'ru');
        });
    }

    _total = matched.length;
    _items = matched.slice(0, 500);
    _activeIdx = _items.length ? 0 : -1;
}

function _renderList(){
    var drop = _ensureDropdown();
    if (!drop) return;

    var st = window.__trkState || {};
    var totalActive = (st.tasks || []).filter(_isSelectable).length;

    // Шапка-счётчик
    var header = '';
    if (_query && _items.length) {
        header = '<div class="ltd-head">Найдено: <b>' + _items.length + '</b> из ' + totalActive + ' активных</div>';
    } else if (_query && !_items.length && totalActive > 0) {
        header = '<div class="ltd-head">Ничего не найдено (всего активных: ' + totalActive + ')</div>';
    } else if (!_query && _items.length) {
        header = '<div class="ltd-head">Активных задач: <b>' + _items.length + '</b></div>';
    }

    if (!_items.length) {
        var msg = totalActive === 0
            ? 'Нет активных задач. Создайте новую кнопкой «➕ Новая задача».'
            : 'Ничего не найдено по запросу';
        drop.innerHTML = header + '<div class="ltd-empty">' + msg + '</div>';
        return;
    }

    var h = header;
    _items.forEach(function(t, idx){
        var active = idx === _activeIdx ? ' ltd-item--active' : '';
        var paused = (t.status === 'paused') ? ' ltd-item--paused' : '';
        var icon = t.icon || '📋';
        var name = t.name || '';
        var deadline = t.deadline ? ('⏰ ' + t.deadline) : '';
