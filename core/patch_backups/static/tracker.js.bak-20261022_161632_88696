/* ============================================================
   PATCH v1.0.15 — редактирование отметки с подгрузкой задачи
   -------------------------------------------------------------
   При openLogModal(entry):
     1. Забираем оригинальную задачу (state.tasks) — при нехватке
        полей дергаем /api/tracker/task/card.
     2. Сливаем данные:
          Описание      = описание задачи + описание отметки
          Доп.данные    = объединение без дублей
          Приказы       = объединение по value без дублей
          Ссылки        = объединение по url без дублей
     3. Показываем всё в РЕДАКТИРУЕМЫХ полях (не read-only),
        чтобы правки можно было сохранить и отправить в задачу.
     4. На submit добавляем merge_extras=1 — бэкенд v1.0.4 сам
        дополнит задачу.
   ============================================================ */
(function(){
'use strict';
if (window.__trkLogEditTaskMergeV1015) return;
window.__trkLogEditTaskMergeV1015 = true;

function _esc(s){
    return String(s==null?'':s).replace(/[&<>"']/g,function(c){
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
}
function _norm(s){
    return String(s == null ? '' : s).trim().toLowerCase().replace(/\s+/g, ' ');
}
function _normUrl(u){
    var s = String(u == null ? '' : u).trim().toLowerCase();
    while (s.length > 1 && s.endsWith('/')) s = s.slice(0, -1);
    return s;
}
function _uniqLines(lines){
    var out = [], seen = {};
    (lines || []).forEach(function(x){
        var s = String(x == null ? '' : x).trim();
        if (!s) return;
        var k = _normUrl(s);
        if (seen[k]) return;
        seen[k] = true;
        out.push(s);
    });
    return out;
}
function _uniqByKey(arr, keyFn){
    var out = [], seen = {};
    (arr || []).forEach(function(x){
        if (!x) return;
        var k = keyFn(x);
        if (!k || seen[k]) return;
        seen[k] = true;
        out.push(x);
    });
    return out;
}

// --- Дозагрузка задачи, если в state.tasks нет полей orders/links/extra ---
function _ensureFullTask(task){
    if (!task || !task.id) return Promise.resolve(task);
    if (task._v1015FullFetched) return Promise.resolve(task);
    var hasO = Array.isArray(task.orders) && task.orders.length;
    var hasL = Array.isArray(task.links) && task.links.length;
    var hasF = (task.folder || '').trim().length > 0;
    var hasD = (task.description || '').trim().length > 0;
    if (hasO || hasL || hasF || hasD) {
        task._v1015FullFetched = true;
        return Promise.resolve(task);
    }
    task._v1015FullFetched = true;
    var from = (document.getElementById('sumDateFrom') || {}).value || '';
    var to = (document.getElementById('sumDateTo') || {}).value || '';
    if (!from || !to) {
        var d = new Date();
        var y = d.getFullYear(), m = d.getMonth() + 1;
        var pad = function(n){ return n < 10 ? '0'+n : ''+n; };
        from = y + '-' + pad(m) + '-01';
        to   = y + '-' + pad(m) + '-' + pad(new Date(y, m, 0).getDate());
    }
    var url = '/api/tracker/task/card?task=' + encodeURIComponent(task.id)
            + '&from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to);
    var hdrs = {};
    if (window.REESTR_CSRF) hdrs['X-CSRF-Token'] = window.REESTR_CSRF;
    return fetch(url, {credentials:'same-origin', headers:hdrs})
        .then(function(r){ return r.json(); })
        .then(function(d){
            if (d && d.success && d.task) {
                var ft = d.task;
                if (!task.orders) task.orders = ft.orders || [];
                if (!task.links) task.links = ft.links || [];
                if (!task.folder) task.folder = ft.folder || '';
                if (!task.description) task.description = ft.description || '';
                if (!task.extra_meta) task.extra_meta = ft.extra_meta || [];
            }
            return task;
        })
        .catch(function(){ return task; });
}

// --- Слияние данных из entry и task в единые массивы ---
function _mergeEntryWithTask(entry, task){
    task = task || {};
    entry = entry || {};

    // Описание
    var descTask = String(task.description || '').trim();
    var descEntry = String(entry.comment || '').trim();
    var descCombined = '';
    if (descTask && descEntry) {
        if (_norm(descTask) === _norm(descEntry)) descCombined = descTask;
        else descCombined = descTask + '\n' + descEntry;
    } else if (descTask) descCombined = descTask;
    else if (descEntry) descCombined = descEntry;

    // Доп.данные: task.folder (строки) + entry.extra_data
    var folderLines = String(task.folder || '').split(/\r?\n/).map(function(x){ return x.trim(); });
    var entryExtra = (entry.extra_data || []).map(function(x){
        if (typeof x === 'string') return x;
        return (x && x.line) || '';
    });
    var extraMerged = _uniqLines(folderLines.concat(entryExtra));

    // Приказы: task.orders + entry.orders
    var ordersTask = Array.isArray(task.orders) ? task.orders : [];
    var ordersEntry = Array.isArray(entry.orders) ? entry.orders : [];
    var ordersMerged = _uniqByKey(ordersTask.concat(ordersEntry), function(o){
        return _normUrl(o && o.value);
    });

    // Ссылки: task.links + entry.links + entry.link (одиночная)
    var linksTask = Array.isArray(task.links) ? task.links : [];
    var linksEntry = Array.isArray(entry.links) ? entry.links : [];
    var linksAll = linksTask.concat(linksEntry);
    if (entry.link) {
        var _u = String(entry.link).trim();
        if (_u) {
            var _has = linksAll.some(function(l){ return l && _normUrl(l.url) === _normUrl(_u); });
            if (!_has) linksAll = linksAll.concat([{ description: '', url: _u }]);
        }
    }
    var linksMerged = _uniqByKey(linksAll, function(l){
        return _normUrl(l && l.url);
    });

    return {
        description: descCombined,
        extra_data: extraMerged,        // массив строк
        orders: ordersMerged,           // массив {description, value}
        links: linksMerged,             // массив {description, url}
    };
}

