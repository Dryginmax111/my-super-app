/* ============================================================
   PATCH v1.0.10 — авто-добавление сотрудника в исполнители задачи
   ============================================================ */
(function(){
'use strict';
if (window.__trkAutoAssignV1010) return;
window.__trkAutoAssignV1010 = true;

function _notify(msg, kind){
    if (typeof window.__trackerNotify === 'function') {
        try { window.__trackerNotify(msg, kind); return; } catch (e) {}
    }
}

function _getTaskFromState(taskId){
    var st = window.__trkState || {};
    return (st.tasks || []).find(function(t){ return t.id === taskId; }) || null;
}

function _buildTaskSavePayload(task, newAssignees){
    // Собираем полный payload из task-объекта — как это делает openTaskModal → saveTask
    return {
        id: task.id,
        name: task.name || '',
        icon: task.icon || '📋',
        description: task.description || '',
        status: task.status || 'active',
        start_date: task.start_date || '',
        deadline: task.deadline || '',
        completed_at: task.completed_at || '',
        folder: task.folder || '',
        order_ref: task.order_ref || '',
        tags: (task.tags || []).slice(),
        assignees: newAssignees,
        department_ids: (task.department_ids || []).slice(),
        is_urgent: !!task.is_urgent,
        links: (task.links || []).slice(),
        orders: (task.orders || []).slice(),
    };
}

function _ensureAssignee(taskId, employeeId){
    if (!taskId || !employeeId) return Promise.resolve(false);
    var task = _getTaskFromState(taskId);
    if (!task) return Promise.resolve(false);
    var current = Array.isArray(task.assignees) ? task.assignees.slice() : [];
    if (current.indexOf(employeeId) !== -1) {
        return Promise.resolve(false); // уже назначен
    }
    current.push(employeeId);
    var payload = _buildTaskSavePayload(task, current);
    var hdrs = {'Content-Type': 'application/json'};
    if (window.REESTR_CSRF) hdrs['X-CSRF-Token'] = window.REESTR_CSRF;
    return fetch('/api/tracker/task/save', {
        method: 'POST',
        headers: hdrs,
        credentials: 'same-origin',
        body: JSON.stringify(payload)
    })
    .then(function(r){
        return r.json().then(function(j){ return { ok: r.ok, d: j }; });
    })
    .then(function(res){
        if (!res.ok || !res.d || !res.d.success) {
            var err = (res.d && res.d.error) || 'Ошибка';
            console.warn('[auto-assign] task/save failed:', err);
            return false;
        }
        // Локально обновляем state, чтобы UI подхватил
        try {
            task.assignees = current;
        } catch (e) {}
        return true;
    })
    .catch(function(err){
        console.warn('[auto-assign] fetch error:', err);
        return false;
    });
}

// === Перехват fetch для /api/tracker/log/save ===
var _native = window.fetch;
if (typeof _native === 'function' && !window.__trkAutoAssignFetch) {
    window.__trkAutoAssignFetch = true;
    window.fetch = function(url, opts){
        var isLogSave = (typeof url === 'string' && url.indexOf('/api/tracker/log/save') !== -1);
        var isPost = opts && (opts.method || 'GET').toUpperCase() === 'POST';
        if (!isLogSave || !isPost) {
            return _native.apply(this, arguments);
        }

        var employeeId = '';
        var taskId = '';
        try {
            var b = JSON.parse(opts.body || '{}');
            employeeId = b.employee_id || '';
            taskId = b.task_id || '';
        } catch (e) {}

        var self = this;
        var p = _native.apply(this, arguments);
        if (!employeeId || !taskId) return p;

        return p.then(function(r){
            if (!r || !r.ok) return r;
            // Проверяем успешность ответа, но НЕ блокируем — отправляем запрос на task/save всегда,
            // если log/save ответил OK
            try {
                return r.clone().json().then(function(d){
                    if (d && d.success) {
                        // Асинхронно, не мешая ответу
                        setTimeout(function(){
                            _ensureAssignee(taskId, employeeId).then(function(added){
                                if (added) {
                                    _notify('👥 Добавлен в исполнители задачи');
                                }
                            });
                        }, 50);
                    }
                    return r;
                }).catch(function(){
                    // Тело не JSON, но статус OK — всё равно попробуем
                    setTimeout(function(){
                        _ensureAssignee(taskId, employeeId).then(function(added){
                            if (added) _notify('👥 Добавлен в исполнители задачи');
                        });
                    }, 50);
                    return r;
                });
            } catch (e) {
                return r;
            }
        });
    };
}

// === Обёртка для кнопки «Добавить меня» в блоке «Назначено, но не заведено» ===
// PATCH 23 / v1.2.3 тоже пользуются log/save — их покрывает перехват fetch выше.
// Но на случай, если они вызывают задачу иначе — оставим страховку.

window.__trkAutoAssign = {
    ensure: _ensureAssignee,
};
})();


/* ============================================================
