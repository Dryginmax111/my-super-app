function shiftMonth(delta) {
    if (!state.currentYM) state.currentYM = todayYM();
    var p = state.currentYM.split('-'); var y = parseInt(p[0], 10), m = parseInt(p[1], 10);
    m += delta;
    while (m < 1) { m += 12; y -= 1; }
    while (m > 12) { m -= 12; y += 1; }
    state.currentYM = y + '-' + String(m).padStart(2, '0');
    loadCalendar();
}
