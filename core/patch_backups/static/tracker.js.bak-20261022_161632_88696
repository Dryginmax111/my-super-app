    window.__trkDelLogFetch = true;
    window.fetch = function(url, opts){
        var isDel = (typeof url === 'string' && url.indexOf('/api/tracker/log/delete') !== -1);
        var isPost = opts && (opts.method || 'GET').toUpperCase() === 'POST';
        if (!isDel || !isPost) {
            return _native.apply(this, arguments);
        }

        var ctx = window.__trkDelLogCtx;
        var p = _native.apply(this, arguments);
        if (!ctx || !ctx.content) return p;

        var content = ctx.content;
        return p.then(function(r){
            // 200/ok — либо успех, либо «cancelled» (PATCH 08 отменил удаление)
            if (!r || !r.ok) {
                try { _error(content, 'Ошибка HTTP ' + (r ? r.status : '?')); } catch(e) {}
                return r;
            }
            return r.clone().json().then(function(d){
                if (d && d.success === true && !d.cancelled) {
                    _success(content);
                } else if (d && (d.cancelled || d.error === 'cancelled')) {
