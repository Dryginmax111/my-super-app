        }
        check.style.display = '';
        if (txt) txt.textContent = text || 'Завершено';
    } else if (state === 'error') {
        ov.classList.add('trk-dlo-error');
        if (sp) sp.style.display = 'none';
        var err = ov.querySelector('.trk-dlo-check');
        if (!err) {
